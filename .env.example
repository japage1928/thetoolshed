# Copy this file to .env for local development.
# In production, set these as Netlify environment variables.
# Never commit real secret values.

# Public site URL used for canonical links, sitemap, RSS, OAuth redirects, and Open Graph tags.
PUBLIC_SITE_URL=https://thetoolshed.work

# Existing public Supabase browser-safe settings.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. NEVER expose this through a PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Evergreen X customer OAuth 2.0 / PKCE application credentials.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=https://thetoolshed.work/api/evergreen-x/x/callback

# Base64-encoded 32-byte AES key used only server-side to encrypt customer X tokens.
EVERGREEN_X_TOKEN_ENCRYPTION_KEY=

# Shared secret used by n8n when calling POST /api/internal/evergreen-x/publish.
# Configure the matching n8n HTTP templated-auth credential as x-tool-shed-service-key.
N8N_EVERGREEN_X_SERVICE_SECRET=

# Comma-separated owner/admin emails allowed to access Evergreen X SaaS metrics.
EVERGREEN_X_ADMIN_EMAILS=

# Stripe SaaS billing boundary. Leave unset until live billing is intentionally configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON object mapping evergreen_saas.plans.id -> Stripe recurring Price ID.
# Example shape only: {"starter":"price_...","pro":"price_...","top":"price_..."}
STRIPE_PRICE_IDS_JSON={}

# Existing blog publishing integration.
BLOG_PUBLISH_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=japage1928
GITHUB_REPO=thetoolshed
GITHUB_BRANCH=claude/astro-blog-publishing-3yd0ix
