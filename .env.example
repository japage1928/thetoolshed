# Copy this file to .env for local development.
# In production, set these as Netlify environment variables
# (Site configuration -> Environment variables). Never commit real values.

# Public site URL used for canonical links, sitemap, RSS, and Open Graph tags.
PUBLIC_SITE_URL=https://your-site.netlify.app

# Secret shared with n8n. n8n must send this exact value in the
# `x-api-key` header (or `Authorization: Bearer <value>`) when calling
# POST /api/blog/publish. Generate a long random string.
BLOG_PUBLISH_API_KEY=

# GitHub Personal Access Token (fine-grained, scoped to this repo only)
# with "Contents: Read and write" permission. Used by /api/blog/publish
# to commit new blog post files so Netlify can build/deploy them.
GITHUB_TOKEN=

# Repo the publish endpoint commits to.
GITHUB_OWNER=japage1928
GITHUB_REPO=thetoolshed

# Branch Netlify deploys from. Commits to this branch trigger a Netlify build.
GITHUB_BRANCH=main
