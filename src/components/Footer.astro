---
import { SITE_NAME } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrapper">
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <div class="site-footer__link-group">
        <a href="/">Home</a>
        <a href="/business-intelligence">Business Intelligence</a>
        <a href="/tools">AI Directory</a>
        <a href="/prompts">AI Prompts</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
      </div>
      <div class="site-footer__link-group site-footer__link-group--secondary">
        <a href="https://x.com/john_page1990" target="_blank" rel="me noopener noreferrer">X</a>
        <a href="/support">Support</a>
        <a href="/news">Weekly recaps</a>
        <a href="/terms">Terms</a>
        <a href="/privacy-policy">Privacy</a>
        <a href="/refund-policy">Refunds</a>
        <a href="/acceptable-use">Acceptable Use</a>
        <a href="/privacy-choices">Privacy Choices</a>
        <button type="button" data-cookie-settings>Cookie Settings</button>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
    </nav>
    <p>&copy; {year} {SITE_NAME}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer__link-group button{padding:0;border:0;background:none;color:inherit;font:inherit;text-decoration:underline;cursor:pointer}
</style>
