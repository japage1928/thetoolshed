---
interface Props {
  variant?: 'bench' | 'discover' | 'compare' | 'use' | 'build' | 'scale' | 'meter' | 'detail';
  title?: string;
}

const { variant = 'bench', title } = Astro.props;
const label = title ?? (
  variant === 'bench' ? 'Workshop workbench illustration' :
  variant === 'discover' ? 'Discover illustration' :
  variant === 'compare' ? 'Compare illustration' :
  variant === 'use' ? 'Use illustration' :
  variant === 'build' ? 'Build illustration' :
  variant === 'scale' ? 'Scale illustration' :
  variant === 'meter' ? 'Cost meter illustration' :
  'Tool detail workshop illustration'
);
---
<svg class:list={['workshop-art', `workshop-art--${variant}`]} viewBox="0 0 320 180" role="img" aria-label={label}>
  <title>{label}</title>
  {variant === 'bench' && (
    <g>
      <rect width="320" height="180" rx="14" fill="#12110e"/>
      <rect x="8" y="8" width="304" height="164" rx="10" fill="#1a1612" stroke="#3a2f26"/>
      <path d="M18 128h284" stroke="#9a5d2f" stroke-width="10" stroke-linecap="round"/>
      <rect x="18" y="132" width="284" height="28" fill="#2a1b12"/>
      <g stroke="#b9c3cc" stroke-width="3" stroke-linecap="round">
        <path d="M54 38v72"/><path d="M78 46v64"/><path d="M102 34v76"/>
        <path d="M210 40v70"/><path d="M236 50v60"/><path d="M262 36v74"/>
      </g>
      <circle cx="54" cy="34" r="6" fill="#c88b4b"/>
      <circle cx="78" cy="42" r="5" fill="#178cff"/>
      <circle cx="102" cy="30" r="6" fill="#c88b4b"/>
      <circle cx="210" cy="36" r="6" fill="#178cff"/>
      <circle cx="236" cy="46" r="5" fill="#c88b4b"/>
      <circle cx="262" cy="32" r="6" fill="#178cff"/>
      <rect x="128" y="58" width="64" height="42" rx="6" fill="#0b0e11" stroke="#4a555f" stroke-width="2"/>
      <rect x="136" y="66" width="48" height="26" rx="3" fill="#071018" stroke="#178cff"/>
      <circle cx="160" cy="112" r="10" fill="#178cff" opacity="0.35"/>
    </g>
  )}
  {variant === 'discover' && (
    <g>
      <rect width="320" height="180" rx="12" fill="#14110e"/>
      <rect x="48" y="36" width="132" height="96" rx="8" fill="#1b1814" stroke="#3a342c"/>
      <rect x="62" y="50" width="104" height="10" rx="3" fill="#c88b4b" opacity="0.7"/>
      <rect x="62" y="70" width="88" height="7" rx="3" fill="#5a534b"/>
      <rect x="62" y="86" width="96" height="7" rx="3" fill="#5a534b"/>
      <circle cx="214" cy="86" r="32" fill="none" stroke="#178cff" stroke-width="6"/>
      <path d="M238 110l28 28" stroke="#c88b4b" stroke-width="8" stroke-linecap="round"/>
    </g>
  )}
  {variant === 'compare' && (
    <g>
      <rect width="320" height="180" rx="12" fill="#14110e"/>
      <rect x="36" y="48" width="92" height="84" rx="8" fill="#1b1814" stroke="#c88b4b"/>
      <rect x="192" y="48" width="92" height="84" rx="8" fill="#1b1814" stroke="#178cff"/>
      <text x="160" y="100" text-anchor="middle" fill="#c88b4b" font-size="18" font-weight="700">VS</text>
      <circle cx="82" cy="80" r="14" fill="#178cff" opacity="0.35"/>
      <circle cx="238" cy="80" r="14" fill="#c88b4b" opacity="0.4"/>
    </g>
  )}
  {variant === 'use' && (
    <g>
      <rect width="320" height="180" rx="12" fill="#14110e"/>
      <rect x="40" y="40" width="160" height="44" rx="10" fill="#1b1814" stroke="#3a342c"/>
      <rect x="120" y="96" width="160" height="44" rx="10" fill="#102033" stroke="#178cff"/>
      <circle cx="62" cy="62" r="8" fill="#c88b4b"/>
      <circle cx="258" cy="118" r="8" fill="#178cff"/>
    </g>
  )}
  {variant === 'build' && (
    <g>
      <rect width="320" height="180" rx="12" fill="#14110e"/>
      <circle cx="80" cy="90" r="28" fill="none" stroke="#c88b4b" stroke-width="6"/>
      <circle cx="160" cy="90" r="22" fill="none" stroke="#178cff" stroke-width="6"/>
      <circle cx="236" cy="90" r="28" fill="none" stroke="#b9c3cc" stroke-width="6"/>
      <path d="M108 90h30M182 90h26" stroke="#5a534b" stroke-width="4"/>
    </g>
  )}
  {variant === 'scale' && (
    <g>
      <rect width="320" height="180" rx="12" fill="#14110e"/>
      <path d="M56 132h208" stroke="#3a342c" stroke-width="6" stroke-linecap="round"/>
      <path d="M64 132V72h36v60M124 132V58h36v74M184 132V86h36v46" fill="#1b1814" stroke="#c88b4b"/>
      <rect x="250" y="48" width="22" height="84" rx="6" fill="#178cff" opacity="0.55"/>
    </g>
  )}
  {variant === 'meter' && (
    <g>
      <rect width="320" height="180" rx="12" fill="#14110e"/>
      <path d="M60 130a100 100 0 0 1 200 0" fill="none" stroke="#3a342c" stroke-width="14" stroke-linecap="round"/>
      <path d="M60 130a100 100 0 0 1 132-92" fill="none" stroke="#178cff" stroke-width="14" stroke-linecap="round"/>
      <circle cx="160" cy="130" r="8" fill="#c88b4b"/>
      <path d="M160 130l54-46" stroke="#c88b4b" stroke-width="6" stroke-linecap="round"/>
    </g>
  )}
  {variant === 'detail' && (
    <g>
      <rect width="320" height="180" rx="14" fill="#12110e"/>
      <rect x="18" y="118" width="284" height="36" fill="#2a1b12"/>
      <path d="M18 118h284" stroke="#9a5d2f" stroke-width="8"/>
      <rect x="196" y="42" width="88" height="58" rx="6" fill="#0b0e11" stroke="#4a555f"/>
      <rect x="206" y="52" width="68" height="38" rx="3" fill="#071018" stroke="#178cff"/>
      <g stroke="#b9c3cc" stroke-width="3">
        <path d="M48 36v70"/><path d="M72 48v58"/><path d="M96 40v66"/>
      </g>
    </g>
  )}
</svg>
