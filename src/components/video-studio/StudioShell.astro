---
import BaseLayout from '../../layouts/BaseLayout.astro';
interface Props { title: string; section?: string; }
const { title, section = 'dashboard' } = Astro.props;
const nav = [
  ['dashboard','Dashboard','/app/video-studio'],
  ['projects','Projects','/app/video-studio/projects'],
  ['usage','Usage & Credits','/app/video-studio/usage'],
  ['billing','Billing','/app/video-studio/billing'],
  ['support','Support','/app/video-studio/support'],
];
---
<BaseLayout title={`${title} · Video Studio`} description="Video Studio" path={Astro.url.pathname} noindex>
  <div class="vs-app">
    <aside class="vs-sidebar">
      <a class="vs-brand" href="/app/video-studio"><span>V</span><strong>Video Studio</strong></a>
      <nav>{nav.map(([key,label,href]) => <a class={section===key?'active':''} href={href}>{label}</a>)}</nav>
      <div class="vs-sidebar-foot"><span id="vs-credit-chip">Credits —</span></div>
    </aside>
    <main class="vs-main">
      <header class="vs-topbar">
        <a class="mobile-brand" href="/app/video-studio">Video Studio</a>
        <details class="account-menu">
          <summary><span class="avatar">A</span><span id="vs-account-label">Account</span><b>⌄</b></summary>
          <div class="account-popover">
            <a href="/app/video-studio">Dashboard</a>
            <a href="/app/video-studio/projects">Projects</a>
            <a href="/app/video-studio/billing">Manage Subscription</a>
            <a href="/app/video-studio/usage">Usage & Credits</a>
            <a href="/app/video-studio/support">Support</a>
            <button id="vs-signout" type="button">Sign Out</button>
          </div>
        </details>
      </header>
      <div class="vs-content"><slot /></div>
    </main>
  </div>
</BaseLayout>
<script>
  async function loadAccount(){
    try{const r=await fetch('/api/video-studio/account'); if(!r.ok)return; const d=await r.json();
      const label=document.querySelector('#vs-account-label'); const chip=document.querySelector('#vs-credit-chip');
      if(label) label.textContent=d.email||'Account'; if(chip) chip.textContent=`Credits ${d.credits??0}`;
    }catch{}
  }
  document.querySelector('#vs-signout')?.addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST'}); location.href='/video-studio/login';});
  loadAccount();
</script>
<style>
  :global(body){margin:0;background:#090b10;color:#eef2f8;font-family:Inter,ui-sans-serif,system-ui,sans-serif}.vs-app{min-height:100vh;display:grid;grid-template-columns:230px 1fr;background:radial-gradient(circle at 75% 0,#162038 0,transparent 36%),#090b10}.vs-sidebar{position:sticky;top:0;height:100vh;padding:24px 16px;border-right:1px solid #202633;background:#0c0f16}.vs-brand{display:flex;gap:10px;align-items:center;color:white;text-decoration:none;padding:5px 8px 24px}.vs-brand span{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:#fff;color:#0b0d12;font-weight:900}.vs-sidebar nav{display:grid;gap:5px}.vs-sidebar nav a,.account-popover a{color:#aeb7c8;text-decoration:none;padding:11px 12px;border-radius:9px;font-size:14px}.vs-sidebar nav a:hover,.vs-sidebar nav a.active{background:#171c27;color:#fff}.vs-sidebar-foot{position:absolute;bottom:22px;left:20px;color:#8f9aae;font-size:13px}.vs-main{min-width:0}.vs-topbar{height:68px;display:flex;align-items:center;justify-content:flex-end;padding:0 28px;border-bottom:1px solid #202633;background:#0b0e14cc;backdrop-filter:blur(12px);position:sticky;top:0;z-index:10}.mobile-brand{display:none;color:#fff;text-decoration:none;font-weight:800}.account-menu{position:relative}.account-menu summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:9px;color:#dce3ef;font-size:13px}.account-menu summary::-webkit-details-marker{display:none}.avatar{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:#20283a;font-weight:800}.account-popover{position:absolute;right:0;top:44px;width:210px;padding:8px;border:1px solid #2a3242;background:#111620;border-radius:12px;box-shadow:0 16px 50px #0008;display:grid}.account-popover button{border:0;border-top:1px solid #252d3b;margin-top:5px;padding:12px;text-align:left;background:transparent;color:#ff9f9f;cursor:pointer}.vs-content{max-width:1180px;margin:0 auto;padding:36px 30px 70px}.page-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:26px}.page-head h1{margin:0;font-size:30px}.page-head p{margin:7px 0 0;color:#8f9aae}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:9px;padding:10px 14px;background:#fff;color:#0b0d12;text-decoration:none;font-weight:800;border:0;cursor:pointer}.card{background:#10141d;border:1px solid #222a38;border-radius:14px;padding:18px}.muted{color:#8f9aae}.status{font-size:12px;text-transform:capitalize;padding:5px 8px;border-radius:999px;background:#1b2230;color:#bdc8db}.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(3,minmax(0,1fr))}.stat strong{display:block;font-size:28px;margin-top:8px}.table{display:grid;gap:8px}.row{display:grid;grid-template-columns:minmax(180px,1fr) 150px 110px 100px;gap:12px;align-items:center;padding:14px;border:1px solid #202838;border-radius:10px;color:#dce3ef;text-decoration:none;background:#0d1118}.row:hover{border-color:#3a465d;background:#111722}.row small{color:#8490a4}.empty{padding:32px;text-align:center;color:#8f9aae}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:13px;color:#aab4c5}.field input,.field select,.field textarea{width:100%;box-sizing:border-box;background:#0b0f16;border:1px solid #283143;color:#eef2f8;border-radius:9px;padding:11px}.video-wrap{background:#030405;border-radius:12px;overflow:hidden;aspect-ratio:9/16;max-height:680px;display:grid;place-items:center}.video-wrap video{width:100%;height:100%;object-fit:contain;background:#000}@media(max-width:760px){.vs-app{grid-template-columns:1fr}.vs-sidebar{display:none}.vs-topbar{justify-content:space-between;padding:0 16px}.mobile-brand{display:block}.vs-content{padding:24px 16px 50px}.stats,.form-grid{grid-template-columns:1fr}.row{grid-template-columns:1fr auto}.row .hide-mobile{display:none}.page-head{align-items:start}.page-head h1{font-size:26px}}
</style>