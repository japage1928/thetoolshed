---
interface Props {
  source?: string;
  compact?: boolean;
}
const { source = 'website', compact = false } = Astro.props;
---

<section class:list={['email-capture', compact && 'email-capture--compact']} aria-labelledby={`email-heading-${source}`}>
  <div>
    <span class="eyebrow">FREE AI RESOURCES</span>
    <h2 id={`email-heading-${source}`}>Get useful AI prompts and tools in your inbox.</h2>
    <p>Join the Tool Shed list for practical prompts, workflow ideas, and useful AI finds. No daily inbox assault.</p>
  </div>
  <form class="email-capture__form" data-source={source}>
    <label class="sr-only" for={`subscriber-email-${source}`}>Email address</label>
    <input id={`subscriber-email-${source}`} name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
    <button type="submit">Get the free prompt pack <span>→</span></button>
    <p class="email-capture__status" role="status" aria-live="polite" hidden></p>
  </form>
</section>

<style>
.email-capture{display:grid;grid-template-columns:1.2fr 1fr;gap:2rem;align-items:center;padding:1.5rem;border:1px solid var(--color-border);border-radius:.8rem;background:#0f100f}.email-capture h2{margin:.45rem 0;font-size:1.35rem}.email-capture p{color:#aaa69e;line-height:1.55;margin:.5rem 0 0}.email-capture__form{display:grid;gap:.65rem}.email-capture input{width:100%;box-sizing:border-box;padding:.8rem;border:1px solid var(--color-border);border-radius:.5rem;background:#090a09;color:#f1eee7}.email-capture button{border:0;border-radius:.5rem;padding:.8rem 1rem;background:#e9e4d8;color:#10110f;font-weight:800;cursor:pointer}.email-capture__status{font-size:.78rem}.email-capture--compact{grid-template-columns:1fr;margin-top:2rem}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:700px){.email-capture{grid-template-columns:1fr}}
</style>

<script>
const EMAIL_CAPTURE_ENDPOINT = 'https://japage628.app.n8n.cloud/webhook/tool-shed-email-capture';

document.querySelectorAll<HTMLFormElement>('.email-capture__form').forEach((form) => {
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const button = form.querySelector<HTMLButtonElement>('button');
    const status = form.querySelector<HTMLElement>('.email-capture__status');
    if (!input || !status || !button || button.disabled) return;

    button.disabled = true;
    status.hidden = false;
    status.textContent = 'Saving your signup…';

    try {
      const response = await fetch(EMAIL_CAPTURE_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: input.value.trim(),
          name: '',
          source: form.dataset.source || 'website',
          consent: true,
        }),
      });

      if (response.ok) {
        status.textContent = 'You’re on the list.';
        input.value = '';
        const gtag = (window as any).gtag;
        if (typeof gtag === 'function') gtag('event', 'email_signup', { source: form.dataset.source || 'website', incentive: 'free-ai-prompt-pack' });
        return;
      }

      if (response.status === 400) {
        let message = 'Please check your email address and try again.';
        try {
          const result = await response.json();
          message = result?.message || result?.error || message;
        } catch {
          // Keep the safe validation fallback when the backend does not return JSON.
        }
        status.textContent = message;
        return;
      }

      status.textContent = 'Something went wrong. Please try again.';
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
    } finally {
      button.disabled = false;
    }
  });
});
</script>
