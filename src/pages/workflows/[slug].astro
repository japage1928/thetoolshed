---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkflowBySlug } from '../../lib/supabase';

export const prerender = true;
const workflow = await getWorkflowBySlug(Astro.params.slug ?? '');
if (!workflow) return Astro.redirect('/workflows', 302);
const description = workflow.seo_description || workflow.description;
const priceLabel = workflow.is_free ? 'Free' : `$${Number(workflow.price).toFixed(2)}`;
---

<BaseLayout title={`${workflow.seo_title || workflow.name} | The Tool Shed`} description={description} path={`/workflows/${workflow.slug}`}>
  <div class="wrapper workflow-detail">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/workflows">Workflows</a><span>/</span><span>{workflow.name}</span></nav>
    <article>
      <header class="workflow-hero">
        {workflow.image_url && <img src={workflow.image_url} alt="" width="96" height="96" />}
        <div><span class="eyebrow">{workflow.category}</span><h1 class="page-title">{workflow.name}</h1><p>{workflow.description}</p></div>
      </header>
      <div class="workflow-info">
        <div><strong>Difficulty</strong><span>{workflow.difficulty}</span></div>
        <div><strong>Price</strong><span>{priceLabel}</span></div>
        {workflow.apps_required.length > 0 && <div><strong>Requires</strong><span>{workflow.apps_required.join(' · ')}</span></div>}
      </div>
      {workflow.included.length > 0 && <section class="workflow-included"><h2>What's included</h2><ul>{workflow.included.map((item) => <li>{item}</li>)}</ul></section>}
      <section class="purchase" aria-label="Purchase workflow">
        <div><span class="eyebrow">Get this workflow</span><h2>{priceLabel}</h2></div>
        {workflow.is_free ? <a class="hero-button hero-button--primary" href={workflow.payhip_product_id ? `https://payhip.com/b/${workflow.payhip_product_id}` : '#'} target="_blank" rel="noopener noreferrer">Get Workflow <span>→</span></a> : workflow.payhip_product_id ? <div class="payhip-embed-page" data-key={workflow.payhip_product_id}></div> : <p>Purchase link coming soon.</p>}
      </section>
      <p class="disclosure">Checkout and digital delivery are handled securely by Payhip.</p>
    </article>
  </div>
</BaseLayout>

{workflow.payhip_product_id && !workflow.is_free && <script is:inline src="https://payhip.com/embed-page.js?v=24u68985"></script>}

<style>
.workflow-detail{max-width:60rem;padding:3rem 0 5rem}.breadcrumbs{display:flex;gap:.55rem;color:#77736d;font-size:.78rem;margin-bottom:2.5rem}.breadcrumbs a{color:#aaa69e;text-decoration:none}.workflow-hero{display:flex;gap:1.25rem;align-items:flex-start}.workflow-hero>img{width:96px;height:96px;object-fit:cover;border-radius:18px;background:#fff}.workflow-hero p{max-width:48rem;color:#aaa69e;font-size:1.05rem;line-height:1.65}.workflow-info{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2rem 0}.workflow-info div{padding:1rem;border:1px solid var(--color-border);border-radius:.6rem;background:#10110f}.workflow-info strong{display:block;color:#77736d;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}.workflow-info span{color:#e3dfd7;font-size:.9rem}.workflow-included{margin:2rem 0}.workflow-included h2{font-size:1.2rem}.workflow-included li{margin:.5rem 0;color:#aaa69e}.purchase{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;margin-top:2.5rem;padding:1.5rem;border:1px solid var(--color-border);border-radius:.75rem;background:linear-gradient(145deg,#141411,#0c0d0c)}.purchase h2{margin:.25rem 0 0;font-size:2rem}.payhip-embed-page{min-width:220px}.disclosure{color:#77736d;font-size:.72rem;line-height:1.6;margin-top:1rem}@media(max-width:640px){.workflow-hero{flex-direction:column}.workflow-info{grid-template-columns:1fr}.purchase{flex-direction:column;align-items:stretch}.payhip-embed-page{min-width:0}}
</style>
