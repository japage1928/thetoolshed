---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Reset Password" description="Securely reset your Tool Shed account password." path="/account/reset-password" noindex>
  <section class="reset-shell">
    <div class="reset-card">
      <span>THE TOOL SHED · ACCOUNT SECURITY</span>
      <h1>Reset your password</h1>
      <p id="reset-intro">Use the secure link sent to your email. Reset links expire and can only be used for the account that requested them.</p>

      <form id="request-form">
        <label>Email address<input id="reset-email" type="email" autocomplete="email" required /></label>
        <button type="submit">Send reset link</button>
      </form>

      <form id="password-form" hidden>
        <label>New password<input id="new-password" type="password" minlength="10" autocomplete="new-password" required /></label>
        <label>Confirm new password<input id="confirm-password" type="password" minlength="10" autocomplete="new-password" required /></label>
        <button type="submit">Update password</button>
      </form>
      <p id="reset-status" hidden aria-live="polite"></p>
      <a class="back" href="/account">Back to Account</a>
    </div>
  </section>
</BaseLayout>

<script>
  const hash = new URLSearchParams(window.location.hash.slice(1));
  const accessToken = hash.get('access_token');
  const requestForm = document.querySelector<HTMLFormElement>('#request-form');
  const passwordForm = document.querySelector<HTMLFormElement>('#password-form');
  const status = document.querySelector<HTMLElement>('#reset-status');
  const intro = document.querySelector<HTMLElement>('#reset-intro');

  if (accessToken && hash.get('type') === 'recovery') {
    if (requestForm) requestForm.hidden = true;
    if (passwordForm) passwordForm.hidden = false;
    if (intro) intro.textContent = 'Choose a strong, unique password with at least 10 characters.';
  }

  requestForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = document.querySelector<HTMLInputElement>('#reset-email')?.value || '';
    const button = requestForm.querySelector<HTMLButtonElement>('button');
    if (button) button.disabled = true;
    if (status) { status.hidden = false; status.textContent = 'Sending reset instructions…'; }
    try {
      const response = await fetch('/api/auth/recover', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to send reset instructions.');
      if (status) status.textContent = 'If that email has an account, a reset link is on the way.';
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'Unable to send reset instructions.';
    } finally {
      if (button) button.disabled = false;
    }
  });

  passwordForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const password = document.querySelector<HTMLInputElement>('#new-password')?.value || '';
    const confirmation = document.querySelector<HTMLInputElement>('#confirm-password')?.value || '';
    const button = passwordForm.querySelector<HTMLButtonElement>('button');
    if (password !== confirmation) {
      if (status) { status.hidden = false; status.textContent = 'The passwords do not match.'; }
      return;
    }
    if (button) button.disabled = true;
    if (status) { status.hidden = false; status.textContent = 'Updating password…'; }
    try {
      const response = await fetch('/api/auth/update-password', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ accessToken, password }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to update the password.');
      history.replaceState(null, '', window.location.pathname);
      if (passwordForm) passwordForm.hidden = true;
      if (status) status.textContent = 'Password updated. You can now sign in with the new password.';
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'Unable to update the password.';
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .reset-shell{min-height:72vh;display:grid;place-items:center;padding:3rem 1rem}.reset-card{width:min(100%,470px);padding:2rem;border:1px solid var(--color-border);border-radius:1rem;background:#10110f}.reset-card>span{color:#c7a76a;font-size:.68rem;font-weight:850;letter-spacing:.15em}.reset-card h1{margin:.5rem 0;font-size:2.3rem;letter-spacing:-.04em}.reset-card>p{color:#969188;line-height:1.6}.reset-card form{display:grid;gap:1rem;margin-top:1.4rem}.reset-card label{display:grid;gap:.4rem;color:#aaa69e;font-size:.8rem;font-weight:800}.reset-card input{padding:.82rem;border:1px solid var(--color-border);border-radius:.45rem;background:#090a09;color:#f1eee7}.reset-card button{padding:.82rem;border:0;border-radius:.45rem;background:#ece6da;color:#111;font-weight:850;cursor:pointer}.reset-card button:disabled{opacity:.55}.reset-card #reset-status{color:#c7a76a;font-size:.78rem}.back{display:inline-block;margin-top:1.2rem;color:#c9dcff;font-size:.75rem}
</style>
