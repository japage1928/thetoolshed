---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolMark from '../../components/ToolMark.astro';
import WorkshopArt from '../../components/WorkshopArt.astro';
import { COMPARISONS } from '../../data/comparisons';
import { AI_TOOLS, getCatalogCategories } from '../../lib/ai-tools';

const description = 'Compare AI tools by the job: writing assistants, coding/analysis, and research. No invented benchmark scores — check vendor pricing yourself.';
const categories = getCatalogCategories();
const pickerTools = [...AI_TOOLS].sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout title="Compare AI tools" description={description} path="/compare">
  <div class="wrapper compare-index">
    <header class="compare-hero">
      <span class="eyebrow">COMPARE · AI TOOLS FOR REAL WORK</span>
      <h1 class="page-title">Compare AI tools by the job</h1>
      <p>These pages state the job, the criteria, and who should pick which. We do not invent scores. Confirm current prices on the vendor sites linked from each comparison.</p>
      <div class="compare-hero__art"><WorkshopArt variant="compare" /></div>
    </header>

    <section class="compare-picker" data-compare-picker aria-labelledby="picker-heading">
      <div class="compare-picker__intro">
        <h2 id="picker-heading">Pair two tools</h2>
        <p>Choose a pair from the directory. If we already wrote it, we jump there. If not, we show the closest existing compare — we will not spin up a thin page for every combo.</p>
      </div>
      <div class="compare-picker__controls">
        <label>
          <span>Tool A</span>
          <select id="compare-a">
            <option value="">Select a tool</option>
            {categories.map((category) => (
              <optgroup label={category}>
                {pickerTools.filter((tool) => tool.category === category).map((tool) => <option value={tool.slug}>{tool.name}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
        <span class="compare-picker__vs" aria-hidden="true">vs</span>
        <label>
          <span>Tool B</span>
          <select id="compare-b">
            <option value="">Select a tool</option>
            {categories.map((category) => (
              <optgroup label={category}>
                {pickerTools.filter((tool) => tool.category === category).map((tool) => <option value={tool.slug}>{tool.name}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
      </div>
      <p class="picker-status" data-picker-status aria-live="polite">Pick two tools. If we already wrote the pair, we send you there.</p>
      <div class="picker-actions" data-picker-actions></div>
      <div class="dense-grid dense-grid--3 picker-closest" data-picker-closest></div>
    </section>

    <section class="dense-grid dense-grid--3" aria-label="Flagship comparisons">
      {COMPARISONS.map((item) => (
        <article class="compare-card">
          <div class="compare-card__marks">
            {item.toolSlugs.map((slug) => {
              const tool = AI_TOOLS.find((entry) => entry.slug === slug);
              return tool ? <ToolMark name={tool.name} websiteUrl={tool.url} size={26} /> : null;
            })}
          </div>
          <span class="eyebrow">{item.eyebrow}</span>
          <h2><a href={`/compare/${item.slug}`}>{item.title}</a></h2>
          <p>{item.job}</p>
          <p class="compare-card__summary">{item.summary}</p>
          <a class="compare-card__cta" href={`/compare/${item.slug}`}>Read comparison →</a>
        </article>
      ))}
    </section>
    <p class="compare-note">Need a starting point instead of a head-to-head? <a href="/tasks">Start with the job</a> or <a href="/tools">browse the directory</a>.</p>
  </div>
</BaseLayout>
<style>
.compare-index{padding-top:2.2rem;padding-bottom:4rem}
.compare-hero{max-width:50rem;margin-bottom:1.25rem}
.compare-hero__art{max-width:20rem;margin-top:1rem}
.compare-card__marks{display:flex;gap:.3rem;margin-bottom:.35rem}
.compare-hero p{color:var(--color-text-muted);font-size:1.02rem;line-height:1.6}
.compare-picker{margin-bottom:1.4rem;padding:.9rem;border:1px solid var(--color-border);border-radius:.65rem;background:#10110f}
.compare-picker__intro h2{margin:.15rem 0 .35rem;font-size:1.15rem}
.compare-picker__intro p{margin:0;color:#aaa69e;font-size:.88rem;line-height:1.5}
.compare-picker__controls{display:grid;grid-template-columns:1fr auto 1fr;gap:.65rem;align-items:end;margin-top:.85rem}
.compare-picker label{display:grid;gap:.3rem;color:#9a948b;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.compare-picker select{width:100%;border:1px solid #3a342c;background:#080909;color:var(--color-text);border-radius:.4rem;padding:.65rem .7rem;font:inherit}
.compare-picker__vs{padding-bottom:.7rem;color:var(--workshop-wood);font-weight:800;letter-spacing:.08em;text-transform:uppercase}
.picker-status{margin:.75rem 0 .45rem;color:#9a948b;font-size:.85rem}
.picker-actions{display:flex;flex-wrap:wrap;gap:.45rem}
.picker-closest{margin-top:.7rem}
.picker-closest-label{grid-column:1/-1;margin:0;color:#8f8b84;font-size:.75rem;text-transform:uppercase;letter-spacing:.08em}
.compare-card h2{margin:.35rem 0;font-size:1.08rem}
.compare-card h2 a{color:#f1eee7;text-decoration:none}
.compare-card__summary{font-size:.8rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.compare-note{margin-top:1.4rem;color:#8f8b84}
.compare-note a{color:#e3dfd7}
@media(max-width:700px){.compare-picker__controls{grid-template-columns:1fr}.compare-picker__vs{padding:0;text-align:center}}
</style>
<script>
  import '../../scripts/compare-picker.ts';
</script>
