---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolMark from '../../components/ToolMark.astro';
import { COMPARISONS, getComparison } from '../../data/comparisons';
import { AI_TOOLS } from '../../lib/ai-tools';
import { formatVerifiedDate } from '../../lib/tool-directory';
import { hasPricingGuide } from '../../data/pricing';

export function getStaticPaths() {
  return COMPARISONS.map((item) => ({ params: { slug: item.slug } }));
}

const comparison = getComparison(Astro.params.slug ?? '');
if (!comparison) return Astro.redirect('/compare', 302);

const reviewed = formatVerifiedDate(comparison.lastReviewed);
const description = `${comparison.title}: ${comparison.job}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: comparison.title,
  description,
  dateModified: `${comparison.lastReviewed}T00:00:00.000Z`,
};
---
<BaseLayout title={comparison.title} description={description} path={`/compare/${comparison.slug}`} jsonLd={jsonLd}>
  <article class="wrapper compare-page" data-compare-page>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/compare">Compare</a><span>/</span><span>{comparison.title}</span></nav>
    <header>
      <div class="compare-hero-marks">
        {comparison.toolSlugs.map((slug) => {
          const tool = AI_TOOLS.find((entry) => entry.slug === slug);
          return tool ? <ToolMark name={tool.name} websiteUrl={tool.url} size={40} lazy={false} /> : null;
        })}
      </div>
      <span class="eyebrow">{comparison.eyebrow}</span>
      <h1 class="page-title">{comparison.title}</h1>
      <p class="lead">{comparison.job}</p>
      <p class="reviewed">Last reviewed {reviewed}. No benchmark scores. Confirm prices on the vendor sites below.</p>
    </header>

    <nav class="compare-sticky" aria-label="On this page">
      <a href="#summary" data-compare-jump class="is-active">In short</a>
      <a href="#criteria" data-compare-jump>Criteria</a>
      <a href="#picks" data-compare-jump>Who should pick</a>
      <a href="#cost" data-compare-jump>Cost</a>
    </nav>

    <section id="summary">
      <h2>In short</h2>
      <p class="body">{comparison.summary}</p>
    </section>

    <section id="criteria">
      <h2>Comparison criteria</h2>
      <div class="criteria">
        {comparison.criteria.map((item) => (
          <div>
            <h3>{item.name}</h3>
            <p>{item.notes}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="picks">
      <h2>Who should pick which</h2>
      <div class="pick-tabs" role="tablist" aria-label="Who should pick which">
        {comparison.picks.map((pick) => (
          <button type="button" class="shed-chip" role="tab" data-pick-tab={pick.toolSlug} aria-selected="false">{pick.toolName}</button>
        ))}
      </div>
      <div class="picks">
        {comparison.picks.map((pick) => (
          <article data-pick-panel={pick.toolSlug}>
            <h3>
              {AI_TOOLS.filter((entry) => entry.slug === pick.toolSlug).map((tool) => (
                <ToolMark name={tool.name} websiteUrl={tool.url} size={24} />
              ))}
              <a href={`/tools/${pick.toolSlug}`}>{pick.toolName}</a>
            </h3>
            <p>{pick.pick}</p>
            <a href={`/tools/${pick.toolSlug}`}>Open the {pick.toolName} tool page →</a>
          </article>
        ))}
      </div>
    </section>

    <section id="cost">
      <h2>Cost caveats</h2>
      <p class="body">{comparison.cost}</p>
      <p class="body">
        {comparison.toolSlugs.filter((slug) => hasPricingGuide(slug)).map((slug) => {
          const tool = AI_TOOLS.find((entry) => entry.slug === slug);
          return tool ? <a href={`/pricing/${slug}`}>{tool.name} pricing notes</a> : null;
        })}
        <a href="/pricing/calculator">Cost calculator</a>
      </p>
    </section>

    <section>
      <h2>Limitations of this comparison</h2>
      <ul>{comparison.limitations.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section>
      <h2>Tool pages</h2>
      <div class="tool-links">
        {comparison.toolSlugs.map((slug) => <a href={`/tools/${slug}`}>/tools/{slug}</a>)}
      </div>
    </section>

    <section>
      <h2>Sources</h2>
      <ul>
        {comparison.sources.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>
        ))}
      </ul>
    </section>

    <p class="more"><a href="/compare">All comparisons</a> · <a href="/tasks">Start with a job</a> · <a href="/tools">Directory</a></p>
  </article>
</BaseLayout>
<style>
.compare-page{padding-top:2.2rem;padding-bottom:4rem;max-width:58rem}
.breadcrumbs{display:flex;gap:.55rem;color:#77736d;font-size:.78rem;margin-bottom:1.4rem}
.breadcrumbs a{color:#aaa69e;text-decoration:none}
.compare-hero-marks{display:flex;gap:.45rem;margin-bottom:.7rem}
.picks h3{display:flex;align-items:center;gap:.45rem}
#cost .body a{display:inline-block;margin:.35rem .7rem 0 0}
.lead{max-width:46rem;color:#d7d1c8;font-size:1.1rem;line-height:1.6}
.reviewed{color:#9a948b;font-size:.85rem;padding:.65rem .8rem;border:1px dashed var(--color-border);border-radius:.5rem;background:#10110f}
.compare-sticky{position:sticky;top:.55rem;z-index:4;display:flex;flex-wrap:wrap;gap:.4rem;padding:.45rem;margin:1.1rem 0;border:1px solid var(--color-border);border-radius:.55rem;background:rgba(13,13,12,.88);backdrop-filter:blur(12px)}
.compare-sticky a{padding:.32rem .6rem;border-radius:999px;color:#c7c2ba;text-decoration:none;font-size:.75rem;font-weight:700}
.compare-sticky a.is-active,.compare-sticky a:hover{color:#fff;background:rgba(23,140,255,.1)}
.compare-page section{margin:1.6rem 0}
.body,.criteria p,.picks p,li{color:#aaa69e;line-height:1.6}
.criteria{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.62rem}
.pick-tabs{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:.7rem}
.picks{display:grid;gap:.62rem}
.criteria div,.picks article{padding:.85rem;border:1px solid var(--color-border);border-radius:.55rem;background:#10110f}
.criteria h3,.picks h3{margin:.1rem 0 .4rem;color:#f1eee7;font-size:1rem}
.picks h3 a{color:#f1eee7;text-decoration:none}
.picks article a{font-size:.85rem;font-weight:700}
.tool-links{display:flex;flex-wrap:wrap;gap:.45rem}
.tool-links a{padding:.4rem .65rem;border:1px solid var(--color-border);border-radius:.4rem;color:#e3dfd7;text-decoration:none;font-size:.82rem}
.more{margin-top:1.8rem;color:#8f8b84}
.more a{color:#e3dfd7}
@media(max-width:700px){.criteria{grid-template-columns:1fr}.compare-sticky{position:static}}
</style>
<script>
  import '../../scripts/compare-page.ts';
</script>
