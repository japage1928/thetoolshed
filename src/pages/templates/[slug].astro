---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkflowBySlug } from '../../lib/supabase';

export const prerender = false;
const template = await getWorkflowBySlug(Astro.params.slug ?? '');
if (!template) return Astro.redirect('/templates', 302);
const description = template.seo_description || template.description;
const priceLabel = template.is_free ? 'Free' : `$${Number(template.price).toFixed(2)}`;
const payhipUrl = template.payhip_product_id ? `https://payhip.com/b/${template.payhip_product_id}` : null;
---

<BaseLayout title={`${template.seo_title || template.name} | The Tool Shed`} description={description} path={`/templates/${template.slug}`}>
  <div class="wrapper template-detail">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/templates">Templates</a><span>/</span><span>{template.name}</span></nav>
    <article>
      <header class="template-hero">
        {template.image_url && <img src={template.image_url} alt="" width="96" height="96" />}
        <div><span class="eyebrow">{template.category}</span><h1 class="page-title">{template.name}</h1><p>{template.description}</p></div>
      </header>
      <div class="template-info">
        <div><strong>Difficulty</strong><span>{template.difficulty}</span></div>
        <div><strong>Price</strong><span>{priceLabel}</span></div>
        {template.apps_required.length > 0 && <div><strong>Requires</strong><span>{template.apps_required.join(' · ')}</span></div>}
      </div>
      {template.included.length > 0 && <section><h2>What's included</h2><ul>{template.included.map((item) => <li>{item}</li>)}</ul></section>}
      <section class="purchase" aria-label="Purchase template">
        <div><span class="eyebrow">Get this template</span><h2>{priceLabel}</h2></div>
        {payhipUrl ? <a class="hero-button hero-button--primary" href={payhipUrl} target="_blank" rel="noopener noreferrer">Get Template <span>→</span></a> : <p>Purchase link coming soon.</p>}
      </section>
      <p class="disclosure">Checkout and digital delivery are handled securely by Payhip.</p>
    </article>
  </div>
</BaseLayout>

<style>
.template-detail{max-width:60rem;padding:3rem 0 5rem}.breadcrumbs{display:flex;gap:.55rem;color:#77736d;font-size:.78rem;margin-bottom:2.5rem}.breadcrumbs a{color:#aaa69e;text-decoration:none}.template-hero{display:flex;gap:1.25rem;align-items:flex-start}.template-hero>img{width:96px;height:96px;object-fit:cover;border-radius:18px;background:#fff}.template-hero p{max-width:48rem;color:#aaa69e;font-size:1.05rem;line-height:1.65}.template-info{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2rem 0}.template-info div{padding:1rem;border:1px solid var(--color-border);border-radius:.6rem;background:#10110f}.template-info strong{display:block;color:#77736d;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}.template-info span{color:#e3dfd7;font-size:.9rem}.template-detail section:not(.purchase){margin:2rem 0}.template-detail li{margin:.5rem 0;color:#aaa69e}.purchase{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;margin-top:2.5rem;padding:1.5rem;border:1px solid var(--color-border);border-radius:.75rem;background:linear-gradient(145deg,#141411,#0c0d0c)}.purchase h2{margin:.25rem 0 0;font-size:2rem}.disclosure{color:#77736d;font-size:.72rem;line-height:1.6;margin-top:1rem}@media(max-width:640px){.template-hero{flex-direction:column}.template-info{grid-template-columns:1fr}.purchase{flex-direction:column;align-items:stretch}}
</style>
