---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkflows } from '../../lib/supabase';

const templates = await getWorkflows();
const categories = [...new Set(templates.map((template) => template.category))].sort();
---

<BaseLayout title="AI Templates | The Tool Shed" description="Practical AI and automation templates from The Tool Shed." path="/templates">
  <div class="wrapper templates-page">
    <header class="templates-hero">
      <span class="eyebrow">THE TOOL SHED</span>
      <h1 class="page-title">AI Templates</h1>
      <p>Practical AI and automation templates you can put to work without rebuilding the wheel.</p>
    </header>
    {categories.length > 0 && <nav class="template-filters" aria-label="Template categories"><a class="is-active" href="/templates">All</a>{categories.map((category) => <a href={`#${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{category}</a>)}</nav>}
    <section class="template-grid" aria-label="AI templates">
      {templates.length === 0 ? <div class="empty-state"><h2>No templates available</h2><p>Published templates will appear here when they are added to the database.</p></div> : templates.map((template) => (
        <article class="template-card" id={template.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
          {template.image_url && <img src={template.image_url} alt="" loading="lazy" />}
          <div class="template-card__body">
            <div class="template-card__meta"><span>{template.category}</span><span>{template.difficulty}</span></div>
            <h2><a href={`/templates/${template.slug}`}>{template.name}</a></h2>
            <p>{template.description}</p>
            <div class="template-card__bottom"><strong>{template.is_free ? 'Free' : `$${Number(template.price).toFixed(2)}`}</strong><a href={`/templates/${template.slug}`}>View Template →</a></div>
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
.templates-page{padding:4rem 0 5rem}.templates-hero{max-width:48rem;margin-bottom:2rem}.templates-hero p{color:var(--color-text-muted);font-size:1.08rem;line-height:1.7}.template-filters{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.5rem}.template-filters a{border:1px solid var(--color-border);border-radius:999px;padding:.45rem .75rem;color:#aaa69e;text-decoration:none;font-size:.78rem}.template-filters a:hover,.template-filters .is-active{border-color:var(--shed-blue);color:#fff}.template-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.template-card{overflow:hidden;border:1px solid var(--color-border);border-radius:.7rem;background:#10110f}.template-card>img{width:100%;aspect-ratio:16/9;object-fit:cover}.template-card__body{padding:1.1rem}.template-card__meta{display:flex;justify-content:space-between;color:#77736d;font-size:.68rem;text-transform:uppercase;letter-spacing:.08em}.template-card h2{font-size:1.2rem;margin:.55rem 0}.template-card h2 a{color:#f1eee7;text-decoration:none}.template-card p{color:#aaa69e;line-height:1.55;font-size:.9rem;min-height:4.2rem}.template-card__bottom{display:flex;justify-content:space-between;align-items:center;margin-top:1rem;padding-top:.8rem;border-top:1px solid #25221e}.template-card__bottom strong{color:#f1eee7}.template-card__bottom a{color:var(--shed-blue);font-size:.8rem;font-weight:700;text-decoration:none}.empty-state{grid-column:1/-1;border:1px dashed var(--color-border);border-radius:.7rem;padding:3rem;text-align:center;color:#aaa69e}@media(max-width:900px){.template-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.templates-page{padding:2.5rem 0 4rem}.template-grid{grid-template-columns:1fr}}
</style>
