---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/site';
import { AI_TOOLS, AI_TOOL_CATEGORIES } from '../lib/ai-tools';

const description = `Explore the ${SITE_NAME} AI tools directory. Find AI assistants, coding tools, app builders, image generators, video tools, automation platforms, and more.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Tool Shed AI Tools Directory',
  description,
  numberOfItems: AI_TOOLS.length,
  itemListElement: AI_TOOLS.map((tool, index) => ({ '@type': 'ListItem', position: index + 1, name: tool.name })),
};
---

<BaseLayout title="AI Tools Directory" description={description} path="/tools" jsonLd={jsonLd}>
  <div class="wrapper tools-directory">
    <header class="tools-directory__hero">
      <span class="eyebrow">The Tool Shed</span>
      <h1 class="page-title">AI Tools Directory</h1>
      <p class="tools-directory__intro">Find the right AI tool for the job. Explore assistants, coding tools, app builders, creative tools, research platforms, automation, and more.</p>
    </header>

    <section class="tools-directory__controls" aria-label="Tool directory filters">
      <label class="tools-search">
        <span class="sr-only">Search AI tools</span>
        <input id="tool-search" type="search" placeholder="Search tools, categories, or use cases…" autocomplete="off" />
      </label>
      <div class="tools-categories" role="group" aria-label="Filter by category">
        <button type="button" class="tool-filter is-active" data-category="All">All</button>
        {AI_TOOL_CATEGORIES.map((category) => <button type="button" class="tool-filter" data-category={category}>{category}</button>)}
      </div>
    </section>

    <div class="tools-directory__meta">
      <span><strong id="tool-count">{AI_TOOLS.length}</strong> tools</span>
      <span>Directory expanding</span>
    </div>

    <section class="tool-grid" id="tool-grid" aria-live="polite">
      {AI_TOOLS.map((tool) => (
        <article class="tool-card" data-search={`${tool.name} ${tool.description} ${tool.category} ${tool.bestFor} ${tool.tags.join(' ')}`.toLowerCase()} data-category={tool.category}>
          <div class="tool-card__topline">
            <span class="tool-card__category">{tool.category}</span>
            {tool.affiliate && <span class="tool-card__badge">Partner</span>}
          </div>
          <h2>{tool.name}</h2>
          <p>{tool.description}</p>
          <div class="tool-card__best"><strong>Best for:</strong> {tool.bestFor}</div>
          <div class="tool-card__tags">{tool.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}</div>
          <a class="tool-card__link" href={tool.url} target="_blank" rel={tool.affiliate ? 'sponsored noopener noreferrer' : 'noopener noreferrer'}>
            {tool.name} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </section>

    <p class="tools-empty" id="tools-empty" hidden>No tools match that search.</p>
    <p class="tools-disclosure">Some Tool Shed links may be affiliate links. When they are, we may earn a commission if you use the link to sign up or purchase. This does not change the price you pay.</p>
  </div>
</BaseLayout>

<style>
  .tools-directory { padding-top: 4rem; padding-bottom: 5rem; }
  .tools-directory__hero { max-width: 48rem; margin-bottom: 2.25rem; }
  .tools-directory__intro { max-width: 42rem; margin-top: 1rem; color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.7; }
  .tools-directory__controls { border: 1px solid var(--color-border); background: rgba(13,13,12,.82); border-radius: .65rem; padding: 1rem; position: sticky; top: .75rem; z-index: 5; backdrop-filter: blur(12px); }
  .tools-search input { width: 100%; box-sizing: border-box; border: 1px solid #3a342c; background: #080909; color: var(--color-text); border-radius: .4rem; padding: .8rem .9rem; outline: none; }
  .tools-search input:focus { border-color: var(--shed-blue); box-shadow: 0 0 0 3px rgba(23,140,255,.12); }
  .tools-categories { display: flex; gap: .45rem; flex-wrap: wrap; margin-top: .75rem; }
  .tool-filter { border: 1px solid #3a342c; background: transparent; color: #aaa69e; border-radius: 999px; padding: .45rem .7rem; font: inherit; font-size: .78rem; cursor: pointer; }
  .tool-filter:hover, .tool-filter.is-active { color: #fff; border-color: var(--shed-blue); background: rgba(23,140,255,.1); }
  .tools-directory__meta { display: flex; justify-content: space-between; gap: 1rem; color: #77736d; font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; margin: 1.5rem 0 .75rem; }
  .tools-directory__meta strong { color: #d7d1c8; }
  .tool-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
  .tool-card { display: flex; flex-direction: column; min-height: 17rem; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: .6rem; background: linear-gradient(145deg, #11110f, #0b0c0c); transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease; }
  .tool-card:hover { transform: translateY(-2px); border-color: #4a443b; box-shadow: 0 12px 30px rgba(0,0,0,.25); }
  .tool-card__topline { display: flex; justify-content: space-between; gap: .5rem; align-items: center; }
  .tool-card__category { color: var(--shed-blue); font-size: .68rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 700; }
  .tool-card__badge { color: #d9b27b; border: 1px solid rgba(200,139,75,.35); background: rgba(154,93,47,.12); border-radius: 999px; padding: .2rem .45rem; font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; }
  .tool-card h2 { margin: .65rem 0 .4rem; color: #f1eee7; font-size: 1.25rem; }
  .tool-card p { color: #aaa69e; line-height: 1.55; font-size: .9rem; margin: 0; }
  .tool-card__best { margin-top: .8rem; color: #c7c2ba; font-size: .78rem; line-height: 1.45; }
  .tool-card__best strong { color: #e5e0d7; }
  .tool-card__tags { display: flex; gap: .35rem; flex-wrap: wrap; margin-top: auto; padding-top: 1rem; }
  .tool-card__tags span { color: #77736d; background: #151412; border: 1px solid #29251f; border-radius: .25rem; padding: .18rem .38rem; font-size: .65rem; }
  .tool-card__link { display: flex; justify-content: space-between; align-items: center; margin-top: .85rem; padding-top: .75rem; border-top: 1px solid #25221e; color: #e9eef2; text-decoration: none; font-size: .82rem; font-weight: 700; }
  .tool-card__link:hover { color: var(--shed-blue); }
  .tools-empty { padding: 3rem 1rem; text-align: center; color: var(--color-text-muted); border: 1px dashed var(--color-border); border-radius: .6rem; margin-top: 1rem; }
  .tools-disclosure { max-width: 48rem; margin: 2.5rem auto 0; color: #6f6b65; font-size: .72rem; line-height: 1.6; text-align: center; }
  @media (max-width: 980px) { .tool-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (max-width: 640px) { .tools-directory { padding-top: 2.5rem; } .tools-directory__controls { position: static; } .tool-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('#tool-search');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.tool-filter'));
  const count = document.querySelector<HTMLElement>('#tool-count');
  const empty = document.querySelector<HTMLElement>('#tools-empty');
  let activeCategory = 'All';

  function render() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const matchesCategory = activeCategory === 'All' || card.dataset.category === activeCategory;
      const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
      const show = matchesCategory && matchesQuery;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener('input', render);
  filters.forEach((filter) => filter.addEventListener('click', () => {
    activeCategory = filter.dataset.category ?? 'All';
    filters.forEach((item) => item.classList.toggle('is-active', item === filter));
    render();
  }));
</script>
