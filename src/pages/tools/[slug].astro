---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolBySlug, getTools, toolUrl } from '../../lib/supabase';
const tool = await getToolBySlug(Astro.params.slug ?? '');
if (!tool) return Astro.redirect('/tools', 302);
const allTools = await getTools();
const alternativeSet = new Set(tool.alternative_slugs ?? []);
const alternatives = allTools.filter((item) => alternativeSet.has(item.slug)).slice(0, 3);
const related = allTools.filter((item) => item.slug !== tool.slug && (item.category === tool.category || item.tags.some((tag) => tool.tags.includes(tag)))).slice(0, 4);
const domain = new URL(tool.website_url).hostname.replace(/^www\./, '');
const iconUrl = tool.icon_url || `https://www.google.com/s2/favicons?domain=${domain}&sz=128`;
const description = `${tool.name}: ${tool.description}`;
const pricing = tool.pricing_summary || 'Pricing varies by plan and usage. Check the vendor site for current free, trial, and paid options.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.description,
  applicationCategory: tool.category,
  url: new URL(`/tools/${tool.slug}`, Astro.site).toString(),
  mainEntityOfPage: new URL(`/tools/${tool.slug}`, Astro.site).toString(),
  offers: { '@type': 'Offer', url: tool.website_url, description: pricing },
};
---
<BaseLayout title={`${tool.name} | The Tool Shed`} description={description} path={`/tools/${tool.slug}`} jsonLd={jsonLd}>
<div class="wrapper tool-detail">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/tools">AI Tools</a><span>/</span><a href={`/tools/category/${tool.category.toLowerCase().replace(/[^a-z0-9]+/g,'-')}`}>{tool.category}</a><span>/</span><span>{tool.name}</span></nav>
  <article>
    <header class="tool-hero"><img src={iconUrl} alt={`${tool.name} icon`} width="72" height="72"/><div><span class="eyebrow">{tool.category}</span><h1 class="page-title">{tool.name}</h1></div></header>
    <p class="lead">{tool.description}</p>
    <section><h2>What is {tool.name}?</h2><p class="body-copy">{tool.description}</p></section>
    <div class="tool-meta"><div><strong>Best for</strong><span>{tool.best_for}</span></div><div><strong>Tags</strong><span>{tool.tags.join(' · ')}</span></div></div>
    <section><h2>Pricing</h2><p class="body-copy">{pricing}</p></section>
    <section class="split-grid">
      <div><h2>Pros</h2><ul class="feature-list">{tool.pros.map((item)=><li>{item}</li>)}</ul></div>
      <div><h2>Cons</h2><ul class="feature-list">{tool.cons.map((item)=><li>{item}</li>)}</ul></div>
    </section>
    <section><h2>Best-fit use cases</h2><ul class="feature-list">{tool.use_cases.map((item)=><li>{item}</li>)}</ul></section>
    {alternatives.length > 0 && <section><h2>Alternatives</h2><div class="link-grid">{alternatives.map((item)=><a href={`/tools/${item.slug}"><strong>{item.name}</strong><span>{item.description}</span></a>)}</div></section>}
    <section><h2>Frequently asked questions</h2><div class="faq-list">{tool.faq.map((item)=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>
    {related.length > 0 && <section><div class="section-row"><h2>Related tools</h2><a href="/tools">Browse all →</a></div><div class="link-grid">{related.map((item)=><a href={`/tools/${item.slug}"><strong>{item.name}</strong><span>{item.category} · {item.best_for}</span></a>)}</div></section>}
    <div class="tool-actions"><a class="hero-button hero-button--primary" href={toolUrl(tool)} target="_blank" rel={tool.is_affiliate?'sponsored noopener noreferrer':'noopener noreferrer'} id="visit-tool" data-tool-name={tool.name} data-tool-slug={tool.slug} data-tool-category={tool.category} data-affiliate={tool.is_affiliate?'true':'false'}>Visit {tool.name} <span>→</span></a><a class="hero-button" href="/tools">Back to directory</a></div>
    {tool.is_affiliate && <p class="disclosure">This is a partner link. The Tool Shed may earn a commission if you sign up or purchase through it, at no additional cost to you.</p>}
  </article>
</div>
</BaseLayout>
<style>
.tool-detail{padding-top:3rem;padding-bottom:5rem;max-width:58rem}.breadcrumbs{display:flex;gap:.55rem;flex-wrap:wrap;color:#77736d;font-size:.78rem;margin-bottom:2.5rem}.breadcrumbs a{color:#aaa69e;text-decoration:none}.tool-hero{display:flex;align-items:center;gap:1rem}.tool-hero img{width:72px;height:72px;border-radius:16px;background:#fff;padding:7px;box-sizing:border-box;box-shadow:0 10px 30px rgba(0,0,0,.25)}.tool-hero .page-title{margin:.15rem 0 0}.lead{max-width:48rem;color:#aaa69e;font-size:1.15rem;line-height:1.75;margin:1.5rem 0}.body-copy{max-width:48rem;color:#aaa69e;line-height:1.7}.tool-detail section{margin:2.25rem 0}.tool-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:2rem 0}.tool-meta div{padding:1rem;border:1px solid var(--color-border);border-radius:.6rem;background:#10110f}.tool-meta strong{display:block;color:#77736d;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}.tool-meta span{color:#e3dfd7;font-size:.9rem}.split-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem}.feature-list{padding-left:1.2rem;color:#aaa69e;line-height:1.7}.feature-list li{margin:.45rem 0}.faq-list{display:grid;gap:.5rem}.faq-list details{border:1px solid var(--color-border);border-radius:.55rem;background:#10110f;padding:1rem}.faq-list summary{cursor:pointer;color:#e3dfd7;font-weight:600}.faq-list p{color:#aaa69e;line-height:1.6;margin:.8rem 0 0}.link-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.link-grid a{display:grid;gap:.35rem;padding:1rem;border:1px solid var(--color-border);border-radius:.6rem;background:#10110f;color:#e3dfd7;text-decoration:none}.link-grid a:hover{border-color:#555}.link-grid span{color:#8f8b84;font-size:.82rem;line-height:1.5}.section-row{display:flex;align-items:center;justify-content:space-between;gap:1rem}.section-row a{color:#aaa69e;font-size:.8rem}.tool-actions{display:flex;gap:.7rem;flex-wrap:wrap}.disclosure{color:#77736d;font-size:.72rem;line-height:1.6;margin-top:1.5rem}@media(max-width:640px){.tool-meta,.split-grid,.link-grid{grid-template-columns:1fr}.tool-hero img{width:58px;height:58px}.tool-actions .hero-button{width:100%;justify-content:center}}
</style>
<script>
const visit=document.querySelector<HTMLElement>('#visit-tool');visit?.addEventListener('click',()=>{const gtag=(window as any).gtag;if(typeof gtag==='function'){const params={tool_name:visit.dataset.toolName??'',tool_slug:visit.dataset.toolSlug??'',tool_category:visit.dataset.toolCategory??'',affiliate:visit.dataset.affiliate==='true',source:'tool_detail'};gtag('event','tool_click',params);if(params.affiliate)gtag('event','affiliate_click',params)}});
</script>
