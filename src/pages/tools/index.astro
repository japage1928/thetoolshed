---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getDirectoryCategories, getDirectoryTools } from '../../lib/tool-directory';
import { COMPARISONS } from '../../data/comparisons';
import { TASKS } from '../../data/tasks';

const tools = await getDirectoryTools();
const categories = await getDirectoryCategories();
const description = 'Find the right AI tool for a real job. Browse The Tool Shed directory by use case — assistants, research, coding, automation, and more.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Tool Shed AI Directory',
  description,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: tools.length,
    itemListElement: tools.map((tool, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: tool.name,
      url: new URL(`/tools/${tool.slug}`, Astro.site).toString(),
    })),
  },
};
---

<BaseLayout title="Find the right AI tool" description={description} path="/tools" {jsonLd}>
  <div class="wrapper directory-page" data-directory>
    <header class="directory-hero">
      <span class="eyebrow">DISCOVER · AI TOOLS FOR REAL WORK</span>
      <h1 class="page-title">Find the right AI tool for the job.</h1>
      <p>Browse {tools.length} tools, grouped by what they help you do. Compare when you are choosing. Check vendor pricing before you spend.</p>
    </header>

    <section class="directory-controls" aria-label="Tool directory search and categories">
      <label class="tools-search">
        <span class="sr-only">Search AI tools</span>
        <input id="tool-search" type="search" placeholder="Search tools, jobs, or categories…" autocomplete="off" />
      </label>
      <nav class="category-links" aria-label="AI tool categories">
        <a class="tool-filter is-active" href="/tools" data-category="All">All</a>
        {categories.map((category) => <a class="tool-filter" href={`/tools/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} data-category={category}>{category}</a>)}
      </nav>
    </section>

    <div class="directory-meta">
      <span><strong id="tool-count">{tools.length}</strong> tools</span>
      <a href="/compare">Popular comparisons →</a>
    </div>

    <section class="dense-grid" id="tool-grid" aria-label="AI tools">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </section>

    <div class="tools-empty" id="tools-empty" hidden>
      <p>No tools match that search.</p>
      <p>Try a written compare or start from a job instead.</p>
      <div class="empty-links">
        {COMPARISONS.slice(0, 3).map((item) => <a class="shed-chip" href={`/compare/${item.slug}`}>{item.title}</a>)}
        {TASKS.slice(0, 3).map((task) => <a class="shed-chip" href={`/tasks#${task.slug}`}>{task.label}</a>)}
      </div>
    </div>
    <p class="tools-disclosure">Some Tool Shed links may be affiliate links. When they are, we may earn a commission if you use the link to sign up or purchase. This does not change the price you pay. Pricing on tool pages is labeled when we have not verified it.</p>
  </div>
</BaseLayout>

<style>
  .directory-page{padding-top:2.2rem;padding-bottom:4rem}
  .directory-hero{max-width:54rem;margin-bottom:1.25rem}
  .directory-hero p{max-width:42rem;color:var(--color-text-muted);font-size:1.02rem;line-height:1.6}
  .directory-controls{border:1px solid var(--color-border);background:rgba(13,13,12,.82);border-radius:.65rem;padding:.75rem;margin-bottom:.85rem;position:sticky;top:.65rem;z-index:5;backdrop-filter:blur(12px)}
  .tools-search input{width:100%;box-sizing:border-box;border:1px solid #3a342c;background:#080909;color:var(--color-text);border-radius:.4rem;padding:.7rem .8rem;outline:none}
  .tools-search input:focus{border-color:var(--shed-blue);box-shadow:0 0 0 3px rgba(23,140,255,.12)}
  .category-links{display:flex;gap:.4rem;flex-wrap:wrap;margin:.65rem 0 0}
  .directory-meta{display:flex;justify-content:space-between;gap:1rem;color:#77736d;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .75rem}
  .directory-meta strong{color:#d7d1c8}
  .directory-meta a{color:#aaa69e;text-decoration:none}
  .tools-empty{padding:1.4rem 1rem;text-align:center;color:var(--color-text-muted);border:1px dashed var(--color-border);border-radius:.6rem;margin-top:.75rem;background:#10110f}
  .tools-empty p{margin:.25rem 0}
  .empty-links{display:flex;flex-wrap:wrap;justify-content:center;gap:.45rem;margin-top:.8rem}
  .tools-disclosure{max-width:48rem;margin:2rem auto 0;color:#6f6b65;font-size:.72rem;line-height:1.6;text-align:center}
  @media(max-width:640px){.directory-controls{position:static}}
</style>
<script>
  import '../../scripts/directory-filter.ts';
</script>
