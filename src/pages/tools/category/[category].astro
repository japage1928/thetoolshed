---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { getDirectoryCategories, getDirectoryToolsByCategory } from '../../../lib/tool-directory';

const slug = Astro.params.category ?? '';
const categories = await getDirectoryCategories();
const category = categories.find((item) => item.toLowerCase().replace(/[^a-z0-9]+/g, '-') === slug);
if (!category) return Astro.redirect('/tools', 302);
const tools = await getDirectoryToolsByCategory(category);
const description = `Explore ${category} AI tools in The Tool Shed directory. Find what fits the job, then check vendor pricing.`;
const jsonLd = {'@context':'https://schema.org','@type':'CollectionPage',name:`${category} AI Tools`,description,mainEntity:{'@type':'ItemList',numberOfItems:tools.length,itemListElement:tools.map((tool,index)=>({'@type':'ListItem',position:index+1,name:tool.name,url:new URL(`/tools/${tool.slug}`,Astro.site).toString()}))}};
---
<BaseLayout title={`${category} AI Tools`} description={description} path={`/tools/category/${slug}`} jsonLd={jsonLd}>
<div class="wrapper category-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/tools">AI Tools</a><span aria-hidden="true">/</span><span>{category}</span></nav>
  <header class="category-hero">
    <span class="eyebrow">Directory by use case</span>
    <h1 class="page-title">{category} AI Tools</h1>
    <p>{tools.length} tools for {category.toLowerCase()}. Open a tool page for cost caveats and fit notes — we label anything we have not verified.</p>
  </header>
  <section class="dense-grid" aria-label={`${category} AI tools`}>
    {tools.map((tool) => <ToolCard tool={tool} />)}
  </section>
</div>
</BaseLayout>
<style>
.category-page{padding-top:2.2rem;padding-bottom:4rem}
.breadcrumbs{display:flex;gap:.55rem;color:#77736d;font-size:.78rem;margin-bottom:1.25rem}
.breadcrumbs a{color:#aaa69e;text-decoration:none}
.category-hero{max-width:50rem;margin-bottom:1.25rem}
.category-hero p{max-width:42rem;color:var(--color-text-muted);font-size:1.02rem;line-height:1.6}
</style>
