---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pipeline = ['Brief', 'Plan', 'Generate', 'Evaluate', 'Repair', 'Assemble', 'Publish'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'The Tool Shed Video Studio',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  description: 'Turn a product link or creative brief into a planned, quality-checked marketing video workflow.',
};
---
<BaseLayout
  title="AI Video Studio"
  description="Paste a product link or describe a campaign. The Tool Shed plans, generates, checks, repairs, and assembles the video production workflow."
  path="/tools/video-studio"
  {jsonLd}
>
  <div class="video-landing">
    <section class="hero wrap">
      <div class="hero-copy">
        <span class="eyebrow">THE TOOL SHED · INTERNAL BETA</span>
        <h1>Give us the product.<br /><em>Get the video plan.</em></h1>
        <p class="lead">Paste a product link or describe the campaign. Video Studio handles the script, shot plan, continuity instructions, QA, targeted repair, assembly plan, and publishing copy behind one simple workspace.</p>
        <div class="actions">
          <a class="primary" href="/app/video-studio">Open Video Studio</a>
          <a class="secondary" href="#how-it-works">See the production system</a>
        </div>
        <p class="beta-note"><span></span> Google and email sign-in are available. Billing and paid generation are intentionally disabled during internal testing.</p>
      </div>
      <div class="production-card" aria-label="Video production status illustration">
        <div class="card-top"><span>PRODUCT VIDEO 001</span><b>PLANNING</b></div>
        <div class="preview">
          <div class="frame frame-one"><span>01</span><b>Hook</b></div>
          <div class="frame frame-two"><span>02</span><b>Proof</b></div>
          <div class="frame frame-three"><span>03</span><b>Payoff</b></div>
        </div>
        <div class="qa-row"><span>Prompt QA</span><i></i><strong>Ready</strong></div>
        <div class="qa-row"><span>Continuity</span><i></i><strong>Locked</strong></div>
        <div class="qa-row muted"><span>Live render</span><i></i><strong>Paused</strong></div>
      </div>
    </section>

    <section id="how-it-works" class="system wrap">
      <div class="section-head">
        <span class="eyebrow">A PRODUCTION DEPARTMENT, NOT A MODEL PICKER</span>
        <h2>One input. A controlled production line.</h2>
        <p>The workflow keeps the technical choices behind the scenes and exposes the decisions that matter: goal, platform, duration, and budget.</p>
      </div>
      <div class="pipeline">
        {pipeline.map((step, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><b>{step}</b></div>)}
      </div>
    </section>

    <section class="features wrap">
      <article><span>01</span><h3>URL to campaign brief</h3><p>Start from a product, affiliate, or business URL without rebuilding the product facts by hand.</p></article>
      <article><span>02</span><h3>Shot-level QA</h3><p>Evaluate prompts, continuity, relevance, and final-scene compatibility before treating output as finished.</p></article>
      <article><span>03</span><h3>Targeted repair</h3><p>Reserve regeneration for the scene that failed instead of paying to remake an entire project.</p></article>
      <article><span>04</span><h3>Credits, not API math</h3><p>Understand the project estimate up front while provider cost and model routing stay inside the production system.</p></article>
    </section>

    <section class="launch wrap">
      <div>
        <span class="eyebrow">INTERNAL BETA ACCESS</span>
        <h2>Build the project before spending on the render.</h2>
        <p>Create the brief, save production settings, and inspect the workspace now. The existing n8n video engine is isolated and will be connected behind cost and credit guardrails.</p>
      </div>
      <a class="primary" href="/app/video-studio">Enter the workspace</a>
    </section>
  </div>
</BaseLayout>

<style>
  .video-landing{overflow:hidden;background:radial-gradient(circle at 82% 8%,rgba(23,140,255,.12),transparent 28rem)}
  .wrap{width:min(1180px,calc(100% - 2rem));margin-inline:auto}.hero{min-height:720px;display:grid;grid-template-columns:1.08fr .92fr;gap:4rem;align-items:center;padding:6rem 0}.eyebrow{font-size:.7rem;letter-spacing:.17em;font-weight:900;color:#c7a76a}.hero h1{font-size:clamp(3.2rem,7vw,6.4rem);line-height:.9;letter-spacing:-.065em;margin:.8rem 0 1.5rem;max-width:850px}.hero h1 em{font-family:Georgia,serif;font-weight:400;color:#9fcfff}.lead{max-width:720px;color:#aaa69e;font-size:1.08rem;line-height:1.75}.actions{display:flex;gap:.8rem;flex-wrap:wrap;margin:2rem 0 1.2rem}.actions a,.launch>a{padding:.9rem 1.1rem;border-radius:.55rem;text-decoration:none;font-weight:900}.primary{background:#ece6da;color:#0b0c0b}.secondary{border:1px solid var(--color-border);color:#ece6da}.beta-note{display:flex;align-items:flex-start;gap:.55rem;max-width:680px;color:#77736d;font-size:.8rem;line-height:1.55}.beta-note span{width:.48rem;height:.48rem;border-radius:50%;background:#c7a76a;box-shadow:0 0 12px rgba(199,167,106,.5);margin-top:.38rem;flex:none}
  .production-card{padding:1.2rem;border:1px solid #34302a;border-radius:1rem;background:linear-gradient(145deg,#131411,#090a09);box-shadow:0 36px 90px rgba(0,0,0,.38);transform:rotate(1.5deg)}.card-top{display:flex;justify-content:space-between;align-items:center;color:#7f7b74;font-size:.66rem;letter-spacing:.12em}.card-top b{color:#c7a76a}.preview{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.55rem;margin:1rem 0 1.2rem}.frame{aspect-ratio:9/16;border-radius:.55rem;border:1px solid #333;background:linear-gradient(165deg,#20231f,#111);padding:.6rem;display:flex;flex-direction:column;justify-content:space-between;color:#777}.frame-two{background:linear-gradient(165deg,#12283a,#0d1215);transform:translateY(-.45rem)}.frame-three{background:linear-gradient(165deg,#35291c,#111)}.frame b{color:#e7e2d9;font-size:.78rem}.qa-row{display:grid;grid-template-columns:100px 1fr auto;gap:.7rem;align-items:center;margin:.7rem 0;color:#8e8a83;font-size:.72rem}.qa-row i{height:3px;border-radius:9px;background:linear-gradient(90deg,#178cff 88%,#262824 88%)}.qa-row strong{color:#9fcfff}.qa-row.muted i{background:#2b2b27}.qa-row.muted strong{color:#777}
  .system{padding:6rem 0;border-top:1px solid var(--color-border)}.section-head{max-width:780px}.section-head h2,.launch h2{font-size:clamp(2.2rem,5vw,4.4rem);line-height:1;letter-spacing:-.045em;margin:.6rem 0 1rem}.section-head p,.launch p{color:#969188;line-height:1.7}.pipeline{display:grid;grid-template-columns:repeat(7,1fr);gap:.5rem;margin-top:2.3rem}.pipeline div{min-height:110px;padding:1rem;border:1px solid var(--color-border);background:#10110f;border-radius:.65rem;display:flex;flex-direction:column;justify-content:space-between}.pipeline span,.features article>span{font-size:.65rem;letter-spacing:.14em;color:#69665f}.pipeline b{font-size:.84rem}.features{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;padding:1rem 0 6rem}.features article{padding:1.35rem;border-top:1px solid #4e4639;background:linear-gradient(180deg,#121310,#0c0d0c);border-radius:.6rem}.features h3{margin:1.4rem 0 .6rem}.features p{color:#8f8b84;line-height:1.65;font-size:.9rem}.launch{margin-bottom:7rem;padding:3rem;border:1px solid #394657;border-radius:1rem;background:linear-gradient(110deg,#111814,#0e1923);display:flex;align-items:center;justify-content:space-between;gap:3rem}.launch>div{max-width:780px}.launch>a{white-space:nowrap}
  @media(max-width:980px){.hero{grid-template-columns:1fr;min-height:auto;padding:5rem 0}.production-card{max-width:600px;transform:none}.pipeline{grid-template-columns:repeat(4,1fr)}.features{grid-template-columns:1fr 1fr}}
  @media(max-width:620px){.hero h1{font-size:3.3rem}.pipeline{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.launch{display:block;padding:2rem}.launch>a{display:inline-block;margin-top:1rem}}
</style>
