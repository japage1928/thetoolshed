---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { getPublishedPosts, getPrompts } from '../lib/supabase';

const prompts = await getPrompts();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
const featuredPrompts = prompts.filter((item) => item.featured).slice(0, 3);
const homeTitle = 'Useful AI tools, news, and working notes';
const homeDescription = 'Practical coverage of AI tools, news, prompts, and workflows worth your attention.';
---
<BaseLayout title={homeTitle} description={homeDescription} path="/">
<div class="home-page">
<section class="shed-hero" aria-labelledby="hero-title">
  <div class="shed-hero__wall" aria-hidden="true"></div>
  <div class="shed-hero__workbench" aria-hidden="true"></div>
  <div class="shed-hero__tools" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
  <div class="shed-hero__circuits" aria-hidden="true"></div>
  <div class="shed-hero__laptop" aria-hidden="true"><div class="shed-hero__screen"><span></span><span></span><span></span><span></span><span></span></div></div>
  <div class="shed-hero__lamp" aria-hidden="true"></div>
  <div class="shed-hero__copy">
    <span class="shed-hero__eyebrow">AI TOOLS · NEWS · WORKFLOWS</span>
    <h1 id="hero-title"><span class="shed-hero__the">THE</span><span class="shed-hero__tool">TOOL</span><span class="shed-hero__shed">SHED</span></h1>
    <p>Useful AI tools, important updates, and practical ways to put them to work.</p>
    <div class="shed-hero__actions">
      <a class="hero-button hero-button--primary" href="/tools">Explore AI tools <span>→</span></a>
      <a class="hero-button" href="/blog">Read the latest</a>
    </div>
  </div>
  <div class="shed-hero__tagline">PROMPT <b>•</b> SHORT CLIP <b>•</b> DONE</div>
</section>

<section class="home-section home-section--resources" aria-labelledby="resources-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Practical coverage, not AI theater</span>
        <h2 id="resources-heading">Find what is worth using</h2>
      </div>
    </div>
    <div class="resource-grid">
      <article class="resource-panel">
        <span class="eyebrow">AI TOOLS</span>
        <h3>Tools explained without the brochure voice</h3>
        <p>Browse practical write-ups on what AI tools do, who they are for, and where they fit in a real workflow.</p>
        <a class="resource-panel__cta" href="/tools">Browse the AI directory →</a>
      </article>
      <article class="resource-panel">
        <span class="eyebrow">ON THE BENCH</span>
        <h3>Prompts, loops, and notes</h3>
        <p>Ready-to-use prompts, practical workflow notes, and experiments that survived contact with reality.</p>
        {featuredPrompts.length > 0 && <ul>{featuredPrompts.map((item) => <li><a href={`/prompts/${item.slug}`}>{item.name}</a></li>)}</ul>}
        <a class="resource-panel__cta" href="/prompts">Browse prompts &amp; loops →</a>
      </article>
    </div>
  </div>
</section>

{latestPosts.length > 0 && <section class="home-section home-section--latest" aria-labelledby="latest-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div><span class="eyebrow">Latest from the bench</span><h2 id="latest-heading">Latest</h2></div>
      <a href="/blog">View all →</a>
    </div>
    <div class="blog-index__grid">{latestPosts.map((post) => <article class="db-post-card"><span class="eyebrow">{post.category || 'Article'}</span><h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3><p>{post.excerpt}</p><a class="db-post-card__link" href={`/blog/${post.slug}`}>Read article →</a></article>)}</div>
  </div>
</section>}

<section class="home-section"><div class="wrapper"><EmailCapture source="homepage" /></div></section>

<section class="home-section home-section--x" aria-labelledby="x-heading">
  <div class="wrapper x-callout">
    <div>
      <span class="eyebrow">Follow the builder</span>
      <h2 id="x-heading">More of what actually ships, on X</h2>
      <p>Practical AI tool notes, news, and the occasional useful workflow. No hype-factory nonsense.</p>
    </div>
    <a class="hero-button hero-button--primary" href="https://x.com/john_page1990" target="_blank" rel="me noopener noreferrer">Follow @john_page1990 on X <span>→</span></a>
  </div>
</section>
</div>
</BaseLayout>
<style>
.resource-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.resource-panel{padding:1.4rem;border:1px solid var(--color-border);border-radius:.7rem;background:#0f100f}.resource-panel h3{margin:.5rem 0}.resource-panel p{color:#aaa69e;line-height:1.55}.resource-panel ul{margin:1rem 0;padding-left:1.1rem}.resource-panel li{margin:.45rem 0}.resource-panel a{color:#f1eee7}.resource-panel__cta{display:inline-block;margin-top:.5rem;font-weight:700;text-decoration:none}.x-callout{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem;border:1px solid var(--color-border);border-radius:.7rem;background:#0f100f}.x-callout p{color:#aaa69e;max-width:42rem}.db-post-card{padding:1.25rem;border:1px solid var(--color-border);border-radius:.6rem;background:#0f100f}.db-post-card h3{margin:.5rem 0}.db-post-card h3 a{color:#f1eee7;text-decoration:none}.db-post-card p{color:#aaa69e;line-height:1.55}.db-post-card__link{font-size:.8rem;font-weight:700;text-decoration:none}.db-post-card__link:hover{text-decoration:underline}@media(max-width:700px){.resource-grid{grid-template-columns:1fr}.x-callout{align-items:flex-start;flex-direction:column}}
</style>
