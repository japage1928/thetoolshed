---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} path="/">
  <div class="wrapper" style="padding-top: 3rem; padding-bottom: 3rem;">
    <h1 class="page-title">{SITE_NAME}</h1>
    <p style="max-width: 40rem; color: var(--color-text-muted); font-size: 1.05rem;">
      {SITE_DESCRIPTION}
    </p>

    {
      latestPosts.length > 0 && (
        <>
          <h2 style="margin-top: 3rem;">Latest from the blog</h2>
          <div class="blog-index__grid">
            {latestPosts.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
          <p>
            <a href="/blog">View all articles &rarr;</a>
          </p>
        </>
      )
    }
  </div>
</BaseLayout>
