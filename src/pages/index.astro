---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} path="/">
  <div class="home-page">
    <section class="shed-hero" aria-labelledby="hero-title">
      <div class="shed-hero__wall" aria-hidden="true"></div>
      <div class="shed-hero__workbench" aria-hidden="true"></div>
      <div class="shed-hero__tools" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="shed-hero__circuits" aria-hidden="true"></div>
      <div class="shed-hero__laptop" aria-hidden="true">
        <div class="shed-hero__screen"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
      <div class="shed-hero__lamp" aria-hidden="true"></div>
      <div class="shed-hero__copy">
        <span class="shed-hero__eyebrow">AI tools · automation · practical resources</span>
        <h1 id="hero-title">
          <span class="shed-hero__the">THE</span>
          <span class="shed-hero__tool">TOOL</span>
          <span class="shed-hero__shed">SHED</span>
        </h1>
        <p>Useful things for people who want to build, automate, and actually get something done.</p>
        <div class="shed-hero__actions">
          <a class="hero-button hero-button--primary" href="/tools">Explore Tools <span>→</span></a>
          <a class="hero-button" href="/blog">Read the Blog <span>→</span></a>
        </div>
      </div>
      <div class="shed-hero__tagline">BUILD <b>•</b> AUTOMATE <b>•</b> GROW</div>
    </section>

    {latestPosts.length > 0 && (
      <section class="home-section home-section--latest" aria-labelledby="latest-heading">
        <div class="wrapper">
          <div class="section-heading">
            <div>
              <span class="eyebrow">From the bench</span>
              <h2 id="latest-heading">Latest</h2>
            </div>
            <a href="/blog">View all →</a>
          </div>
          <div class="blog-index__grid">
            {latestPosts.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</BaseLayout>
