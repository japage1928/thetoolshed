---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { getPublishedPosts, getPrompts } from '../lib/supabase';
import { getDirectoryCategories } from '../lib/tool-directory';
import { COMPARISONS } from '../data/comparisons';
import { TASKS } from '../data/tasks';
import { SITE_DESCRIPTION, SITE_VALUE_PROP, slugifyCategory } from '../lib/site';

const prompts = await getPrompts();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
const featuredPrompts = prompts.filter((item) => item.featured).slice(0, 3);
const categories = (await getDirectoryCategories()).slice(0, 8);
const starterTasks = TASKS.slice(0, 8);
const homeTitle = 'Find the right AI tool for the job';
---
<BaseLayout title={homeTitle} description={SITE_DESCRIPTION} path="/">
<div class="home-page">
<section class="shed-hero" aria-labelledby="hero-title">
  <div class="shed-hero__wall" aria-hidden="true"></div>
  <div class="shed-hero__workbench" aria-hidden="true"></div>
  <div class="shed-hero__tools" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
  <div class="shed-hero__circuits" aria-hidden="true"></div>
  <div class="shed-hero__laptop" aria-hidden="true"><div class="shed-hero__screen"><span></span><span></span><span></span><span></span><span></span></div></div>
  <div class="shed-hero__lamp" aria-hidden="true"></div>
  <div class="shed-hero__copy">
    <span class="shed-hero__eyebrow">AI TOOLS FOR REAL WORK</span>
    <h1 id="hero-title"><span class="shed-hero__the">THE</span><span class="shed-hero__tool">TOOL</span><span class="shed-hero__shed">SHED</span></h1>
    <p>{SITE_DESCRIPTION}</p>
    <p class="shed-hero__value">{SITE_VALUE_PROP}</p>
    <div class="shed-hero__actions">
      <a class="hero-button hero-button--primary" href="/tools">Find the right AI tool <span>→</span></a>
      <a class="hero-button" href="/compare">Compare AI tools</a>
      <a class="hero-button" href="/tasks">Start with the job</a>
    </div>
    <p class="shed-hero__path" aria-label="How the shed is organized">Discover → Compare → Use → Build → Scale</p>
  </div>
</section>

<section class="home-section" aria-labelledby="path-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div>
        <span class="eyebrow">How this workshop works</span>
        <h2 id="path-heading">Job first. Tool second. Cost in plain view.</h2>
      </div>
    </div>
    <div class="path-grid">
      <a class="path-card" href="/tasks"><span class="eyebrow">Discover</span><strong>Start with the job</strong><p>Name the task. We point you at tools and compares that fit it.</p></a>
      <a class="path-card" href="/compare"><span class="eyebrow">Compare</span><strong>See the real differences</strong><p>Who should pick which — without invented scores.</p></a>
      <a class="path-card" href="/prompts"><span class="eyebrow">Use</span><strong>Put it to work</strong><p>Prompts and loops for the tool you actually chose.</p></a>
      <a class="path-card" href="/how-to"><span class="eyebrow">Build</span><strong>Make the workflow stick</strong><p>Guides for n8n, APIs, and jobs that have a kill switch.</p></a>
      <a class="path-card" href="/how-to/stop-wasting-money-on-ai-apis"><span class="eyebrow">Scale</span><strong>Watch the meter</strong><p>Cost caveats and vendor links — not a second product pitch.</p></a>
    </div>
  </div>
</section>

<section class="home-section home-section--resources" aria-labelledby="tasks-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Start with the job</span>
        <h2 id="tasks-heading">What are you trying to get done?</h2>
      </div>
      <a href="/tasks">All tasks →</a>
    </div>
    <div class="task-chip-row">
      {starterTasks.map((task) => <a class="task-chip" href={task.href}>{task.label}</a>)}
    </div>
  </div>
</section>

<section class="home-section" aria-labelledby="compare-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Popular comparisons</span>
        <h2 id="compare-heading">Pick on the job, not the hype</h2>
      </div>
      <a href="/compare">All compares →</a>
    </div>
    <div class="resource-grid resource-grid--three">
      {COMPARISONS.map((item) => (
        <article class="resource-panel">
          <span class="eyebrow">{item.eyebrow}</span>
          <h3>{item.title}</h3>
          <p>{item.job}</p>
          <a class="resource-panel__cta" href={`/compare/${item.slug}`}>Read the comparison →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="home-section home-section--resources" aria-labelledby="directory-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Directory by use case</span>
        <h2 id="directory-heading">Browse the bench by what the tool does</h2>
      </div>
      <a href="/tools">Full directory →</a>
    </div>
    <div class="category-chip-row">
      {categories.map((category) => <a class="task-chip" href={`/tools/category/${slugifyCategory(category)}`}>{category}</a>)}
    </div>
  </div>
</section>

<section class="home-section" aria-labelledby="use-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Use / Build</span>
        <h2 id="use-heading">Prompts and workflows that survived contact</h2>
      </div>
      <a href="/prompts">Browse prompts →</a>
    </div>
    <div class="resource-grid">
      <article class="resource-panel">
        <span class="eyebrow">PROMPTS</span>
        <h3>Ready-to-use prompts and loops</h3>
        <p>Practical starting points for the tool you picked — not a prompt marketplace dump.</p>
        {featuredPrompts.length > 0 && <ul>{featuredPrompts.map((item) => <li><a href={`/prompts/${item.slug}`}>{item.name}</a></li>)}</ul>}
        <a class="resource-panel__cta" href="/prompts">Open the prompt bench →</a>
      </article>
      <article class="resource-panel">
        <span class="eyebrow">HOW-TO</span>
        <h3>Guides for jobs that can get expensive</h3>
        <p>n8n, APIs, and other workflows written so you can stop the meter.</p>
        <ul>
          <li><a href="/how-to/stop-wasting-money-on-ai-apis">Stop wasting money on AI APIs</a></li>
          <li><a href="/how-to/manage-n8n-with-chatgpt">Manage n8n with ChatGPT</a></li>
          <li><a href="/how-to">All how-to guides</a></li>
        </ul>
        <a class="resource-panel__cta" href="/how-to">Read the how-tos →</a>
      </article>
    </div>
  </div>
</section>

{latestPosts.length > 0 && <section class="home-section home-section--latest" aria-labelledby="latest-heading">
  <div class="wrapper">
    <div class="section-heading">
      <div><span class="eyebrow">From the bench</span><h2 id="latest-heading">Latest from the blog</h2></div>
      <a href="/blog">View all →</a>
    </div>
    <div class="blog-index__grid">{latestPosts.map((post) => <article class="db-post-card"><span class="eyebrow">{post.category || 'Article'}</span><h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3><p>{post.excerpt}</p><a class="db-post-card__link" href={`/blog/${post.slug}`}>Read article →</a></article>)}</div>
  </div>
</section>}

<section class="home-section"><div class="wrapper"><EmailCapture source="homepage" heading="Get useful AI tool notes, not a hype digest." description="Practical finds, cost caveats, and prompts when they are worth a slot in your inbox. No daily assault." buttonLabel="Join the list" /></div></section>

<section class="home-section home-section--x" aria-labelledby="x-heading">
  <div class="wrapper x-callout">
    <div>
      <span class="eyebrow">Follow the builder</span>
      <h2 id="x-heading">More of what actually ships, on X</h2>
      <p>Notes on tools, costs, and workflows. No hype-factory nonsense.</p>
    </div>
    <a class="hero-button hero-button--primary" href="https://x.com/john_page1990" target="_blank" rel="me noopener noreferrer">Follow @john_page1990 on X <span>→</span></a>
  </div>
</section>
</div>
</BaseLayout>
<style>
.shed-hero__value{max-width:38rem;margin:.7rem 0 0;color:#d7d1c8;font-size:1rem;line-height:1.6}
.shed-hero__path{margin:1.2rem 0 0;color:#9a948b;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700}
.path-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.75rem}
.path-card{display:grid;gap:.4rem;padding:1.1rem;border:1px solid var(--color-border);border-radius:.7rem;background:#0f100f;color:inherit;text-decoration:none}
.path-card strong{color:#f1eee7}
.path-card p{margin:0;color:#aaa69e;font-size:.88rem;line-height:1.5}
.task-chip-row,.category-chip-row{display:flex;flex-wrap:wrap;gap:.6rem}
.task-chip{padding:.55rem .85rem;border:1px solid var(--color-border);border-radius:999px;color:#e9e4d8;text-decoration:none;font-size:.85rem;font-weight:650;background:#10110f}
.task-chip:hover{border-color:var(--shed-blue);color:#fff}
.resource-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
.resource-grid--three{grid-template-columns:repeat(3,minmax(0,1fr))}
.resource-panel{padding:1.4rem;border:1px solid var(--color-border);border-radius:.7rem;background:#0f100f}
.resource-panel h3{margin:.5rem 0}
.resource-panel p{color:#aaa69e;line-height:1.55}
.resource-panel ul{margin:1rem 0;padding-left:1.1rem}
.resource-panel li{margin:.45rem 0}
.resource-panel a{color:#f1eee7}
.resource-panel__cta{display:inline-block;margin-top:.5rem;font-weight:700;text-decoration:none}
.x-callout{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem;border:1px solid var(--color-border);border-radius:.7rem;background:#0f100f}
.x-callout p{color:#aaa69e;max-width:42rem}
.db-post-card{padding:1.25rem;border:1px solid var(--color-border);border-radius:.6rem;background:#0f100f}
.db-post-card h3{margin:.5rem 0}
.db-post-card h3 a{color:#f1eee7;text-decoration:none}
.db-post-card p{color:#aaa69e;line-height:1.55}
.db-post-card__link{font-size:.8rem;font-weight:700;text-decoration:none}
.db-post-card__link:hover{text-decoration:underline}
@media(max-width:980px){.path-grid,.resource-grid--three{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.resource-grid,.path-grid,.resource-grid--three{grid-template-columns:1fr}.x-callout{align-items:flex-start;flex-direction:column}}
</style>
