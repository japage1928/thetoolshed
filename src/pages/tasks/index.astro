---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { TASKS } from '../../data/tasks';

const description = 'Start with the job: write content, research a topic, build an app, automate a workflow, or cut AI API cost. Each task points to tools and comparisons.';
---
<BaseLayout title="Start with the job" description={description} path="/tasks">
  <div class="wrapper tasks-page">
    <header class="tasks-hero">
      <span class="eyebrow">DISCOVER · AI TOOLS FOR REAL WORK</span>
      <h1 class="page-title">Start with the job</h1>
      <p>Walk in with a task. These chips point at tools and comparisons — not a product pitch. Confirm cost on the vendor site before you subscribe.</p>
    </header>
    <section class="task-grid" aria-label="Starter jobs">
      {TASKS.map((task) => (
        <article class="task-card" id={task.slug}>
          <h2><a href={task.href}>{task.label}</a></h2>
          <p>{task.job}</p>
          <ul>
            {task.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
<style>
.tasks-page{padding-top:3rem;padding-bottom:5rem}
.tasks-hero{max-width:50rem;margin-bottom:2.25rem}
.tasks-hero p{color:var(--color-text-muted);font-size:1.05rem;line-height:1.7}
.task-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.task-card{padding:1.25rem;border:1px solid var(--color-border);border-radius:.7rem;background:#0f100f}
.task-card h2{margin:.15rem 0 .5rem;font-size:1.15rem}
.task-card h2 a{color:#f1eee7;text-decoration:none}
.task-card p{color:#aaa69e;line-height:1.55;min-height:3.2rem}
.task-card ul{margin:1rem 0 0;padding-left:1.1rem}
.task-card li{margin:.35rem 0}
.task-card li a{color:#d8d3cb}
@media(max-width:980px){.task-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.task-grid{grid-template-columns:1fr}}
</style>
