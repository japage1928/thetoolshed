---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Admin Dashboard | The Tool Shed" description="Private Tool Shed administration." path="/admin">
  <main class="admin-shell">
    <aside class="sidebar">
      <div class="brand"><strong>THE TOOL SHED</strong><span>ADMIN</span></div>
      <nav aria-label="Admin navigation">
        <a class="active" href="/admin">Dashboard</a>
        <a href="/admin/tools">AI Tools</a>
        <a href="/admin/workflows">Workflows</a>
        <a href="/admin/blog">Blog</a>
        <a href="/admin/analytics">Analytics</a>
        <a href="/admin/settings">Settings</a>
      </nav>
      <button id="sign-out" type="button">Sign out</button>
    </aside>
    <section class="content">
      <header><div><span class="eyebrow">PRIVATE CONTROL CENTER</span><h1>Dashboard</h1></div><a class="view-site" href="/">View site →</a></header>
      <div class="cards">
        <article><span>AI TOOLS</span><strong id="tool-count">—</strong><small>Database records</small></article>
        <article><span>WORKFLOWS</span><strong id="workflow-count">—</strong><small>Published + drafts</small></article>
        <article><span>BLOG POSTS</span><strong id="post-count">—</strong><small>Database records</small></article>
        <article><span>ANALYTICS</span><strong>Connected</strong><small>GA4 event tracking installed</small></article>
      </div>
      <div class="panels"><article><h2>Content management</h2><p>Manage the Tool Shed catalog and publishing content from one private workspace.</p><div class="quick-links"><a href="/admin/tools">Manage AI Tools <span>→</span></a><a href="/admin/workflows">Manage Workflows <span>→</span></a><a href="/admin/blog">Manage Blog <span>→</span></a></div></article><article><h2>Analytics</h2><p>Live reporting will appear here after the server-side GA4 reporting connection is configured.</p><a class="outline" href="/admin/analytics">Open Analytics →</a></article></div>
      <p id="auth-error" class="auth-error" hidden></p>
    </section>
  </main>
</BaseLayout>
<script>
  import { createClient } from '@supabase/supabase-js';
  const url = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.SUPABASE_PUBLISHABLE_KEY;
  const supabase = createClient(url, key);
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) window.location.href = '/admin/login';
  const [{ count: toolCount }, { count: postCount }] = await Promise.all([
    supabase.from('ai_tools').select('*', { count: 'exact', head: true }),
    supabase.from('blog_posts').select('*', { count: 'exact', head: true })
  ]);
  const workflowResult = await supabase.from('workflows').select('*', { count: 'exact', head: true });
  document.querySelector('#tool-count')!.textContent = String(toolCount ?? 0);
  document.querySelector('#post-count')!.textContent = String(postCount ?? 0);
  document.querySelector('#workflow-count')!.textContent = String(workflowResult.count ?? 0);
  document.querySelector('#sign-out')?.addEventListener('click', async () => { await supabase.auth.signOut(); window.location.href = '/admin/login'; });
</script>
<style>
.admin-shell{min-height:78vh;display:grid;grid-template-columns:220px 1fr}.sidebar{border-right:1px solid var(--color-border);padding:1.5rem;display:flex;flex-direction:column;gap:2rem;background:#0b0c0b}.brand{display:grid;gap:.25rem}.brand strong{font-size:.9rem;letter-spacing:.08em}.brand span{font-size:.62rem;color:#77736d;letter-spacing:.15em}.sidebar nav{display:grid;gap:.25rem}.sidebar nav a{padding:.7rem .75rem;border-radius:.45rem;color:#96928b;text-decoration:none;font-size:.82rem}.sidebar nav a:hover,.sidebar nav a.active{background:#171815;color:#f1eee7}.sidebar button{margin-top:auto;border:1px solid var(--color-border);background:transparent;color:#aaa69e;border-radius:.45rem;padding:.65rem;cursor:pointer}.content{padding:2.5rem;max-width:1200px;width:100%;box-sizing:border-box}.content header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:2rem}.content h1{margin:.35rem 0}.view-site,.outline{color:#aaa69e;text-decoration:none;font-size:.8rem}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.cards article,.panels article{border:1px solid var(--color-border);border-radius:.7rem;background:#10110f;padding:1.2rem}.cards span{display:block;color:#77736d;font-size:.65rem;letter-spacing:.1em}.cards strong{display:block;font-size:1.65rem;margin:.35rem 0}.cards small{color:#77736d}.panels{display:grid;grid-template-columns:1.4fr 1fr;gap:1rem;margin-top:1rem}.panels h2{font-size:1rem}.panels p{color:#8f8b84;font-size:.85rem;line-height:1.6}.quick-links{display:grid;gap:.5rem;margin-top:1.2rem}.quick-links a{display:flex;justify-content:space-between;padding:.75rem;border:1px solid var(--color-border);border-radius:.45rem;color:#e1ddd5;text-decoration:none;font-size:.82rem}.quick-links a:hover{border-color:#555}.auth-error{color:#e58b8b}@media(max-width:850px){.admin-shell{grid-template-columns:1fr}.sidebar{border-right:0;border-bottom:1px solid var(--color-border)}.sidebar nav{display:flex;overflow:auto}.sidebar button{margin-top:0}.cards{grid-template-columns:repeat(2,1fr)}.panels{grid-template-columns:1fr}}@media(max-width:500px){.content{padding:1.25rem}.cards{grid-template-columns:1fr}.content header{align-items:center}}
</style>
