---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Settings | Admin | The Tool Shed" description="Private Tool Shed settings." path="/admin/settings">
  <main class="admin-page">
    <a class="back" href="/admin">← Dashboard</a>
    <header><span class="eyebrow">ADMIN</span><h1>Settings</h1><p>Core site and integration settings.</p></header>
    <section class="grid">
      <article><span>SITE</span><h2>The Tool Shed</h2><p>Primary domain</p><strong>thetoolshed.work</strong></article>
      <article><span>DATABASE</span><h2>Supabase</h2><p>Content source</p><strong>Connected through the existing site data layer</strong></article>
      <article><span>ANALYTICS</span><h2>Google Analytics 4</h2><p>Measurement ID</p><strong>G-3CCH0VWGCF</strong></article>
      <article><span>COMMERCE</span><h2>Payhip</h2><p>Workflow checkout</p><strong>Enabled for products with a Payhip product ID</strong></article>
    </section>
  </main>
</BaseLayout>
<style>.admin-page{max-width:1000px;margin:auto;padding:2.5rem 1.25rem 5rem}.back{color:#aaa69e;text-decoration:none;font-size:.8rem}.admin-page header{margin:2rem 0}.admin-page h1{margin:.3rem 0}.admin-page header p{color:#8f8b84}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.grid article{border:1px solid var(--color-border);border-radius:.7rem;background:#10110f;padding:1.3rem}.grid span{font-size:.62rem;color:#77736d;letter-spacing:.1em}.grid h2{font-size:1rem;margin:.45rem 0}.grid p{color:#8f8b84;font-size:.8rem}.grid strong{font-size:.82rem;color:#e1ddd5}@media(max-width:650px){.grid{grid-template-columns:1fr}}</style>
