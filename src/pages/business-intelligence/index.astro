---
import BusinessIntelligenceLayout from '../../layouts/BusinessIntelligenceLayout.astro';
import ProductCTA from '../../components/business-intelligence/ProductCTA.astro';
import CountyProductCard from '../../components/business-intelligence/CountyProductCard.astro';
import MethodologySection from '../../components/business-intelligence/MethodologySection.astro';
import InsightCard from '../../components/business-intelligence/InsightCard.astro';
import { insights, researchFields } from '../../lib/business-intelligence';

export const prerender = true;

const title = 'Florida Local Business Intelligence for B2B Prospecting';
const description = 'Verified local-business intelligence for agencies and B2B service providers. Explore 200+ researched Polk County, Florida businesses for $29.';
const audiences = [
  ['Web Design', 'Conversion paths, mobile usability, forms, booking, and site structure.'],
  ['SEO / Local SEO', 'City targeting, service-area pages, reviews, NAP, and observable local signals.'],
  ['AI Automation', 'Intake, booking, chat, handoffs, and visible workflow gaps.'],
  ['Marketing', 'Advertising, reviews, positioning, and demand-capture signals.'],
  ['Managed IT', 'Scale, locations, hiring, crews, and operational complexity.'],
  ['Staffing', 'Hiring activity, growth indicators, and business expansion signals.'],
  ['Payments / POS', 'Financing, high-ticket work, locations, and transaction context.'],
  ['CRM / RevOps', 'Lead intake, follow-up paths, qualification depth, and handoffs.'],
];
---

<BusinessIntelligenceLayout {title} {description} path="/business-intelligence">
  <section class="bi-hero">
    <div class="bi-shell bi-hero__inner">
      <div class="bi-hero__copy">
        <span class="bi-kicker">The Tool Shed Business Intelligence</span>
        <h1>Local Business Opportunities, Already Researched.</h1>
        <p>Verified local-business intelligence for agencies and B2B service providers that want to spend less time researching prospects and more time pursuing worthwhile opportunities.</p>
        <ProductCTA label="Explore Polk County" primaryHref="/business-intelligence/polk-county" secondaryHref="/business-intelligence/sample" secondaryLabel="View Free Sample" />
        <p class="bi-note">Built from live public-source research rather than simple directory scraping.</p>
      </div>
      <aside class="bi-hero__proof"><strong>Research first. Outreach second.</strong><p>Business identity, public-source verification, digital signals, opportunity gaps, contact approach, and the evidence behind the record.</p></aside>
    </div>
  </section>

  <section class="bi-section" aria-labelledby="audience-title">
    <div class="bi-shell">
      <div class="bi-section-heading"><div><span class="bi-kicker">Built for B2B prospecting</span><h2 id="audience-title">One dataset. Different useful signals.</h2><p>Each buyer can filter the same research through a different business-development lens. A visible signal is a reason to investigate—not a guarantee of need, interest, or a sale.</p></div></div>
      <div class="bi-audience-grid">{audiences.map(([name, copy], index) => <article class="bi-audience-card"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{name}</h3><p>{copy}</p></article>)}</div>
    </div>
  </section>

  <section class="bi-section bi-section--tint" aria-labelledby="fields-title">
    <div class="bi-shell">
      <div class="bi-section-heading"><div><span class="bi-kicker">What makes the data different</span><h2 id="fields-title">More context than a name and phone number.</h2><p>The research is designed to help a buyer understand what may be worth pursuing and how to begin that conversation responsibly.</p></div></div>
      <div class="bi-field-grid">{researchFields.map((field) => <span>{field}</span>)}</div>
      <p class="bi-caveat"><strong>Coverage varies by record.</strong> Not every field is publicly discoverable for every business. Unavailable or unverifiable information is marked explicitly rather than filled with assumptions.</p>
    </div>
  </section>

  <section class="bi-section" aria-labelledby="coverage-title"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Currently available</span><h2 id="coverage-title">Polk County, Florida</h2><p>One live product. No fake “coming soon” catalog pretending to be inventory.</p></div></div><CountyProductCard /></div></section>
  <MethodologySection />
  <section class="bi-section" aria-labelledby="insights-title"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Prospecting insights</span><h2 id="insights-title">Learn the signals before buying the research.</h2></div><a class="bi-text-link" href="/business-intelligence/insights">View all insights →</a></div><div class="bi-insight-grid">{insights.map((item) => <InsightCard {...item} />)}</div></div></section>
  <section class="bi-section bi-section--tint"><div class="bi-shell"><div class="bi-trust"><h2>What “verified” means</h2><p>Verified means a record received public-source research against available sources. It does not mean every possible field was discoverable, the business wants to be contacted, the company will purchase services, or every signal will remain unchanged indefinitely.</p><a class="bi-text-link" href="/business-intelligence/methodology">See how the research is built →</a></div></div></section>
  <section class="bi-final-cta"><div class="bi-shell"><span class="bi-kicker">Spend less time researching</span><h2>Spend more time talking to the right ones.</h2><p>Inspect the real sample first. If the research depth saves you time, the full Polk County dataset is $29.</p><ProductCTA label="Get Polk County — $29" secondaryHref="/business-intelligence/sample" secondaryLabel="View Free Sample" /></div></section>
</BusinessIntelligenceLayout>
