---
import BusinessIntelligenceLayout from '../../layouts/BusinessIntelligenceLayout.astro';
import ProductCTA from '../../components/business-intelligence/ProductCTA.astro';
import SampleDataTable from '../../components/business-intelligence/SampleDataTable.astro';
import MethodologySection from '../../components/business-intelligence/MethodologySection.astro';
import { sampleBusinesses } from '../../lib/business-intelligence';

export const prerender = true;

const title = 'Polk County Business Intelligence Sample Packet';
const description = 'A $29 paid evaluation sample packet showing public-source research depth, scoring, methodology, and Polk County as the market example. PDF only; not the complete county database and not a CSV.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Product', name: 'Polk County Business Intelligence', description, brand: { '@type': 'Brand', name: 'The Tool Shed Business Intelligence' }, offers: { '@type': 'Offer', price: '29.00', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: 'https://opportunityatlas.gumroad.com/l/ojthrs?wanted=true' } };
---

<BusinessIntelligenceLayout {title} {description} path="/business-intelligence/polk-county" {jsonLd}>
  <section class="bi-product-hero"><div class="bi-shell"><span class="bi-kicker">The Tool Shed Business Intelligence</span><h1>Polk County Business Intelligence</h1><p>A short paid evaluation packet showing the research structure, scoring, methodology, and Polk County example. It is not the complete county database and does not include a CSV.</p><p class="bi-price"><strong>$29</strong><span>one-time purchase</span></p><ProductCTA label="Get the $29 Sample Packet" secondaryHref="/business-intelligence/sample" secondaryLabel="View Real Sample Data" /><p class="bi-note">Checkout and delivery are handled through Gumroad. No Tool Shed account required.</p></div></section>

  <section class="bi-section" aria-labelledby="problem-title"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">The research bottleneck</span><h2 id="problem-title">Prospecting Shouldn’t Start With Hours of Research.</h2><p>A raw directory entry creates work. It does not remove it.</p></div></div><ol class="bi-process"><li>Find the business and official website</li><li>Check identity, licensing, and decision-maker signals</li><li>Inspect reviews, digital presence, and conversion paths</li><li>Identify credible opportunity gaps</li><li>Choose a contact approach and relevant opener</li></ol><p class="bi-caveat">The Polk County pack performs much of this first-pass research before outreach begins. It does not replace buyer judgment or due diligence.</p></div></section>

  <section class="bi-section bi-section--tint" aria-labelledby="receive-title"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">What you receive</span><h2 id="receive-title">A short evaluation packet. No proprietary viewer.</h2></div></div><div class="bi-deliverables"><article class="bi-deliverable"><h3>Paid evaluation PDF</h3><p>A short packet built to show research depth, scoring, methodology, and Polk County as the example.</p></article><article class="bi-deliverable"><h3>What it does not include</h3><p>The complete 200-record Polk research database and a CSV are not included in the $29 packet.</p></article></div></div></section>

  <section class="bi-section" aria-labelledby="sample-title"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Real sample data</span><h2 id="sample-title">See the research structure before buying.</h2><p>These five genuine records are free on-site examples. The underlying research database contains 200 Polk records; the complete database is not included in the $29 packet.</p></div><a class="bi-text-link" href="/business-intelligence/sample">Open the full sample page →</a></div><SampleDataTable records={sampleBusinesses} /></div></section>
  <MethodologySection />
  <section class="bi-final-cta"><div class="bi-shell"><span class="bi-kicker">Polk County, Florida</span><h2>Evaluate the research for $29.</h2><p>The one-time purchase is a short PDF sample packet. Gumroad handles checkout and instant digital delivery.</p><ProductCTA label="Get the $29 Sample Packet" secondaryHref="/business-intelligence/methodology" secondaryLabel="Review Methodology" /></div></section>
  <section class="bi-section bi-section--tint"><div class="bi-shell"><p class="bi-disclaimer"><strong>Research disclaimer:</strong> Information is compiled from publicly available sources and provided for business research purposes. Business details and online signals can change. Buyers are responsible for verifying information before relying on it or conducting outreach. Purchase does not guarantee leads, responses, clients, revenue, or business outcomes.</p></div></section>
</BusinessIntelligenceLayout>
