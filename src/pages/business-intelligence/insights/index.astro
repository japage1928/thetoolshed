---
import BusinessIntelligenceLayout from '../../../layouts/BusinessIntelligenceLayout.astro';
import InsightCard from '../../../components/business-intelligence/InsightCard.astro';
import ProductCTA from '../../../components/business-intelligence/ProductCTA.astro';
import { insights } from '../../../lib/business-intelligence';
export const prerender = true;
const title = 'Local Business Prospecting Insights';
const description = 'Practical guides for local business prospecting, web design opportunities, local SEO research, and building better B2B prospect lists.';
---
<BusinessIntelligenceLayout {title} {description} path="/business-intelligence/insights">
  <section class="bi-insights-hero"><div class="bi-shell"><span class="bi-kicker">Business Intelligence Insights</span><h1>Research Better Local Opportunities.</h1><p>Practical field guides for agencies and B2B service providers. Learn how to evaluate signals, qualify opportunities, and prepare relevant outreach without treating every business like a warm lead.</p></div></section>
  <section class="bi-section"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Launch library</span><h2>Three ways to improve first-pass prospect research.</h2></div></div><div class="bi-insight-grid">{insights.map((item) => <InsightCard {...item} />)}</div></div></section>
  <section class="bi-section bi-section--tint"><div class="bi-shell bi-two-column"><div><span class="bi-kicker">Prefer pre-researched data?</span><h2>Polk County is already on the bench.</h2></div><div><p>Inspect real sample records or get the complete 200+ business PDF and CSV dataset for $29.</p><ProductCTA label="Get Polk County — $29" secondaryHref="/business-intelligence/sample" secondaryLabel="View Free Sample" /></div></div></section>
</BusinessIntelligenceLayout>
