---
import BusinessIntelligenceLayout from '../../layouts/BusinessIntelligenceLayout.astro';
import ProductCTA from '../../components/business-intelligence/ProductCTA.astro';
import SampleDataTable from '../../components/business-intelligence/SampleDataTable.astro';
import { sampleBusinesses } from '../../lib/business-intelligence';
export const prerender = true;
const title = 'Free Polk County Business Intelligence Sample';
const description = 'Inspect five real Polk County business intelligence records before buying the full 200+ business PDF and CSV dataset for $29.';
---
<BusinessIntelligenceLayout {title} {description} path="/business-intelligence/sample">
  <section class="bi-insights-hero"><div class="bi-shell"><span class="bi-kicker">Free live sample</span><h1>See the Research Before You Buy.</h1><p>This sample uses the same research structure as the full Polk County product. It shows genuine records, including unknowns and “do not pitch yet” findings—because credible research occasionally refuses to flatter the seller.</p><ProductCTA label="Unlock 200+ Polk County Businesses — $29" secondaryHref="/business-intelligence/methodology" secondaryLabel="Review Methodology" /></div></section>
  <section class="bi-section"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Five genuine records</span><h2>Enough to inspect. Not enough to replace the product.</h2><p>Expand each record to review decision-maker context, digital signals, primary gaps, suggested openers, and verification sources.</p></div></div><SampleDataTable records={sampleBusinesses} /><div class="bi-download-status" role="status">Downloadable sample coming soon. The live website sample remains available above.</div></div></section>
  <section class="bi-section bi-section--tint"><div class="bi-shell bi-two-column"><div><span class="bi-kicker">Read the record correctly</span><h2>A signal is a research lead—not a verdict.</h2></div><div><p>An unavailable field is not negative proof. A weak website signal does not mean the business wants a redesign. The dataset helps buyers prioritize further research and craft a relevant approach.</p><a class="bi-text-link" href="/business-intelligence/methodology">How verification works →</a></div></div></section>
  <section class="bi-final-cta"><div class="bi-shell"><span class="bi-kicker">Full Polk County dataset</span><h2>Unlock 200+ Polk County businesses.</h2><p>Customer-ready PDF plus sortable CSV. $29 one-time, delivered through Gumroad.</p><ProductCTA label="Unlock Full Dataset — $29" secondaryHref="/business-intelligence/polk-county" secondaryLabel="View Product Details" /></div></section>
</BusinessIntelligenceLayout>
