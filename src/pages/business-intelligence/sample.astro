---
import BusinessIntelligenceLayout from '../../layouts/BusinessIntelligenceLayout.astro';
import ProductCTA from '../../components/business-intelligence/ProductCTA.astro';
import SampleDataTable from '../../components/business-intelligence/SampleDataTable.astro';
import { sampleBusinesses } from '../../lib/business-intelligence';
export const prerender = true;
const title = 'Free Polk County Research Sample';
const description = 'Inspect five real Polk County business intelligence records before considering the $29 paid evaluation sample packet. The packet is a short PDF and does not include the complete 200-record research database or a CSV.';
---
<BusinessIntelligenceLayout {title} {description} path="/business-intelligence/sample">
  <section class="bi-insights-hero"><div class="bi-shell"><span class="bi-kicker">Free live sample</span><h1>See the Research Before You Buy.</h1><p>This sample uses the same research structure as the full Polk County product. It shows genuine records, including unknowns and “do not pitch yet” findings—because credible research occasionally refuses to flatter the seller.</p><ProductCTA label="Get the $29 Sample Packet" secondaryHref="/business-intelligence/methodology" secondaryLabel="Review Methodology" /></div></section>
  <section class="bi-section"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Five genuine records</span><h2>Enough to inspect. Not enough to replace the product.</h2><p>Expand each record to review decision-maker context, digital signals, primary gaps, suggested openers, and verification sources.</p></div></div><SampleDataTable records={sampleBusinesses} /></div></section>
  <section class="bi-section bi-section--tint"><div class="bi-shell bi-two-column"><div><span class="bi-kicker">Read the record correctly</span><h2>A signal is a research lead—not a verdict.</h2></div><div><p>An unavailable field is not negative proof. A weak website signal does not mean the business wants a redesign. The dataset helps buyers prioritize further research and craft a relevant approach.</p><a class="bi-text-link" href="/business-intelligence/methodology">How verification works →</a></div></div></section>
  <section class="bi-final-cta"><div class="bi-shell"><span class="bi-kicker">Paid evaluation sample</span><h2>See what the $29 packet actually is.</h2><p>A short PDF showing research depth, scoring, methodology, and Polk County as the example. It is not the complete 200-record county database and not a CSV. Delivered instantly through Gumroad.</p><ProductCTA label="Get the $29 Sample Packet" secondaryHref="/business-intelligence/polk-county" secondaryLabel="View Product Details" /></div></section>
</BusinessIntelligenceLayout>
