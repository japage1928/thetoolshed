---
import BusinessIntelligenceLayout from '../../layouts/BusinessIntelligenceLayout.astro';
import ProductCTA from '../../components/business-intelligence/ProductCTA.astro';
export const prerender = true;
const title = 'Business Intelligence Research Methodology';
const description = 'Learn how The Tool Shed researches and verifies local-business intelligence using public sources, honest unknown labels, and time-sensitive verification.';
---
<BusinessIntelligenceLayout {title} {description} path="/business-intelligence/methodology">
  <section class="bi-insights-hero"><div class="bi-shell"><span class="bi-kicker">Research methodology</span><h1>How The Research Is Built</h1><p>Every record begins with public-source research. The objective is useful context with traceable evidence—not a database that looks complete because someone filled every blank with fiction.</p></div></section>
  <section class="bi-section"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Source hierarchy</span><h2>Match the source to the claim.</h2><p>Different sources can support different facts. A directory can help corroborate a listing, but it is not automatically treated as the company’s official website.</p></div></div><ul class="bi-source-list"><li>Official company websites</li><li>Florida Sunbiz</li><li>DBPR and professional licensing sources</li><li>Public professional boards</li><li>Public chamber and business-organization pages</li><li>Clearly matched public business profiles</li><li>Publicly observable website and search signals</li><li>Directories used as corroboration where appropriate</li></ul></div></section>
  <section class="bi-section bi-section--tint"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Four honest outcomes</span><h2>Unknowns are labeled, not repaired with imagination.</h2></div></div><dl class="bi-definition-list"><div><dt>Not found after search</dt><dd>The field was researched using available sources, but matching information was not located.</dd></div><div><dt>Unable to verify</dt><dd>Possible information may exist, but the available evidence was not strong enough to state it as fact.</dd></div><div><dt>Not applicable</dt><dd>The field does not reasonably apply to the business or business type.</dd></div><div><dt>Not attempted</dt><dd>The field was outside the completed research pass, required a specialized test, or could not be accessed efficiently.</dd></div></dl></div></section>
  <section class="bi-section"><div class="bi-shell"><div class="bi-section-heading"><div><span class="bi-kicker">Research principles</span><h2>What the process refuses to do.</h2></div></div><div class="bi-method-grid"><article class="bi-method-card"><span class="bi-kicker">Public only</span><h3>No scraped private contact information</h3><p>The dataset uses publicly presented business information and observable commercial signals.</p></article><article class="bi-method-card"><span class="bi-kicker">Evidence first</span><h3>No invented facts</h3><p>A clean-looking spreadsheet is not worth much if its certainty was manufactured.</p></article><article class="bi-method-card"><span class="bi-kicker">No false negatives</span><h3>Missing does not mean false</h3><p>When a field is not found, the record describes the research result rather than declaring the underlying fact untrue.</p></article><article class="bi-method-card"><span class="bi-kicker">Time aware</span><h3>Conditions change</h3><p>Reviews, staff, sites, licensing, and business operations can change after a record is researched.</p></article></div></div></section>
  <section class="bi-section bi-section--tint"><div class="bi-shell"><div class="bi-trust"><h2>What “verified” means</h2><p>Verified means the record received public-source research against available sources.</p><p>It does <strong>not</strong> mean every possible field was discoverable, the business wants to be contacted, the company will purchase services, or every signal will remain unchanged indefinitely.</p><p>Buyers should verify time-sensitive information before relying on it or beginning outreach.</p></div></div></section>
  <section class="bi-final-cta"><div class="bi-shell"><span class="bi-kicker">Inspect the evidence</span><h2>See the research structure in real records.</h2><p>Start with the sample. The full Polk County dataset is available only if the work earns your trust.</p><ProductCTA label="Get Polk County — $29" secondaryHref="/business-intelligence/sample" secondaryLabel="View Real Sample Data" /></div></section>
</BusinessIntelligenceLayout>
