---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { getPostBySlug, getPublishedPosts } from '../../lib/supabase';
import { SITE_NAME } from '../../lib/site';

const post = await getPostBySlug(Astro.params.slug ?? '');
if (!post) return Astro.redirect('/blog', 302);
const publishedDate = post.published_at ? new Date(post.published_at) : new Date(post.created_at);
const canonicalPath = `/blog/${post.slug}`;
const relatedPosts = (await getPublishedPosts()).filter((item) => item.slug !== post.slug && item.category === post.category).slice(0,3);
const jsonLd = {'@context':'https://schema.org','@type':'Article',headline:post.title,description:post.seo_description||post.excerpt,datePublished:publishedDate.toISOString(),dateModified:new Date(post.updated_at).toISOString(),author:{'@type':'Organization',name:'The Tool Shed'},publisher:{'@type':'Organization',name:SITE_NAME},mainEntityOfPage:{'@type':'WebPage','@id':new URL(canonicalPath,Astro.site).toString()},articleSection:post.category||undefined,keywords:post.tags.join(', ')};
---
<BaseLayout title={post.seo_title||post.title} description={post.seo_description||post.excerpt} path={canonicalPath} type="article" publishedDate={publishedDate} updatedDate={new Date(post.updated_at)} jsonLd={jsonLd}>
<article class="wrapper article-page"><div class="article-content"><a class="eyebrow" href={post.category?`/blog/category/${post.category.toLowerCase().replace(/[^a-z0-9]+/g,'-')}`:'/blog'}>{post.category||'Article'}</a><h1 class="page-title">{post.title}</h1><div class="meta-line"><span>By The Tool Shed</span><span>·</span><time datetime={publishedDate.toISOString()}>Published {publishedDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time></div>{post.featured_image_url&&<img class="article-featured-image" src={post.featured_image_url} alt="" width="1200" height="675" loading="eager"/>}<div class="db-content" set:html={post.content}></div><EmailCapture source={`blog-${post.slug}`} compact /></div>{relatedPosts.length>0&&<nav class="related" aria-labelledby="related-heading"><h2 id="related-heading">Read Next</h2><ul>{relatedPosts.map(item=><li><a href={`/blog/${item.slug}`}>{item.title}</a></li>)}</ul></nav>}</article>
</BaseLayout>
<style>
.article-page{padding-top:2rem;padding-bottom:4rem}.article-content{max-width:48rem;margin:0 auto}.article-content .page-title{margin-top:.55rem}.meta-line{display:flex;gap:.55rem;flex-wrap:wrap;color:#77736d;font-size:.78rem;margin:1rem 0 2rem}.article-featured-image{display:block;width:100%;height:auto;border-radius:.65rem;margin:1.5rem 0 2rem}.db-content{color:#c7c2ba;font-size:1.03rem;line-height:1.8}.db-content :global(h2){color:#f1eee7;margin:2rem 0 .7rem;font-size:1.45rem}.db-content :global(p){margin:0 0 1.15rem}.db-content :global(a){color:var(--shed-blue)}.db-content :global(ul),.db-content :global(ol){padding-left:1.4rem}.related{max-width:48rem;margin:3rem auto 0;padding-top:1.5rem;border-top:1px solid var(--color-border)}.related h2{font-size:1.1rem}.related ul{padding-left:1.1rem}.related a{color:#e9eef2;text-decoration:none}.related a:hover{color:var(--shed-blue)}
</style>
