---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SITE_NAME } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);
---

<BaseLayout
  title="Blog"
  description={`Articles from ${SITE_NAME}, published weekly.`}
  path="/blog"
>
  <div class="wrapper" style="padding-top: 2rem; padding-bottom: 3rem;">
    <h1 class="page-title">Blog</h1>
    {
      posts.length === 0 ? (
        <p class="empty-state">No articles published yet. Check back soon.</p>
      ) : (
        <div class="blog-index__grid">
          {posts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
