---
import BaseLayout from '../../layouts/BaseLayout.astro';
const next = Astro.url.searchParams.get('next') || '/app/video-studio';
---
<BaseLayout title="Sign in · Video Studio" description="Sign in to Video Studio" path="/video-studio/login" noindex>
  <main class="login-wrap">
    <section class="login-card">
      <div class="mark">V</div><h1>Video Studio</h1><p>Sign in to your workspace.</p>
      <form id="login-form"><label>Email<input name="email" type="email" autocomplete="email" required /></label><label>Password<input name="password" type="password" autocomplete="current-password" minlength="10" required /></label><button type="submit">Sign in</button><span id="status"></span></form>
      <div class="account-links"><a href={`/account?next=${encodeURIComponent(next)}`}>Create account</a><a href="/account/reset-password">Forgot password?</a></div>
      <a class="google" href={`/api/auth/google?next=${encodeURIComponent(next)}`}>Continue with Google</a>
    </section>
  </main>
</BaseLayout>
<script define:vars={{ next }}>
  const form=document.querySelector('#login-form'); const status=document.querySelector('#status');
  form?.addEventListener('submit',async(e)=>{e.preventDefault(); const fd=new FormData(form); status.textContent='Signing in…'; const r=await fetch('/api/auth/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:fd.get('email'),password:fd.get('password'),next})}); const d=await r.json(); if(!r.ok){status.textContent=d.error||'Unable to sign in.';return;} location.href=next;});
</script>
<style>:global(body){margin:0;background:#090b10;color:#eef2f8;font-family:Inter,system-ui,sans-serif}.login-wrap{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 50% 0,#1a2742,transparent 40%)}.login-card{width:min(420px,100%);box-sizing:border-box;background:#10141d;border:1px solid #273044;border-radius:18px;padding:34px}.mark{width:42px;height:42px;border-radius:11px;background:#fff;color:#090b10;display:grid;place-items:center;font-weight:900}.login-card h1{margin:20px 0 5px}.login-card p{color:#8f9aae;margin:0 0 24px}.login-card form{display:grid;gap:15px}.login-card label{display:grid;gap:7px;font-size:13px;color:#aeb7c8}.login-card input{background:#090d14;border:1px solid #2b3548;border-radius:9px;padding:12px;color:#fff}.login-card button,.google{padding:12px;border:0;border-radius:9px;background:#fff;color:#090b10;text-align:center;text-decoration:none;font-weight:800;cursor:pointer}.account-links{display:flex;justify-content:space-between;gap:1rem;margin:14px 0 0;font-size:13px}.account-links a{color:#c9dcff;text-decoration:none}.account-links a:hover,.account-links a:focus-visible{text-decoration:underline}.google{display:block;margin-top:14px;background:#1a2130;color:#fff}.login-card span{font-size:13px;color:#ff9a9a}</style>