---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Story Studio" description="Create books and stories from an idea." path="/app/story-studio" noindex>
  <main class="shell">
    <header class="topbar"><div><span class="eyebrow">THE TOOL SHED · STORY STUDIO</span><h1>Your writing studio</h1></div><div class="top-actions"><a href="/tools/story-studio">Product page</a><button id="logout">Sign out</button></div></header>
    <div id="notice" class="notice" hidden></div>
    <section class="usage"><article><span>Plan</span><strong id="plan">—</strong></article><article><span>Writing</span><strong id="word-usage">—</strong></article><article><span>Images</span><strong id="image-usage">—</strong></article><article><span>Projects</span><strong id="project-usage">—</strong></article></section>

    <section class="panel create-panel">
      <div><span class="eyebrow">NEW PROJECT</span><h2>What are you making?</h2><p>Give it the rough idea. The structure comes next.</p></div>
      <form id="create-form">
        <label>Project type<select id="project-type"><option value="childrens_book">Children’s book</option><option value="book">Book / novel</option><option value="short_story">Short story</option></select></label>
        <label>Working title<input id="title" placeholder="Optional" /></label>
        <label class="wide">Your idea<textarea id="idea" rows="4" required placeholder="A shy little dinosaur is afraid of the dark until... "></textarea></label>
        <label>Audience<input id="audience" placeholder="Ages 4–7, adult sci-fi, general..." /></label>
        <label>Tone<input id="tone" placeholder="Warm, funny, cinematic, serious..." /></label>
        <button class="primary" type="submit">Create project</button>
      </form>
    </section>

    <section class="workspace-grid">
      <aside class="panel project-list-panel"><div class="panel-head"><div><span class="eyebrow">PROJECTS</span><h2>Your library</h2></div></div><div id="projects" class="projects"><p class="muted">Loading…</p></div></aside>
      <section class="panel workspace" id="workspace"><div class="empty"><h2>Select a project</h2><p>Pick a project from your library or create one above.</p></div></section>
    </section>
  </main>
</BaseLayout>
<script>
  type AnyObj = Record<string, any>;
  let dashboard: AnyObj | null = null;
  let current: AnyObj | null = null;
  const $ = <T extends HTMLElement>(s:string) => document.querySelector<T>(s);
  const esc = (v:unknown) => { const d=document.createElement('div'); d.textContent=String(v ?? ''); return d.innerHTML; };
  const api = async (path:string, init:RequestInit={}) => { const r=await fetch(`/api/story-studio/${path}`,{...init,headers:{'content-type':'application/json',...(init.headers||{})}}); const d=await r.json().catch(()=>({})); if(!r.ok) throw new Error(d.error||`Request failed (${r.status})`); return d; };
  const show = (m:string,bad=false) => { const n=$('#notice')!; n.hidden=false; n.textContent=m; n.classList.toggle('bad',bad); };
  const pretty = (v:any) => { if(v == null) return ''; if(typeof v==='string') return v; return JSON.stringify(v,null,2); };

  async function loadDashboard() {
    dashboard = await api('dashboard');
    $('#plan')!.textContent = dashboard.plan.name;
    $('#word-usage')!.textContent = `${Number(dashboard.usage.words).toLocaleString()} / ${Number(dashboard.plan.monthly_word_limit).toLocaleString()}`;
    $('#image-usage')!.textContent = `${dashboard.usage.images} / ${dashboard.plan.monthly_image_limit}`;
    $('#project-usage')!.textContent = `${dashboard.projects.length} / ${dashboard.plan.active_project_limit}`;
    renderProjects();
  }
  function renderProjects() {
    const box=$('#projects')!; const items=dashboard?.projects||[];
    if(!items.length){box.innerHTML='<p class="muted">No projects yet.</p>';return;}
    box.innerHTML=items.map((p:any)=>`<button class="project-card ${current?.id===p.id?'active':''}" data-id="${p.id}">${p.cover_image_url?`<img src="${esc(p.cover_image_url)}" alt="" />`:''}<span>${esc(p.project_type.replaceAll('_',' '))}</span><strong>${esc(p.title)}</strong><small>${esc(p.status)}</small></button>`).join('');
  }
  async function openProject(id:string){ const {project}=await api(`projects/${id}`); current=project; renderProjects(); renderWorkspace(); }
  function sectionLabel(){ return current?.project_type==='childrens_book'?'Write Next Page':current?.project_type==='book'?'Write Next Chapter':'Write Next Scene'; }
  function renderWorkspace(){
    const w=$('#workspace')!; if(!current){w.innerHTML='<div class="empty"><h2>Select a project</h2></div>';return;}
    const manuscript=Array.isArray(current.manuscript)?current.manuscript:[];
    w.innerHTML=`<div class="workspace-head"><div><span class="eyebrow">${esc(current.project_type.replaceAll('_',' '))}</span><h2>${esc(current.title)}</h2><p>${esc(current.idea)}</p></div>${current.cover_image_url?`<img class="cover" src="${esc(current.cover_image_url)}" alt="Generated cover" />`:''}</div>
      <div class="actions"><button data-gen="story_bible">Build Story Bible</button><button data-gen="outline">Create Outline</button><button class="primary" data-gen="next_section">${sectionLabel()}</button><button data-gen="cover">Generate Cover</button><button class="danger" data-delete>Delete Project</button></div>
      <div class="detail-grid"><article><h3>Story Bible</h3><pre>${esc(pretty(current.story_bible)) || 'Not generated yet.'}</pre></article><article><h3>Outline</h3><pre>${esc(pretty(current.outline)) || 'Not generated yet.'}</pre></article></div>
      <section class="manuscript"><h3>Manuscript <span>${manuscript.length} section${manuscript.length===1?'':'s'}</span></h3>${manuscript.length?manuscript.map((s:any,i:number)=>`<article><div class="section-num">${i+1}</div><div><h4>${esc(s.title||`Section ${i+1}`)}</h4><p>${esc(s.content||pretty(s))}</p>${s.illustration_prompt?`<details><summary>Illustration direction</summary><p>${esc(s.illustration_prompt)}</p></details>`:''}</div></article>`).join(''):'<p class="muted">Nothing drafted yet.</p>'}</section>`;
  }
  $('#create-form')?.addEventListener('submit', async e=>{ e.preventDefault(); try{ const body={project_type:($('#project-type') as HTMLSelectElement).value,title:($('#title') as HTMLInputElement).value,idea:($('#idea') as HTMLTextAreaElement).value,target_audience:($('#audience') as HTMLInputElement).value,tone:($('#tone') as HTMLInputElement).value}; const {project}=await api('projects',{method:'POST',body:JSON.stringify(body)}); ($('#create-form') as HTMLFormElement).reset(); await loadDashboard(); await openProject(project.id); show('Project created.'); }catch(err){show(err instanceof Error?err.message:'Unable to create project.',true);} });
  $('#projects')?.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-id]'); if(b?.dataset.id) openProject(b.dataset.id).catch(err=>show(err.message,true));});
  $('#workspace')?.addEventListener('click',async e=>{ const el=e.target as HTMLElement; const gen=el.closest<HTMLButtonElement>('[data-gen]'); const del=el.closest<HTMLButtonElement>('[data-delete]'); if(gen?.dataset.gen&&current){ gen.disabled=true; show(gen.dataset.gen==='cover'?'Generating artwork…':'Writing…'); try{await api(`projects/${current.id}/generate`,{method:'POST',body:JSON.stringify({action:gen.dataset.gen})}); await openProject(current.id); await loadDashboard(); show('Project updated.');}catch(err){show(err instanceof Error?err.message:'Generation failed.',true);}finally{gen.disabled=false;} } if(del&&current&&confirm('Delete this project?')){try{await api(`projects/${current.id}`,{method:'DELETE'});current=null;renderWorkspace();await loadDashboard();show('Project deleted.');}catch(err){show(err instanceof Error?err.message:'Delete failed.',true);}} });
  $('#logout')?.addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST',headers:{'content-type':'application/json'},body:'{}'});location.href='/account';});
  loadDashboard().catch(e=>show(e.message,true));
</script>
<style>
.shell{width:min(1220px,calc(100% - 2rem));margin:0 auto;padding:3rem 0 6rem}.topbar,.workspace-head,.panel-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.topbar h1{font-size:clamp(2rem,5vw,3.7rem);margin:.3rem 0}.eyebrow{font-size:.7rem;letter-spacing:.15em;color:#c7a76a;font-weight:850}.top-actions{display:flex;gap:.5rem}.top-actions a,.top-actions button,.actions button,.primary{padding:.7rem .85rem;border-radius:.5rem;border:1px solid var(--color-border);background:#151613;color:#e9e4d8;text-decoration:none;font-weight:800;cursor:pointer}.primary{background:#ece6da!important;color:#111!important;border-color:#ece6da!important}.danger{color:#e4a3a3!important}.usage{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin:1.4rem 0}.usage article,.panel{border:1px solid var(--color-border);background:#10110f;border-radius:.8rem}.usage article{padding:1rem;display:grid;gap:.3rem}.usage span,.muted{color:#8d8981;font-size:.8rem}.usage strong{font-size:1.15rem}.panel{padding:1.25rem}.create-panel>div p{color:#918d85}.create-panel form{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:1rem}.create-panel label{display:grid;gap:.35rem;color:#aaa59c;font-size:.78rem;font-weight:750}.create-panel .wide{grid-column:1/-1}.create-panel input,.create-panel textarea,.create-panel select{padding:.75rem;border:1px solid var(--color-border);border-radius:.5rem;background:#090a09;color:#f1eee7}.create-panel button{width:max-content}.workspace-grid{display:grid;grid-template-columns:300px 1fr;gap:1rem;margin-top:1rem}.projects{display:grid;gap:.55rem;margin-top:.8rem}.project-card{display:grid;grid-template-columns:auto 1fr;gap:.2rem .65rem;text-align:left;padding:.7rem;border:1px solid var(--color-border);border-radius:.55rem;background:#0b0c0a;color:#eee9df;cursor:pointer}.project-card.active{border-color:#76643e;background:#15140f}.project-card img{grid-row:1/4;width:45px;height:60px;object-fit:cover;border-radius:.25rem}.project-card span,.project-card small{text-transform:capitalize;font-size:.68rem;color:#79756e}.project-card strong{font-size:.86rem}.workspace-head p{color:#969188;max-width:650px;line-height:1.55}.cover{width:130px;aspect-ratio:2/3;object-fit:cover;border-radius:.45rem}.actions{display:flex;gap:.45rem;flex-wrap:wrap;margin:1rem 0}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.detail-grid article{border:1px solid var(--color-border);border-radius:.6rem;padding:1rem;background:#0b0c0a}.detail-grid h3{margin:0 0 .6rem}.detail-grid pre{white-space:pre-wrap;word-break:break-word;color:#aaa69e;font:inherit;font-size:.78rem;max-height:330px;overflow:auto}.manuscript{margin-top:1.2rem}.manuscript>h3 span{font-size:.72rem;color:#77736d;font-weight:400}.manuscript>article{display:grid;grid-template-columns:34px 1fr;gap:.8rem;padding:1rem 0;border-top:1px solid var(--color-border)}.section-num{width:30px;height:30px;display:grid;place-items:center;border:1px solid var(--color-border);border-radius:50%;color:#c7a76a;font-size:.75rem}.manuscript h4{margin:.2rem 0}.manuscript p{white-space:pre-wrap;color:#d6d1c8;line-height:1.7}.manuscript details{color:#938e85;font-size:.8rem}.notice{padding:.8rem 1rem;border:1px solid #665d3d;border-radius:.55rem;color:#d7c18d;margin-bottom:1rem}.notice.bad{border-color:#713f3f;color:#e4a3a3}.empty{min-height:300px;display:grid;place-content:center;text-align:center;color:#8e8981}@media(max-width:900px){.usage{grid-template-columns:1fr 1fr}.workspace-grid{grid-template-columns:1fr}.projects{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.topbar,.workspace-head{display:block}.top-actions{margin-top:1rem}.usage,.projects,.detail-grid,.create-panel form{grid-template-columns:1fr}.create-panel .wide{grid-column:auto}.cover{margin-top:1rem}}
</style>
