---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Story Studio" description="Create, finish, and export publisher-ready books." path="/app/story-studio" noindex>
  <main class="shell">
    <header class="topbar"><div><span class="eyebrow">THE TOOL SHED · STORY STUDIO</span><h1>Your publishing studio</h1><p class="lede">Draft for free. Paid plans finish the book, illustrations, QA, and KDP package.</p></div><div class="top-actions"><a href="/tools/story-studio">Product page</a><button id="logout">Sign out</button></div></header>
    <div id="notice" class="notice" hidden></div>
    <section class="usage"><article><span>Plan</span><strong id="plan">—</strong></article><article><span>Writing</span><strong id="word-usage">—</strong></article><article><span>Images</span><strong id="image-usage">—</strong></article><article><span>Projects</span><strong id="project-usage">—</strong></article></section>

    <section class="panel create-panel">
      <div><span class="eyebrow">NEW PROJECT</span><h2>What are you making?</h2><p>Children’s books are the first publisher-ready format. Comics remain paid beta while the consistency system matures.</p></div>
      <form id="create-form">
        <label>Project type<select id="project-type"><option value="childrens_book">Children’s book</option><option value="book">Book / novel</option><option value="short_story">Short story</option></select></label>
        <label>Working title<input id="title" placeholder="Optional" /></label>
        <label class="wide">Your idea<textarea id="idea" rows="4" required placeholder="A shy little dinosaur is afraid of the dark until..."></textarea></label>
        <label>Audience<input id="audience" placeholder="Ages 4–7, adult sci-fi, general..." /></label>
        <label>Tone<input id="tone" placeholder="Warm, funny, cinematic, serious..." /></label>
        <button class="primary" type="submit">Create project</button>
      </form>
    </section>

    <section class="workspace-grid">
      <aside class="panel project-list-panel"><div class="panel-head"><div><span class="eyebrow">PROJECTS</span><h2>Your library</h2></div></div><div id="projects" class="projects"><p class="muted">Loading…</p></div></aside>
      <section class="panel workspace" id="workspace"><div class="empty"><h2>Select a project</h2><p>Pick a project from your library or create one above.</p></div></section>
    </section>
  </main>
</BaseLayout>
<script>
  type AnyObj = Record<string, any>;
  let dashboard: AnyObj | null = null; let current: AnyObj | null = null;
  const $ = <T extends HTMLElement>(s:string) => document.querySelector<T>(s);
  const esc = (v:unknown) => { const d=document.createElement('div'); d.textContent=String(v ?? ''); return d.innerHTML; };
  const api = async (path:string, init:RequestInit={}) => { const r=await fetch(`/api/story-studio/${path}`,{...init,headers:{'content-type':'application/json',...(init.headers||{})}}); const d=await r.json().catch(()=>({})); if(!r.ok) throw new Error(d.error||`Request failed (${r.status})`); return d; };
  const show = (m:string,bad=false) => { const n=$('#notice')!; n.hidden=false; n.textContent=m; n.classList.toggle('bad',bad); window.scrollTo({top:0,behavior:'smooth'}); };
  const pretty = (v:any) => { if(v == null) return ''; if(typeof v==='string') return v; return JSON.stringify(v,null,2); };
  const paid = () => dashboard?.plan?.id && dashboard.plan.id !== 'free';

  async function loadDashboard() {
    const nextDashboard: AnyObj = await api('dashboard');
    dashboard = nextDashboard;
    $('#plan')!.textContent = nextDashboard.plan.name;
    $('#word-usage')!.textContent = `${Number(nextDashboard.usage.words).toLocaleString()} / ${Number(nextDashboard.plan.monthly_word_limit).toLocaleString()}`;
    $('#image-usage')!.textContent = `${nextDashboard.usage.images} / ${nextDashboard.plan.monthly_image_limit}`;
    $('#project-usage')!.textContent = `${nextDashboard.projects.length} / ${nextDashboard.plan.active_project_limit}`;
    renderProjects();
  }
  function renderProjects() {
    const box=$('#projects')!; const items=dashboard?.projects||[];
    if(!items.length){box.innerHTML='<p class="muted">No projects yet.</p>';return;}
    box.innerHTML=items.map((p:any)=>`<button class="project-card ${current?.id===p.id?'active':''}" data-id="${p.id}">${p.cover_image_url?`<img src="${esc(p.cover_image_url)}" alt="" />`:''}<span>${esc(p.project_type.replaceAll('_',' '))}</span><strong>${esc(p.title)}</strong><small>${esc(p.status)}</small></button>`).join('');
  }
  async function openProject(id:string){ const {project}=await api(`projects/${id}`); current=project; renderProjects(); renderWorkspace(); }
  function sectionLabel(){ return current?.project_type==='childrens_book'?'Write Next Page':current?.project_type==='book'?'Write Next Chapter':'Write Next Scene'; }
  function renderWorkspace(){
    const w=$('#workspace')!; if(!current){w.innerHTML='<div class="empty"><h2>Select a project</h2></div>';return;}
    const manuscript=Array.isArray(current.manuscript)?current.manuscript:[];
    const illustrations=Array.isArray(current.illustrations)?current.illustrations:[];
    const passedIllustrations=illustrations.filter((x:any)=>x?.url&&x?.qa?.passed===true);
    const illustratedPages=new Map(passedIllustrations.map((x:any)=>[Number(x.page_number),x.url]));
    const slots=manuscript.filter((x:any)=>x.illustrate===true);
    const ready=manuscript.length===24 && slots.length===12 && illustratedPages.size===12 && Boolean(current.cover_image_url);
    const manuscriptCost=Number(current.metadata?.cost_tracking?.manuscript_pipeline_estimated_usd||0);
    const imageCost=illustrations.reduce((sum:number,x:any)=>sum+Number(x?.estimated_run_cost_usd||0),0);
    const estimatedCost=manuscriptCost+imageCost;
    const lastQa=current.last_qa||{};
    w.innerHTML=`<div class="workspace-head"><div><span class="eyebrow">${esc(current.project_type.replaceAll('_',' '))}</span><h2>${esc(current.title)}</h2><p>${esc(current.idea)}</p><div class="status-row"><span>${esc(current.status)}</span><span>${manuscript.length} pages</span><span>${illustratedPages.size}/12 illustrations QA-passed</span><span>${esc(current.export_status||'not_ready')}</span>${lastQa.score!=null?`<span>QA ${esc(lastQa.score)}/100</span>`:''}${estimatedCost>0?`<span>Est. API $${estimatedCost.toFixed(2)}</span>`:''}</div></div>${current.cover_image_url?`<img class="cover" src="${esc(current.cover_image_url)}" alt="Generated cover" />`:''}</div>
      <div class="actions"><button data-gen="story_bible">Build Story Bible</button><button data-gen="outline">Create Outline</button><button data-gen="next_section">${sectionLabel()}</button><button data-gen="cover">Generate Cover</button>${current.project_type==='childrens_book'?`<button class="primary" data-finish-book ${paid()?'':'disabled'}>Build 24-Page Book</button><button data-finish-art ${paid()?'':'disabled'}>Generate All Illustrations</button><button class="export" data-export ${ready&&paid()?'':'disabled'}>Export for KDP</button>`:''}<button class="danger" data-delete>Delete Project</button></div>
      ${current.project_type==='childrens_book'?`<div class="publisher-note"><strong>Paid publisher pipeline:</strong> 24-page 8.5×8.5 interior, 12 professionally illustrated pages, locked character/art bible, actual-image visual QA with corrective retries, layout/package QA, separate cover PDF, manuscript, metadata, upload checklist, and one final assembled-book QA gate before export. KDP or another publisher still makes the final acceptance decision.</div>`:''}
      ${Array.isArray(lastQa.issues)&&lastQa.issues.length?`<div class="qa-fail"><strong>Latest QA findings</strong>${lastQa.issues.map((x:any)=>`<p>${esc(x.severity||'issue')}: ${esc(x.message||x.fix||'QA issue')}</p>`).join('')}</div>`:''}
      <div class="detail-grid"><article><h3>Story Bible</h3><pre>${esc(pretty(current.story_bible)) || 'Not generated yet.'}</pre></article><article><h3>Visual / Character Bible</h3><pre>${esc(pretty(current.visual_bible)) || 'Generated during paid book finishing.'}</pre></article></div>
      <section class="manuscript"><h3>Manuscript <span>${manuscript.length} section${manuscript.length===1?'':'s'}</span></h3>${manuscript.length?manuscript.map((s:any,i:number)=>{const p=Number(s.page_number||i+1);const img=illustratedPages.get(p);const record=illustrations.find((x:any)=>Number(x.page_number)===p);return `<article><div class="section-num">${p}</div><div class="page-content">${img?`<img class="page-img" src="${esc(img)}" alt="Illustration for page ${p}" />`:''}<h4>${esc(s.title||`Page ${p}`)}</h4><p>${esc(s.content||pretty(s))}</p><div class="page-actions"><button data-edit-page="${p}">Edit text</button>${s.illustrate===true&&!img?`<button data-one-art="${p}">Generate illustration</button>`:''}</div>${record?.qa?`<small class="image-qa">Visual QA: ${esc(record.qa.score||0)}/100 · ${record.qa.passed?'passed':'failed'} · ${esc(record.attempts||1)} attempt(s)</small>`:''}${s.illustration_prompt?`<details><summary>Illustration direction</summary><p>${esc(s.illustration_prompt)}</p></details>`:''}</div></article>`}).join(''):'<p class="muted">Nothing drafted yet.</p>'}</section>`;
  }
  async function buildFullBook(){ if(!current) return; if(!paid()) throw new Error('Upgrade to a paid plan to build a finished 24-page book.'); show('Building, editing, art-directing, and independently QA-checking the 24-page manuscript…'); const d=await api(`finish/${current.id}`,{method:'POST',body:JSON.stringify({step:'manuscript'})}); current=d.project; renderWorkspace(); await loadDashboard(); show(`24-page manuscript passed publishing QA. Locked visual bible created. Estimated text-pipeline cost: $${Number(d.estimated_run_cost_usd||0).toFixed(2)}.`); }
  async function generateIllustration(page:number){ if(!current) return null; const d=await api(`finish/${current.id}`,{method:'POST',body:JSON.stringify({step:'illustration',page_number:page})}); if(d.project) current=d.project; renderWorkspace(); await loadDashboard(); return d; }
  async function generateAllIllustrations(){ if(!current) return; const slots=(Array.isArray(current.manuscript)?current.manuscript:[]).filter((x:any)=>x.illustrate===true); if(slots.length!==12) throw new Error('Build the finished 24-page manuscript first. It must contain exactly 12 illustration slots.'); for(let i=0;i<slots.length;i++){ const page=Number(slots[i].page_number); const already=(Array.isArray(current.illustrations)?current.illustrations:[]).some((x:any)=>Number(x.page_number)===page&&x.url&&x.qa?.passed===true); if(already) continue; show(`Generating and visually QA-checking illustration ${i+1} of ${slots.length}…`); await generateIllustration(page); } show('All 12 illustrations passed visual QA. Generate a cover if needed, then Export for KDP will run the final assembled-book QA gate.'); }
  async function editPage(page:number){ if(!current) return; const item=(Array.isArray(current.manuscript)?current.manuscript:[]).find((x:any)=>Number(x.page_number)===page); if(!item) return; const next=prompt(`Edit page ${page}`,String(item.content||'')); if(next===null) return; const d=await api(`edit/${current.id}`,{method:'POST',body:JSON.stringify({page_number:page,content:next})}); current=d.project; renderWorkspace(); show(`Page ${page} updated. Export QA status reset so the final package reflects the edit.`); }
  function exportKdp(){ if(!current) return; if(!paid()) return show('KDP export is a paid feature.',true); show('Running final assembled-book QA and preparing the KDP package…'); window.location.href=`/api/story-studio/export/${current.id}`; }

  $('#create-form')?.addEventListener('submit', async e=>{ e.preventDefault(); try{ const body={project_type:($('#project-type') as HTMLSelectElement).value,title:($('#title') as HTMLInputElement).value,idea:($('#idea') as HTMLTextAreaElement).value,target_audience:($('#audience') as HTMLInputElement).value,tone:($('#tone') as HTMLInputElement).value}; const {project}=await api('projects',{method:'POST',body:JSON.stringify(body)}); ($('#create-form') as HTMLFormElement).reset(); await loadDashboard(); await openProject(project.id); show('Project created.'); }catch(err){show(err instanceof Error?err.message:'Unable to create project.',true);} });
  $('#projects')?.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-id]'); if(b?.dataset.id) openProject(b.dataset.id).catch(err=>show(err.message,true));});
  $('#workspace')?.addEventListener('click',async e=>{ const el=e.target as HTMLElement; const gen=el.closest<HTMLButtonElement>('[data-gen]'); const del=el.closest<HTMLButtonElement>('[data-delete]'); const finish=el.closest<HTMLButtonElement>('[data-finish-book]'); const finishArt=el.closest<HTMLButtonElement>('[data-finish-art]'); const exp=el.closest<HTMLButtonElement>('[data-export]'); const edit=el.closest<HTMLButtonElement>('[data-edit-page]'); const one=el.closest<HTMLButtonElement>('[data-one-art]');
    try{
      if(finish && !finish.disabled){finish.disabled=true;await buildFullBook();}
      else if(finishArt && !finishArt.disabled){finishArt.disabled=true;await generateAllIllustrations();}
      else if(exp && !exp.disabled){exportKdp();}
      else if(edit?.dataset.editPage){await editPage(Number(edit.dataset.editPage));}
      else if(one?.dataset.oneArt){one.disabled=true;show(`Generating and visually QA-checking illustration for page ${one.dataset.oneArt}…`);const d=await generateIllustration(Number(one.dataset.oneArt));show(`Illustration passed visual QA${d?.attempts?` after ${d.attempts} attempt(s)`:''}.`);}
      else if(gen?.dataset.gen&&current){ gen.disabled=true; show(gen.dataset.gen==='cover'?'Generating cover artwork…':'Writing and QA-checking…'); await api(`projects/${current.id}/generate`,{method:'POST',body:JSON.stringify({action:gen.dataset.gen})}); await openProject(current.id); await loadDashboard(); show('Project updated.'); }
      else if(del&&current&&confirm('Delete this project?')){await api(`projects/${current.id}`,{method:'DELETE'});current=null;renderWorkspace();await loadDashboard();show('Project deleted.');}
    }catch(err){show(err instanceof Error?err.message:'Action failed.',true);}finally{if(finish)finish.disabled=false;if(finishArt)finishArt.disabled=false;if(gen)gen.disabled=false;if(one)one.disabled=false;}
  });
  $('#logout')?.addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST',headers:{'content-type':'application/json'},body:'{}'});location.href='/account';});
  loadDashboard().catch(e=>show(e.message,true));
</script>
<style>
.shell{width:min(1220px,calc(100% - 2rem));margin:0 auto;padding:3rem 0 6rem}.topbar,.workspace-head,.panel-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.topbar h1{font-size:clamp(2rem,5vw,3.7rem);margin:.3rem 0}.lede{color:#8f8b84;max-width:700px}.eyebrow{font-size:.7rem;letter-spacing:.15em;color:#c7a76a;font-weight:850}.top-actions{display:flex;gap:.5rem}.top-actions a,.top-actions button,.actions button,.page-actions button,.primary{padding:.7rem .85rem;border-radius:.5rem;border:1px solid var(--color-border);background:#151613;color:#e9e4d8;text-decoration:none;font-weight:800;cursor:pointer}.primary{background:#ece6da!important;color:#111!important;border-color:#ece6da!important}.export{border-color:#76643e!important;color:#dfc486!important}.actions button:disabled{opacity:.38;cursor:not-allowed}.danger{color:#e4a3a3!important}.usage{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin:1.4rem 0}.usage article,.panel{border:1px solid var(--color-border);background:#10110f;border-radius:.8rem}.usage article{padding:1rem;display:grid;gap:.3rem}.usage span,.muted{color:#8d8981;font-size:.8rem}.usage strong{font-size:1.15rem}.panel{padding:1.25rem}.create-panel>div p{color:#918d85}.create-panel form{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:1rem}.create-panel label{display:grid;gap:.35rem;color:#aaa59c;font-size:.78rem;font-weight:750}.create-panel .wide{grid-column:1/-1}.create-panel input,.create-panel textarea,.create-panel select{padding:.75rem;border:1px solid var(--color-border);border-radius:.5rem;background:#090a09;color:#f1eee7}.create-panel button{width:max-content}.workspace-grid{display:grid;grid-template-columns:300px 1fr;gap:1rem;margin-top:1rem}.projects{display:grid;gap:.55rem;margin-top:.8rem}.project-card{display:grid;grid-template-columns:auto 1fr;gap:.2rem .65rem;text-align:left;padding:.7rem;border:1px solid var(--color-border);border-radius:.55rem;background:#0b0c0a;color:#eee9df;cursor:pointer}.project-card.active{border-color:#76643e;background:#15140f}.project-card img{grid-row:1/4;width:45px;height:60px;object-fit:cover;border-radius:.25rem}.project-card span,.project-card small{text-transform:capitalize;font-size:.68rem;color:#79756e}.project-card strong{font-size:.86rem}.workspace-head p{color:#969188;max-width:650px;line-height:1.55}.cover{width:130px;aspect-ratio:2/3;object-fit:cover;border-radius:.45rem}.actions{display:flex;gap:.45rem;flex-wrap:wrap;margin:1rem 0}.status-row{display:flex;gap:.45rem;flex-wrap:wrap}.status-row span{font-size:.68rem;border:1px solid var(--color-border);padding:.25rem .45rem;border-radius:99px;color:#9d988f}.publisher-note{padding:.8rem 1rem;border:1px solid #5b5136;background:#15130d;border-radius:.6rem;color:#c4b894;font-size:.78rem;line-height:1.55;margin-bottom:1rem}.qa-fail{padding:.8rem 1rem;border:1px solid #713f3f;background:#160f0f;border-radius:.6rem;color:#e4a3a3;font-size:.78rem;margin-bottom:1rem}.qa-fail p{margin:.35rem 0}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.detail-grid article{border:1px solid var(--color-border);border-radius:.6rem;padding:1rem;background:#0b0c0a}.detail-grid h3{margin:0 0 .6rem}.detail-grid pre{white-space:pre-wrap;word-break:break-word;color:#aaa69e;font:inherit;font-size:.78rem;max-height:330px;overflow:auto}.manuscript{margin-top:1.2rem}.manuscript>h3 span{font-size:.72rem;color:#77736d;font-weight:400}.manuscript>article{display:grid;grid-template-columns:34px 1fr;gap:.8rem;padding:1rem 0;border-top:1px solid var(--color-border)}.section-num{width:30px;height:30px;display:grid;place-items:center;border:1px solid var(--color-border);border-radius:50%;color:#c7a76a;font-size:.75rem}.manuscript h4{margin:.2rem 0}.manuscript p{white-space:pre-wrap;color:#d6d1c8;line-height:1.7}.manuscript details{color:#938e85;font-size:.8rem}.page-img{width:min(100%,560px);aspect-ratio:1/1;object-fit:cover;border-radius:.55rem;margin-bottom:.7rem}.page-actions{display:flex;gap:.45rem;margin:.6rem 0}.page-actions button{padding:.42rem .6rem;font-size:.7rem}.image-qa{display:block;color:#8fa887;margin:.2rem 0 .55rem}.notice{padding:.8rem 1rem;border:1px solid #665d3d;border-radius:.55rem;color:#d7c18d;margin-bottom:1rem}.notice.bad{border-color:#713f3f;color:#e4a3a3}.empty{min-height:300px;display:grid;place-content:center;text-align:center;color:#8e8981}@media(max-width:900px){.usage{grid-template-columns:1fr 1fr}.workspace-grid{grid-template-columns:1fr}.projects{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.topbar,.workspace-head{display:block}.top-actions{margin-top:1rem}.usage,.projects,.detail-grid,.create-panel form{grid-template-columns:1fr}.create-panel .wide{grid-column:auto}.cover{margin-top:1rem}}
</style>
