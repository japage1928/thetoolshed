---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Video Studio" description="Create and manage AI video production projects." path="/app/video-studio" noindex>
  <div class="studio-shell">
    <aside class="rail">
      <a class="rail-brand" href="/tools/video-studio"><span>TS</span> Video Studio</a>
      <nav><a class="active" href="/app/video-studio">Projects</a><a href="#brand-kit">Brand kit <small>soon</small></a><a href="#publishing">Publishing <small>soon</small></a></nav>
      <div class="rail-bottom"><a href="/tools/video-studio">Product page</a><button id="logout" type="button">Sign out</button></div>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <div><span class="eyebrow">THE TOOL SHED</span><h1>Video Studio</h1></div>
        <div class="status-pills"><span id="billing-pill">Billing off</span><span id="generation-pill">Generator paused</span></div>
      </header>

      <section class="metrics">
        <article><span>Available credits</span><strong id="credit-balance">—</strong><small>Internal test allocation</small></article>
        <article><span>Active projects</span><strong id="project-count">—</strong><small>Drafts and production jobs</small></article>
        <article><span>Production mode</span><strong>Safe</strong><small>No paid render calls</small></article>
      </section>

      <section class="create-panel">
        <div class="panel-head"><div><span class="eyebrow">NEW PRODUCTION</span><h2>What should we make?</h2></div><p>Start simple. The production system owns the prompt engineering.</p></div>
        <form id="project-form">
          <div class="source-tabs" role="group" aria-label="Project source">
            <button class="source-tab active" data-source="url" type="button">Paste product URL</button>
            <button class="source-tab" data-source="brief" type="button">Describe the video</button>
          </div>
          <input id="source-type" name="sourceType" type="hidden" value="url" />
          <label class="wide" id="url-field">Product or business URL<input name="sourceUrl" type="url" placeholder="https://example.com/product" /></label>
          <label class="wide" id="brief-field" hidden>Creative brief<textarea name="brief" rows="5" placeholder="Create a 30-second product video for…"></textarea></label>
          <div class="controls">
            <label>Goal<select name="objective"><option>Create product interest</option><option>Drive clicks</option><option>Explain the offer</option><option>Build trust</option></select></label>
            <label>Platform<select name="platform"><option>TikTok / Reels / Shorts</option><option>YouTube</option><option>X</option><option>Facebook</option><option>Pinterest</option></select></label>
            <label>Duration<select name="durationSeconds"><option value="15">15 seconds</option><option value="30" selected>30 seconds</option><option value="45">45 seconds</option><option value="60">60 seconds</option></select></label>
            <label>Resolution<select name="resolution"><option value="480p">480p economical</option><option value="720p">720p</option><option value="1080p">1080p premium</option></select></label>
          </div>
          <input name="aspectRatio" type="hidden" value="9:16" />
          <div class="estimate"><span>Estimated production budget</span><strong><b id="estimate">10</b> credits</strong></div>
          <div class="form-actions">
            <button class="save" type="submit">Save production brief</button>
            <button class="generate" id="generate-button" type="button" disabled>Generation paused</button>
          </div>
          <p id="form-status" class="form-status" hidden></p>
        </form>
      </section>

      <section class="projects-panel">
        <div class="panel-head compact"><div><span class="eyebrow">RECENT WORK</span><h2>Your projects</h2></div><button id="refresh" type="button">Refresh</button></div>
        <div id="projects" class="project-list"><p class="empty">Loading projects…</p></div>
      </section>

      <section class="billing-panel" aria-label="Billing status">
        <div><span class="eyebrow">BILLING SAFETY LOCK</span><h2>Stripe is wired, but switched off.</h2><p>Checkout, the billing portal, webhook credit grants, and subscription records are server-side and test-mode only. No payment can be created while the billing switch is off.</p></div>
        <button id="billing-button" type="button" disabled>Billing unavailable</button>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  const projectList = document.querySelector<HTMLElement>('#projects');
  const form = document.querySelector<HTMLFormElement>('#project-form');
  const formStatus = document.querySelector<HTMLElement>('#form-status');
  const generationButton = document.querySelector<HTMLButtonElement>('#generate-button');
  const estimate = document.querySelector<HTMLElement>('#estimate');
  let currentProjects: Array<Record<string, any>> = [];
  let generationEnabled = false;

  const creditEstimate = () => {
    const duration = Number((form?.elements.namedItem('durationSeconds') as HTMLSelectElement)?.value || 30);
    const resolution = String((form?.elements.namedItem('resolution') as HTMLSelectElement)?.value || '480p');
    const multiplier = resolution === '1080p' ? 2.5 : resolution === '720p' ? 1.5 : 1;
    return Math.ceil(5 * Math.ceil(duration / 15) * multiplier);
  };

  const updateEstimate = () => { if (estimate) estimate.textContent = String(creditEstimate()); };

  function renderProjects() {
    if (!projectList) return;
    if (!currentProjects.length) {
      projectList.innerHTML = '<p class="empty">No projects yet. Save your first production brief above.</p>';
      return;
    }
    projectList.innerHTML = currentProjects.map((project) => `
      <article class="project-card">
        <div class="project-icon">${project.source_type === 'url' ? '↗' : '✦'}</div>
        <div><strong>${escapeHtml(project.title)}</strong><span>${escapeHtml(project.platform)} · ${project.duration_seconds}s · ${project.resolution}</span></div>
        <span class="project-status">${escapeHtml(project.status)}</span>
        <button type="button" data-generate="${project.id}" ${generationEnabled ? '' : 'disabled'}>${generationEnabled ? 'Generate' : 'Paused'}</button>
      </article>`).join('');
  }

  function escapeHtml(value: unknown) {
    const node = document.createElement('span');
    node.textContent = String(value ?? '');
    return node.innerHTML;
  }

  async function loadProjects() {
    if (projectList) projectList.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch('/api/video-studio/projects', { headers: { accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to load projects.');
      currentProjects = data.projects || [];
      generationEnabled = Boolean(data.generationEnabled);
      const credits = document.querySelector('#credit-balance');
      const count = document.querySelector('#project-count');
      const generationPill = document.querySelector('#generation-pill');
      const billingPill = document.querySelector('#billing-pill');
      if (credits) credits.textContent = String(data.credits ?? 0);
      if (count) count.textContent = String(currentProjects.filter((item) => item.status !== 'archived').length);
      if (generationPill) generationPill.textContent = generationEnabled ? 'Generator ready' : 'Generator paused';
      if (billingPill) billingPill.textContent = data.billingEnabled ? 'Billing test mode' : 'Billing off';
      if (generationButton) { generationButton.disabled = !generationEnabled; generationButton.textContent = generationEnabled ? 'Generate video' : 'Generation paused'; }
      renderProjects();
    } catch (error) {
      if (projectList) projectList.innerHTML = `<p class="empty error">${escapeHtml(error instanceof Error ? error.message : 'Unable to load projects.')}</p>`;
    } finally {
      projectList?.removeAttribute('aria-busy');
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.source-tab').forEach((button) => button.addEventListener('click', () => {
    const source = button.dataset.source === 'brief' ? 'brief' : 'url';
    document.querySelectorAll('.source-tab').forEach((item) => item.classList.toggle('active', item === button));
    const sourceInput = document.querySelector<HTMLInputElement>('#source-type');
    const urlField = document.querySelector<HTMLElement>('#url-field');
    const briefField = document.querySelector<HTMLElement>('#brief-field');
    if (sourceInput) sourceInput.value = source;
    if (urlField) urlField.hidden = source !== 'url';
    if (briefField) briefField.hidden = source !== 'brief';
  }));

  form?.addEventListener('change', updateEstimate);
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    if (formStatus) { formStatus.hidden = false; formStatus.textContent = 'Saving production brief…'; }
    try {
      const raw = Object.fromEntries(new FormData(form).entries());
      const payload = { ...raw, durationSeconds: Number(raw.durationSeconds) };
      const response = await fetch('/api/video-studio/projects', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to save the project.');
      if (formStatus) formStatus.textContent = 'Project saved. Paid rendering remains paused.';
      form.reset();
      const sourceInput = document.querySelector<HTMLInputElement>('#source-type');
      if (sourceInput) sourceInput.value = 'url';
      updateEstimate();
      await loadProjects();
    } catch (error) {
      if (formStatus) formStatus.textContent = error instanceof Error ? error.message : 'Unable to save the project.';
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  projectList?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-generate]');
    if (!button || button.disabled) return;
    const project = currentProjects.find((item) => item.id === button.dataset.generate);
    if (!project) return;
    button.disabled = true;
    button.textContent = 'Queuing…';
    try {
      const response = await fetch('/api/video-studio/generate', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'idempotency-key': crypto.randomUUID() },
        body: JSON.stringify({ projectId: project.id, durationSeconds: project.duration_seconds, resolution: project.resolution }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to queue generation.');
      await loadProjects();
    } catch (error) {
      button.textContent = error instanceof Error ? error.message : 'Queue failed';
      setTimeout(() => renderProjects(), 2200);
    }
  });

  document.querySelector('#refresh')?.addEventListener('click', loadProjects);
  document.querySelector('#logout')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
    window.location.href = '/account?next=/app/video-studio';
  });
  updateEstimate();
  loadProjects();
</script>

<style>
  :global(body){background:#080908}.studio-shell{min-height:calc(100vh - 140px);display:grid;grid-template-columns:230px 1fr}.rail{padding:1.4rem 1rem;border-right:1px solid var(--color-border);background:#0d0e0c;display:flex;flex-direction:column;gap:2.5rem}.rail-brand{display:flex;align-items:center;gap:.7rem;color:#ede9e0;text-decoration:none;font-weight:900}.rail-brand span{display:grid;place-items:center;width:2rem;height:2rem;border:1px solid #178cff;border-radius:.4rem;color:#9fcfff;font-size:.7rem}.rail nav{display:grid;gap:.35rem}.rail nav a,.rail-bottom a,.rail-bottom button{padding:.65rem .7rem;border-radius:.45rem;color:#8e8a83;text-decoration:none;font:inherit;font-size:.82rem;background:none;border:0;text-align:left}.rail nav a.active{background:#171915;color:#f1eee7}.rail small{float:right;color:#5f5c56}.rail-bottom{margin-top:auto;display:grid;border-top:1px solid var(--color-border);padding-top:1rem}.rail-bottom button{cursor:pointer}.workspace{width:min(1220px,100%);padding:2.2rem clamp(1rem,3vw,3rem) 5rem}.topbar{display:flex;justify-content:space-between;gap:2rem;align-items:flex-end;margin-bottom:1.5rem}.eyebrow{font-size:.65rem;letter-spacing:.16em;font-weight:900;color:#c7a76a}.topbar h1{margin:.25rem 0 0;font-size:2.2rem}.status-pills{display:flex;gap:.5rem}.status-pills span{padding:.45rem .65rem;border:1px solid #3a342c;border-radius:99px;color:#8e8a83;font-size:.69rem}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-bottom:.8rem}.metrics article,.create-panel,.projects-panel,.billing-panel{border:1px solid var(--color-border);background:#10110f;border-radius:.75rem}.metrics article{padding:1rem 1.1rem;display:grid;gap:.25rem}.metrics span,.estimate span{color:#85817b;font-size:.72rem}.metrics strong{font-size:1.55rem}.metrics small{color:#5f5c56}.create-panel,.projects-panel{padding:1.4rem;margin-top:.8rem}.panel-head{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.2rem}.panel-head h2{margin:.25rem 0 0;font-size:1.45rem}.panel-head p{max-width:400px;color:#77736d;font-size:.82rem;line-height:1.55}.panel-head.compact{align-items:center}.panel-head button{background:none;color:#999;border:1px solid var(--color-border);border-radius:.4rem;padding:.45rem .65rem;cursor:pointer}.source-tabs{display:flex;gap:.4rem;background:#090a09;padding:.3rem;border-radius:.55rem;margin-bottom:1rem;width:max-content}.source-tab{padding:.6rem .8rem;border:0;border-radius:.4rem;background:transparent;color:#85817b;font-weight:800;cursor:pointer}.source-tab.active{background:#1b1d19;color:#f1eee7}form label{display:grid;gap:.4rem;color:#9b978f;font-size:.73rem;font-weight:800}.wide input,.wide textarea,select{width:100%;padding:.78rem;border:1px solid var(--color-border);border-radius:.45rem;background:#090a09;color:#ece7de;font:inherit}.wide textarea{resize:vertical}.controls{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin-top:.8rem}.estimate{display:flex;justify-content:space-between;margin-top:1rem;padding:.8rem 0;border-top:1px solid #292722;border-bottom:1px solid #292722}.estimate strong{font-size:.84rem}.estimate b{color:#9fcfff}.form-actions{display:flex;gap:.6rem;margin-top:1rem}.form-actions button,.project-card button,.billing-panel button{padding:.7rem .85rem;border-radius:.45rem;font-weight:850;cursor:pointer}.save{background:#ece6da;color:#111;border:0}.generate{border:1px solid #33506b;background:#102033;color:#9fcfff}.generate:disabled,.project-card button:disabled,.billing-panel button:disabled{cursor:not-allowed;opacity:.5}.form-status{margin:.8rem 0 0;color:#c7a76a;font-size:.8rem}.project-list{display:grid;gap:.55rem}.project-card{display:grid;grid-template-columns:42px 1fr auto auto;align-items:center;gap:.8rem;padding:.8rem;border:1px solid #292722;border-radius:.55rem;background:#0c0d0c}.project-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:.45rem;background:#151b1e;color:#9fcfff}.project-card>div:nth-child(2){display:grid;gap:.2rem}.project-card span{color:#77736d;font-size:.72rem}.project-status{padding:.32rem .45rem;border:1px solid #3a342c;border-radius:99px;text-transform:capitalize}.project-card button{border:1px solid var(--color-border);background:#171815;color:#aaa}.empty{padding:2rem;text-align:center;color:#6d6962;border:1px dashed #35312b;border-radius:.55rem}.empty.error{color:#d39284}.billing-panel{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.4rem;margin-top:.8rem;background:linear-gradient(110deg,#111713,#101722)}.billing-panel h2{margin:.3rem 0}.billing-panel p{margin:0;max-width:760px;color:#7f7b74;line-height:1.6;font-size:.84rem}.billing-panel button{white-space:nowrap;background:#1b1c19;color:#8c8880;border:1px solid var(--color-border)}
  @media(max-width:900px){.studio-shell{grid-template-columns:1fr}.rail{display:none}.controls,.metrics{grid-template-columns:1fr 1fr}.workspace{padding-top:1.4rem}}
  @media(max-width:620px){.topbar,.panel-head,.billing-panel{display:block}.status-pills{margin-top:1rem}.metrics,.controls{grid-template-columns:1fr}.project-card{grid-template-columns:38px 1fr auto}.project-status{display:none}.project-card button{grid-column:2/4}.form-actions{display:grid}.billing-panel button{margin-top:1rem}}
</style>
