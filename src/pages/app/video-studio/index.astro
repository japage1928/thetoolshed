---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Video Studio" description="Create and manage AI video production projects." path="/app/video-studio" noindex>
  <div class="studio-app">
    <aside class="sidebar">
      <a class="brand" href="/tools/video-studio" aria-label="Video Studio product page">
        <span class="brand-mark">V</span>
        <span><strong>Video Studio</strong><small>by The Tool Shed</small></span>
      </a>
      <nav class="sidebar-nav" aria-label="Video Studio navigation">
        <a class="active" href="/app/video-studio"><span>＋</span>Create</a>
        <a href="#projects-section"><span>▤</span>Projects</a>
      </nav>
      <div class="sidebar-status">
        <span class="status-dot"></span>
        <div><strong id="sidebar-status-title">Internal beta</strong><small id="sidebar-status-copy">Rendering is paused</small></div>
      </div>
      <div class="sidebar-footer">
        <a href="/account">Account & billing <span>→</span></a>
        <a href="/support">Support <span>↗</span></a>
        <a href="/privacy-policy">Privacy <span>↗</span></a>
        <a href="/saas-tools">All SaaS tools <span>↗</span></a>
        <button id="logout" type="button">Sign out</button>
      </div>
    </aside>

    <div class="workspace">
      <header class="workspace-header">
        <div>
          <p class="breadcrumb">Video Studio <span>/</span> Create</p>
          <h1>Create a new video</h1>
          <p>Start with the product. The studio handles the production plan.</p>
        </div>
        <div class="account-usage"><span>Available credits</span><strong id="credit-balance">—</strong></div>
      </header>

      <section class="create-layout" aria-labelledby="create-heading">
        <article class="composer">
          <div class="composer-heading">
            <div><span class="step-number">01</span><h2 id="create-heading">Choose your starting point</h2></div>
            <span class="autosave-note">Saved as a project first</span>
          </div>

          <form id="project-form">
            <div class="source-tabs" role="group" aria-label="Project source">
              <button class="source-tab active" data-source="url" type="button">
                <span class="tab-icon">↗</span>
                <span><strong>Product URL</strong><small>Start from a product or business page</small></span>
              </button>
              <button class="source-tab" data-source="brief" type="button">
                <span class="tab-icon">¶</span>
                <span><strong>Creative brief</strong><small>Describe the campaign in your own words</small></span>
              </button>
            </div>

            <input id="source-type" name="sourceType" type="hidden" value="url" />
            <div class="primary-input" id="url-field">
              <label for="source-url">Paste the product or business URL</label>
              <div class="input-shell">
                <span>https://</span>
                <input id="source-url" name="sourceUrl" type="url" placeholder="yourstore.com/products/example" autocomplete="url" />
              </div>
              <small>We’ll use the page to build the concept, message, and shot plan.</small>
            </div>
            <div class="primary-input" id="brief-field" hidden>
              <label for="creative-brief">What should the video communicate?</label>
              <textarea id="creative-brief" name="brief" rows="6" placeholder="Example: Create a direct-response video for a portable espresso maker. Open with the frustration of bad road coffee, show the product working inside a truck cab, and end with a clear shop-now call to action."></textarea>
              <small>Include the product, audience, offer, and desired outcome. Plain English is fine.</small>
            </div>

            <div class="project-title-row">
              <label for="project-title">Project name <span>Optional</span></label>
              <input id="project-title" name="title" type="text" maxlength="120" placeholder="The studio can name it for you" />
            </div>

            <div class="direction-heading"><span class="step-number">02</span><h2>Set the direction</h2></div>
            <div class="controls">
              <label>Goal<select name="objective"><option>Create product interest</option><option>Drive clicks</option><option>Explain the offer</option><option>Build trust</option></select></label>
              <label>Platform<select name="platform"><option>TikTok / Reels / Shorts</option><option>YouTube</option><option>X</option><option>Facebook</option><option>Pinterest</option></select></label>
              <label>Duration<select name="durationSeconds"><option value="15">15 seconds</option><option value="30" selected>30 seconds</option><option value="45">45 seconds</option><option value="60">60 seconds</option></select></label>
              <label>Format<select name="aspectRatio"><option value="9:16">Vertical · 9:16</option><option value="1:1">Square · 1:1</option><option value="16:9">Landscape · 16:9</option></select></label>
            </div>

            <details class="advanced">
              <summary>Advanced output settings <span>＋</span></summary>
              <div>
                <label>Resolution<select name="resolution"><option value="480p">480p · economical</option><option value="720p">720p · balanced</option><option value="1080p">1080p · premium</option></select></label>
                <p>Higher resolution uses more credits. Model routing and prompt engineering remain automatic.</p>
              </div>
            </details>

            <div class="form-footer">
              <div class="estimate"><span>Estimated cost</span><strong><b id="estimate">10</b> credits</strong></div>
              <div class="form-actions">
                <button class="save" type="submit">Save project</button>
                <button class="generate" id="generate-button" type="button">Save & verify product</button>
              </div>
            </div>
            <p id="form-status" class="form-status" hidden aria-live="polite"></p>
          </form>
        </article>

        <aside class="production-summary" aria-label="Production summary">
          <div class="summary-label"><span>PRODUCTION PLAN</span><b>Draft</b></div>
          <div class="format-preview">
            <div class="preview-frame">
              <span>YOUR VIDEO</span><div class="preview-focus"></div><small id="summary-format">9:16 · 30 sec</small>
            </div>
          </div>
          <div class="summary-meta">
            <div><span>Source</span><strong id="summary-source">Product URL</strong></div>
            <div><span>Destination</span><strong id="summary-platform">TikTok / Reels / Shorts</strong></div>
            <div><span>Output</span><strong id="summary-output">480p economical</strong></div>
          </div>
          <ol class="pipeline">
            <li class="ready"><span></span><div><strong>Brief</strong><small>Your input</small></div></li>
            <li><span></span><div><strong>Plan</strong><small>Script and shots</small></div></li>
            <li><span></span><div><strong>Generate</strong><small>Scene production</small></div></li>
            <li><span></span><div><strong>Review</strong><small>QA and repair</small></div></li>
            <li><span></span><div><strong>Assemble</strong><small>Ready to publish</small></div></li>
          </ol>
          <div class="system-lock"><span></span><div><strong>Rendering is safely paused</strong><small>You can build and save projects without triggering paid video calls.</small></div></div>
        </aside>
      </section>

      <section class="projects-section" id="projects-section">
        <div class="section-header">
          <div><span class="section-kicker">PROJECT LIBRARY</span><h2>Recent projects</h2><p><strong id="project-count">—</strong> active projects</p></div>
          <button id="refresh" type="button">Refresh</button>
        </div>
        <div id="projects" class="project-list"><p class="empty">Loading your projects…</p></div>
      </section>

      <section class="environment-note" aria-label="Internal beta safeguards">
        <span class="note-mark">i</span>
        <div><strong>Internal beta environment</strong><p>Stripe is wired in test mode but disabled. The generation workflow is isolated until credit reconciliation and cost controls are approved.</p></div>
        <span id="billing-pill">Billing off</span>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const projectList = document.querySelector<HTMLElement>('#projects');
  const form = document.querySelector<HTMLFormElement>('#project-form');
  const formStatus = document.querySelector<HTMLElement>('#form-status');
  const generationButton = document.querySelector<HTMLButtonElement>('#generate-button');
  const estimate = document.querySelector<HTMLElement>('#estimate');
  let currentProjects: Array<Record<string, any>> = [];
  let generationEnabled = false;
  let submitIntent: 'save' | 'generate' = 'save';
  const field = (name: string) => form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;

  const creditEstimate = () => {
    const duration = Number(field('durationSeconds')?.value || 30);
    const resolution = String(field('resolution')?.value || '480p');
    const multiplier = resolution === '1080p' ? 2.5 : resolution === '720p' ? 1.5 : 1;
    return Math.ceil(5 * Math.ceil(duration / 15) * multiplier);
  };

  const updateSummary = () => {
    if (estimate) estimate.textContent = String(creditEstimate());
    const duration = field('durationSeconds')?.value || '30';
    const format = field('aspectRatio')?.value || '9:16';
    const platform = field('platform')?.value || 'TikTok / Reels / Shorts';
    const resolution = field('resolution') as HTMLSelectElement | null;
    const source = field('sourceType')?.value === 'brief' ? 'Creative brief' : 'Product URL';
    const summaryFormat = document.querySelector('#summary-format');
    const summaryPlatform = document.querySelector('#summary-platform');
    const summaryOutput = document.querySelector('#summary-output');
    const summarySource = document.querySelector('#summary-source');
    if (summaryFormat) summaryFormat.textContent = `${format} · ${duration} sec`;
    if (summaryPlatform) summaryPlatform.textContent = platform;
    if (summaryOutput) summaryOutput.textContent = resolution?.selectedOptions[0]?.textContent || '480p economical';
    if (summarySource) summarySource.textContent = source;
  };

  function escapeHtml(value: unknown) {
    const node = document.createElement('span');
    node.textContent = String(value ?? '');
    return node.innerHTML;
  }

  function projectDate(value: unknown) {
    const date = new Date(String(value || ''));
    return Number.isNaN(date.valueOf()) ? '' : new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' }).format(date);
  }

  function renderProjects() {
    if (!projectList) return;
    if (!currentProjects.length) {
      projectList.innerHTML = '<div class="empty"><strong>No projects yet</strong><span>Your first saved production will appear here.</span></div>';
      return;
    }
    projectList.innerHTML = currentProjects.map((project) => `
      <article class="project-card">
        <div class="project-thumb"><span>${project.source_type === 'url' ? 'URL' : 'BRIEF'}</span><b>${escapeHtml(project.aspect_ratio || '9:16')}</b></div>
        <div class="project-info"><strong>${escapeHtml(project.title)}</strong><span>${escapeHtml(project.platform)} · ${project.duration_seconds}s · ${escapeHtml(project.resolution)}</span></div>
        <span class="project-date">${projectDate(project.updated_at)}</span>
        <span class="project-status"><i></i>${escapeHtml(project.status)}</span>
        <div class="project-actions">
          <button type="button" data-open="${project.id}">Open project</button>
          <button type="button" class="delete-project" data-delete="${project.id}">Delete</button>
        </div>
      </article>`).join('');
  }

  async function loadProjects() {
    if (projectList) projectList.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch('/api/video-studio/projects', { headers: { accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to load projects.');
      currentProjects = data.projects || [];
      generationEnabled = Boolean(data.generationEnabled);
      const credits = document.querySelector('#credit-balance');
      const count = document.querySelector('#project-count');
      const billingPill = document.querySelector('#billing-pill');
      const sidebarTitle = document.querySelector('#sidebar-status-title');
      const sidebarCopy = document.querySelector('#sidebar-status-copy');
      if (credits) credits.textContent = String(data.credits ?? 0);
      if (count) count.textContent = String(currentProjects.filter((item) => item.status !== 'archived').length);
      if (billingPill) billingPill.textContent = data.billingEnabled ? 'Billing test mode' : 'Billing off';
      if (sidebarTitle) sidebarTitle.textContent = generationEnabled ? 'Studio ready' : 'Internal beta';
      if (sidebarCopy) sidebarCopy.textContent = generationEnabled ? 'Rendering available' : 'Rendering is paused';
      if (generationButton) {
        generationButton.disabled = false;
        generationButton.textContent = 'Save & verify product';
      }
      renderProjects();
    } catch (error) {
      if (projectList) projectList.innerHTML = `<div class="empty error"><strong>Projects unavailable</strong><span>${escapeHtml(error instanceof Error ? error.message : 'Unable to load projects.')}</span></div>`;
    } finally {
      projectList?.removeAttribute('aria-busy');
    }
  }

  function selectSource(source: 'url' | 'brief') {
    document.querySelectorAll('.source-tab').forEach((item) => item.classList.toggle('active', (item as HTMLElement).dataset.source === source));
    const sourceInput = document.querySelector<HTMLInputElement>('#source-type');
    const urlField = document.querySelector<HTMLElement>('#url-field');
    const briefField = document.querySelector<HTMLElement>('#brief-field');
    if (sourceInput) sourceInput.value = source;
    if (urlField) urlField.hidden = source !== 'url';
    if (briefField) briefField.hidden = source !== 'brief';
    updateSummary();
  }

  document.querySelectorAll<HTMLButtonElement>('.source-tab').forEach((button) => button.addEventListener('click', () => selectSource(button.dataset.source === 'brief' ? 'brief' : 'url')));
  form?.addEventListener('change', updateSummary);
  generationButton?.addEventListener('click', () => {
    submitIntent = 'generate';
    form?.requestSubmit();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const intent = submitIntent;
    submitIntent = 'save';
    if (submit) submit.disabled = true;
    if (generationButton) generationButton.disabled = true;
    if (formStatus) {
      formStatus.hidden = false;
      formStatus.dataset.tone = 'progress';
      formStatus.textContent = intent === 'generate' ? 'Saving a clean project, then opening verification…' : 'Saving project…';
    }
    try {
      const raw = Object.fromEntries(new FormData(form).entries());
      const payload = { ...raw, durationSeconds: Number(raw.durationSeconds) };
      const response = await fetch('/api/video-studio/projects', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to save the project.');
      if (intent === 'generate') {
        window.location.href = `/app/video-studio/projects/${data.project.id}`;
        return;
      }
      if (formStatus) {
        formStatus.dataset.tone = 'success';
        formStatus.textContent = 'Project saved. Open it to verify the product before generating.';
      }
      form.reset();
      selectSource('url');
      updateSummary();
      await loadProjects();
    } catch (error) {
      if (formStatus) {
        formStatus.dataset.tone = 'error';
        formStatus.textContent = error instanceof Error ? error.message : 'Unable to save the project.';
      }
    } finally {
      if (submit) submit.disabled = false;
      if (generationButton) generationButton.disabled = false;
    }
  });

  projectList?.addEventListener('click', async (event) => {
    const deleteButton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete]');
    if (deleteButton) {
      const project = currentProjects.find((item) => item.id === deleteButton.dataset.delete);
      if (!project || !window.confirm(`Delete “${project.title}” and its generation history? This cannot be undone.`)) return;
      deleteButton.disabled = true;
      deleteButton.textContent = 'Deleting…';
      try {
        const response = await fetch('/api/video-studio/projects', {
          method: 'DELETE',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ projectId: project.id }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Unable to delete the project.');
        await loadProjects();
      } catch (error) {
        deleteButton.textContent = error instanceof Error ? error.message : 'Delete failed';
        setTimeout(() => renderProjects(), 2200);
      }
      return;
    }
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-open]');
    if (!button || button.disabled) return;
    const project = currentProjects.find((item) => item.id === button.dataset.open);
    if (!project) return;
    window.location.href = `/app/video-studio/projects/${project.id}`;
  });

  document.querySelector('#refresh')?.addEventListener('click', loadProjects);
  document.querySelector('#logout')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
    window.location.href = '/account?next=/app/video-studio';
  });
  updateSummary();
  loadProjects();
</script>

<style>
  :global(.site-header),:global(.site-footer){display:none}
  :global(body){margin:0;background:#f2f0ea;color:#191918}
  :global(main){min-height:100vh}
  .studio-app{--ink:#191918;--muted:#716e67;--faint:#9c9890;--canvas:#f2f0ea;--surface:#fffefa;--line:#d8d4cb;--dark:#181816;--blue:#2556d8;--blue-soft:#e9efff;min-height:100vh;display:grid;grid-template-columns:236px minmax(0,1fr);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  .sidebar{position:sticky;top:0;height:100vh;box-sizing:border-box;padding:1.5rem 1.1rem;background:var(--dark);color:#f4f1e9;display:flex;flex-direction:column}
  .brand{display:flex;align-items:center;gap:.75rem;color:inherit;text-decoration:none}.brand-mark{display:grid;place-items:center;width:2.15rem;height:2.15rem;background:#f4f1e9;color:#191918;font-size:.85rem;font-weight:900}.brand>span:last-child{display:grid;gap:.08rem}.brand strong{font-size:.88rem;letter-spacing:-.01em}.brand small{color:#88867f;font-size:.64rem}
  .sidebar-nav{display:grid;gap:.3rem;margin-top:3rem}.sidebar-nav a{display:flex;align-items:center;gap:.7rem;padding:.72rem .75rem;color:#95938d;text-decoration:none;border-left:2px solid transparent;font-size:.8rem;font-weight:700}.sidebar-nav a span{width:1rem;text-align:center;color:#6e6c67}.sidebar-nav a:hover{color:#f4f1e9}.sidebar-nav a.active{border-left-color:#f4f1e9;background:#22221f;color:#f4f1e9}
  .sidebar-status{display:flex;align-items:center;gap:.65rem;margin-top:auto;padding:.9rem .75rem;border-top:1px solid #2d2d29;border-bottom:1px solid #2d2d29}.status-dot{width:.48rem;height:.48rem;border-radius:50%;background:#c99638}.sidebar-status div{display:grid;gap:.12rem}.sidebar-status strong{font-size:.7rem}.sidebar-status small{color:#77756f;font-size:.62rem}
  .sidebar-footer{display:grid;gap:.25rem;margin-top:1rem}.sidebar-footer a,.sidebar-footer button{display:flex;justify-content:space-between;padding:.62rem .75rem;color:#88867f;background:none;border:0;text-decoration:none;font:inherit;font-size:.7rem;text-align:left;cursor:pointer}.sidebar-footer a:hover,.sidebar-footer button:hover{color:#f4f1e9}
  .workspace{width:min(1320px,100%);box-sizing:border-box;padding:2.25rem clamp(1.25rem,4vw,4rem) 5rem}
  .workspace-header{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;margin-bottom:2rem}.breadcrumb{margin:0 0 1.2rem;color:#8a867e;font-size:.68rem;font-weight:750}.breadcrumb span{margin:0 .35rem;color:#bbb6ad}.workspace-header h1{margin:0;font-size:clamp(2rem,4vw,3.2rem);line-height:1;letter-spacing:-.05em}.workspace-header>div>p:last-child{margin:.7rem 0 0;color:var(--muted);font-size:.9rem}.account-usage{min-width:130px;padding-left:1.2rem;border-left:1px solid var(--line);display:grid;gap:.18rem}.account-usage span{color:var(--muted);font-size:.65rem}.account-usage strong{font-size:1.65rem;letter-spacing:-.04em}
  .create-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:1rem;align-items:start}.composer,.production-summary,.projects-section,.environment-note{border:1px solid var(--line);background:var(--surface)}.composer{padding:clamp(1.25rem,3vw,2rem)}
  .composer-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}.composer-heading>div,.direction-heading{display:flex;align-items:center;gap:.7rem}.step-number{display:grid;place-items:center;width:1.65rem;height:1.65rem;background:var(--ink);color:#fff;font-size:.6rem;font-weight:850}.composer h2{margin:0;font-size:1rem;letter-spacing:-.015em}.autosave-note{color:var(--faint);font-size:.63rem}
  .source-tabs{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-bottom:1.4rem}.source-tab{display:flex;align-items:center;gap:.75rem;min-height:78px;padding:.85rem;border:1px solid var(--line);background:#faf9f5;color:var(--ink);text-align:left;cursor:pointer}.source-tab:hover{border-color:#aaa59b}.source-tab.active{border-color:var(--blue);background:var(--blue-soft);box-shadow:inset 0 0 0 1px var(--blue)}.source-tab .tab-icon{display:grid;place-items:center;width:2rem;height:2rem;background:#e3e0d8;color:#55524c;font-weight:800}.source-tab.active .tab-icon{background:var(--blue);color:#fff}.source-tab>span:last-child{display:grid;gap:.2rem}.source-tab strong{font-size:.76rem}.source-tab small{color:var(--muted);font-size:.62rem;line-height:1.35}
  .primary-input label,.project-title-row label,.controls label,.advanced label{display:grid;gap:.45rem;color:#4f4c46;font-size:.68rem;font-weight:800}.primary-input>small{display:block;margin-top:.45rem;color:var(--faint);font-size:.62rem}.input-shell{display:grid;grid-template-columns:auto 1fr;align-items:center;border:1px solid #bfbab0;background:#fff}.input-shell:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,86,216,.1)}.input-shell>span{padding-left:.85rem;color:#9a968e;font-size:.82rem}.input-shell input{border:0!important;outline:0!important;box-shadow:none!important}
  .primary-input input,.primary-input textarea,.project-title-row input,.controls select,.advanced select{box-sizing:border-box;width:100%;padding:.82rem .85rem;border:1px solid #bfbab0;border-radius:0;background:#fff;color:var(--ink);font:inherit;font-size:.8rem;outline:none}.primary-input textarea{resize:vertical;min-height:145px;line-height:1.55}.primary-input textarea:focus,.project-title-row input:focus,.controls select:focus,.advanced select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,86,216,.1)}
  .project-title-row{margin-top:1rem}.project-title-row label span{color:var(--faint);font-weight:500}.direction-heading{margin:2rem 0 .9rem;padding-top:1.5rem;border-top:1px solid var(--line)}.controls{display:grid;grid-template-columns:1.2fr 1.2fr .8fr .9fr;gap:.65rem}.controls label,.advanced label{gap:.4rem}.controls select,.advanced select{appearance:auto;padding:.72rem .65rem}
