---
import StudioShell from '../../../components/video-studio/StudioShell.astro';
---
<StudioShell title="Dashboard" section="dashboard">
  <div class="page-head"><div><h1>Dashboard</h1><p>Create videos and pick up where you left off.</p></div></div>
  <section class="grid stats" id="stats"><div class="card stat"><span class="muted">Available credits</span><strong id="credits">—</strong></div><div class="card stat"><span class="muted">Projects</span><strong id="project-count">—</strong></div><div class="card stat"><span class="muted">Completed videos</span><strong id="completed-count">—</strong></div></section>
  <section class="card" style="margin-top:18px"><div class="page-head"><div><h2 style="margin:0">New project</h2><p>Start from a product URL or a plain-English brief.</p></div></div>
    <form id="new-project" class="form-grid">
      <div class="field"><label>Starting point<select name="sourceType"><option value="url">Product or business URL</option><option value="brief">Creative brief</option></select></label></div>
      <div class="field"><label>Project name<input name="title" placeholder="Optional" maxlength="120" /></label></div>
      <div class="field full" id="url-field"><label>URL<input name="sourceUrl" type="url" placeholder="https://example.com/product" /></label></div>
      <div class="field full" id="brief-field" hidden><label>Creative brief<textarea name="brief" rows="4" placeholder="Describe the product, audience, message, and desired outcome."></textarea></label></div>
      <div class="field"><label>Goal<select name="objective"><option>Create product interest</option><option>Drive clicks</option><option>Explain the offer</option><option>Build trust</option></select></label></div>
      <div class="field"><label>Platform<select name="platform"><option>TikTok / Reels / Shorts</option><option>YouTube</option><option>X</option><option>Facebook</option></select></label></div>
      <div class="field"><label>Duration<select name="durationSeconds"><option value="15">15 seconds</option><option value="30">30 seconds</option><option value="45">45 seconds</option><option value="60">60 seconds</option></select></label></div>
      <div class="field"><label>Resolution<select name="resolution"><option value="480p">480p</option><option value="720p">720p</option><option value="1080p">1080p</option></select></label></div>
      <input type="hidden" name="aspectRatio" value="9:16" />
      <div class="field full" style="display:flex;flex-direction:row;justify-content:flex-end;gap:10px"><button class="btn" name="intent" value="save" type="submit">Save project</button><button class="btn" name="intent" value="generate" type="submit">Save & generate</button></div>
      <p id="form-status" class="muted field full" style="margin:0"></p>
    </form>
  </section>
  <section style="margin-top:24px"><div class="page-head"><div><h2 style="margin:0">Recent projects</h2><p>Your latest work.</p></div><a class="btn" href="/app/video-studio/projects">View all</a></div><div id="recent" class="table"><div class="empty">Loading…</div></div></section>
</StudioShell>
<script>
  const esc=(v)=>{const s=document.createElement('span');s.textContent=String(v??'');return s.innerHTML};
  const form=document.querySelector('#new-project'); const source=form?.elements.namedItem('sourceType');
  source?.addEventListener('change',()=>{const brief=source.value==='brief';document.querySelector('#brief-field').hidden=!brief;document.querySelector('#url-field').hidden=brief;});
  async function load(){const [a,p]=await Promise.all([fetch('/api/video-studio/account'),fetch('/api/video-studio/projects')]); if(!a.ok||!p.ok)return; const ad=await a.json(),pd=await p.json(); document.querySelector('#credits').textContent=ad.credits??0;document.querySelector('#project-count').textContent=ad.projectCount??0;document.querySelector('#completed-count').textContent=ad.usage?.completed_generations??0;const recent=document.querySelector('#recent');const rows=(pd.projects||[]).slice(0,5);recent.innerHTML=rows.length?rows.map(x=>`<a class="row" href="/app/video-studio/projects/${x.id}"><strong>${esc(x.title)}</strong><small class="hide-mobile">${esc(x.platform)} · ${x.duration_seconds}s</small><span class="status">${esc(x.status)}</span><small>${new Date(x.updated_at).toLocaleDateString()}</small></a>`).join(''):'<div class="empty">No projects yet.</div>';}
  form?.addEventListener('submit',async(e)=>{e.preventDefault();const fd=new FormData(form);const submit=e.submitter;const intent=submit?.value||'save';const body=Object.fromEntries(fd.entries());const status=document.querySelector('#form-status');status.textContent='Saving…';const r=await fetch('/api/video-studio/projects',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok){status.textContent=d.error||'Unable to save project.';return;}if(intent==='generate'){status.textContent='Reserving credits and starting generation…';const g=await fetch('/api/video-studio/generate',{method:'POST',headers:{'content-type':'application/json','idempotency-key':crypto.randomUUID()},body:JSON.stringify({projectId:d.project.id,durationSeconds:Number(body.durationSeconds),resolution:body.resolution})});const gd=await g.json();if(!g.ok){status.textContent=gd.error||'Project saved, but generation could not start.';await load();return;}}location.href=`/app/video-studio/projects/${d.project.id}`;});
  load();
</script>