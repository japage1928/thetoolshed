---
import StudioShell from '../../../components/video-studio/StudioShell.astro';
---

<StudioShell title="Dashboard" section="dashboard">
  <div class="vs-page-head">
    <div>
      <h1 class="vs-h1">Dashboard</h1>
      <p class="vs-subtitle">Create, manage, and generate product videos.</p>
    </div>
    <div class="vs-page-head__actions">
      <a class="vs-btn vs-btn--primary vs-btn--block" href="#create">New Video</a>
    </div>
  </div>

  <!-- Metrics -->
  <section class="vs-metrics" aria-label="Account overview">
    <div class="vs-metric">
      <span class="vs-metric__label">Available credits</span>
      <strong class="vs-metric__value" id="metric-credits">—</strong>
    </div>
    <div class="vs-metric">
      <span class="vs-metric__label">Projects</span>
      <strong class="vs-metric__value" id="metric-projects">—</strong>
    </div>
    <div class="vs-metric">
      <span class="vs-metric__label">Completed videos</span>
      <strong class="vs-metric__value" id="metric-completed">—</strong>
    </div>
    <div class="vs-metric">
      <span class="vs-metric__label">Credits used</span>
      <strong class="vs-metric__value" id="metric-used">—</strong>
    </div>
  </section>

  <!-- Create new video -->
  <section class="vs-card create-card" id="create" aria-labelledby="create-heading">
    <div class="vs-card__head">
      <div class="vs-card__title-group">
        <h2 class="vs-h2" id="create-heading">Create a new video</h2>
        <p class="vs-help">Start from a product page or describe the campaign yourself.</p>
      </div>
    </div>

    <form id="project-form" novalidate>
      <div class="vs-field">
        <span class="vs-label" id="source-label">Source</span>
        <div class="vs-segmented" role="group" aria-labelledby="source-label">
          <button class="vs-segmented__option" type="button" data-source="url" aria-pressed="true">
            Product URL
            <small>From a product page</small>
          </button>
          <button class="vs-segmented__option" type="button" data-source="brief" aria-pressed="false">
            Creative Brief
            <small>Describe it yourself</small>
          </button>
        </div>
      </div>

      <input id="source-type" name="sourceType" type="hidden" value="url" />

      <div class="vs-field create-card__source" id="url-field">
        <label class="vs-label" for="source-url">Product or business URL</label>
        <div class="vs-input-group">
          <span class="vs-input-group__prefix">https://</span>
          <input class="vs-input" id="source-url" name="sourceUrl" type="url" placeholder="yourstore.com/products/example" autocomplete="url" inputmode="url" />
        </div>
        <p class="vs-help">We use the page to build the concept, message, and shot plan.</p>
      </div>

      <div class="vs-field create-card__source" id="brief-field" hidden>
        <label class="vs-label" for="creative-brief">What should the video communicate?</label>
        <textarea class="vs-textarea" id="creative-brief" name="brief" rows="6" placeholder="Example: Create a direct-response video for a portable espresso maker. Open with the frustration of bad road coffee, show the product working inside a truck cab, and end with a clear shop-now call to action."></textarea>
        <p class="vs-help">Include the product, audience, offer, and desired outcome. Plain English is fine.</p>
      </div>

      <div class="vs-field create-card__title">
        <label class="vs-label" for="project-title">
          Project name
          <span class="vs-label__optional">Optional</span>
        </label>
        <input class="vs-input" id="project-title" name="title" type="text" maxlength="120" placeholder="The studio can name it for you" />
      </div>

      <hr class="vs-divider" />

      <div class="vs-form-grid vs-form-grid--2">
        <div class="vs-field">
          <label class="vs-label" for="field-objective">Goal</label>
          <select class="vs-select" id="field-objective" name="objective">
            <option>Create product interest</option>
            <option>Drive clicks</option>
            <option>Explain the offer</option>
            <option>Build trust</option>
          </select>
        </div>
        <div class="vs-field">
          <label class="vs-label" for="field-platform">Platform</label>
          <select class="vs-select" id="field-platform" name="platform">
            <option>TikTok / Reels / Shorts</option>
            <option>YouTube</option>
            <option>X</option>
            <option>Facebook</option>
            <option>Pinterest</option>
          </select>
        </div>
        <div class="vs-field">
          <label class="vs-label" for="field-duration">Duration</label>
          <select class="vs-select" id="field-duration" name="durationSeconds">
            <option value="15">15 seconds</option>
            <option value="30" selected>30 seconds</option>
            <option value="45">45 seconds</option>
            <option value="60">60 seconds</option>
          </select>
        </div>
        <div class="vs-field">
          <label class="vs-label" for="field-aspect">Format</label>
          <select class="vs-select" id="field-aspect" name="aspectRatio">
            <option value="9:16">Vertical · 9:16</option>
            <option value="1:1">Square · 1:1</option>
            <option value="16:9">Landscape · 16:9</option>
          </select>
        </div>
        <div class="vs-field">
          <label class="vs-label" for="field-resolution">Resolution</label>
          <select class="vs-select" id="field-resolution" name="resolution">
            <option value="480p">480p · economical</option>
            <option value="720p">720p · balanced</option>
            <option value="1080p">1080p · premium</option>
          </select>
          <p class="vs-help">Higher resolution uses more credits.</p>
        </div>
      </div>

      <div class="create-card__footer">
        <div class="create-card__estimate">
          <span class="vs-metric__label">Estimated cost</span>
          <strong><span id="estimate">10</span> credits</strong>
        </div>
        <div class="create-card__actions">
          <button class="vs-btn vs-btn--secondary vs-btn--block" id="save-only" type="button">Save &amp; add another</button>
          <button class="vs-btn vs-btn--primary vs-btn--block" type="submit">Create Project</button>
        </div>
      </div>

      <p id="form-status" class="vs-status-msg" hidden aria-live="polite"></p>
    </form>
  </section>

  <!-- Recent projects -->
  <section class="projects-section" id="projects-section" aria-labelledby="projects-heading">
    <div class="vs-page-head projects-section__head">
      <div>
        <h2 class="vs-h2" id="projects-heading">Recent projects</h2>
        <p class="vs-help"><span id="project-count">—</span> active projects</p>
      </div>
      <div class="vs-page-head__actions">
        <button class="vs-btn vs-btn--ghost vs-btn--sm" id="refresh" type="button">Refresh</button>
        <a class="vs-btn vs-btn--secondary vs-btn--sm" href="/app/video-studio/projects">View all</a>
      </div>
    </div>
    <div id="projects" class="project-grid">
      <div class="vs-empty"><p class="vs-empty__body">Loading your projects…</p></div>
    </div>
  </section>
</StudioShell>

<script>
  const projectList = document.querySelector<HTMLElement>('#projects');
  const form = document.querySelector<HTMLFormElement>('#project-form');
  const formStatus = document.querySelector<HTMLElement>('#form-status');
  const saveOnlyButton = document.querySelector<HTMLButtonElement>('#save-only');
  const estimate = document.querySelector<HTMLElement>('#estimate');

  let currentProjects: Array<Record<string, any>> = [];
  /* 'create' navigates to the project workspace; 'save' stays on the dashboard. */
  let submitIntent: 'create' | 'save' = 'create';

  const field = (name: string) =>
    form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;

  /* Mirrors estimateCredits() in src/lib/video-studio/server.ts. The server
     remains authoritative; this is display-only. */
  const creditEstimate = () => {
    const duration = Number(field('durationSeconds')?.value || 30);
    const resolution = String(field('resolution')?.value || '480p');
    const multiplier = resolution === '1080p' ? 2.5 : resolution === '720p' ? 1.5 : 1;
    return Math.ceil(5 * Math.ceil(duration / 15) * multiplier);
  };

  const updateEstimate = () => {
    if (estimate) estimate.textContent = String(creditEstimate());
  };

  function escapeHtml(value: unknown) {
    const node = document.createElement('span');
    node.textContent = String(value ?? '');
    return node.innerHTML;
  }

  function projectDate(value: unknown) {
    const date = new Date(String(value || ''));
    return Number.isNaN(date.valueOf())
      ? ''
      : new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' }).format(date);
  }

  /* Maps the project's own status to a badge tone. */
  function statusTone(status: string) {
    if (status === 'ready_to_generate') return 'success';
    if (status === 'generating') return 'info';
    if (status === 'failed') return 'danger';
    return '';
  }

  function statusLabel(status: string) {
    return String(status || '').replace(/_/g, ' ');
  }

  /* Verification state derived from existing identity fields only. */
  function verificationBadge(project: Record<string, any>) {
    const confidence = Number(project.product_identity_confidence || 0);
    const status = project.product_identity_status;
    if (status === 'verified' && confidence >= 0.8) {
      return `<span class="vs-badge vs-badge--success"><i class="vs-badge__dot"></i>Verified</span>`;
    }
    if (status === 'verified' && confidence > 0) {
      return `<span class="vs-badge vs-badge--warning"><i class="vs-badge__dot"></i>Low confidence</span>`;
    }
    if (confidence > 0) {
      return `<span class="vs-badge vs-badge--warning"><i class="vs-badge__dot"></i>Needs attention</span>`;
    }
    return `<span class="vs-badge"><i class="vs-badge__dot"></i>Verification required</span>`;
  }

  function renderProjects() {
    if (!projectList) return;
    if (!currentProjects.length) {
      projectList.innerHTML = `
        <div class="vs-empty">
          <p class="vs-empty__title">No projects yet</p>
          <p class="vs-empty__body">Your first saved production will appear here.</p>
        </div>`;
      return;
    }
    projectList.innerHTML = currentProjects
      .map((project) => {
        const tone = statusTone(project.status);
        return `
      <article class="project-card">
        <a class="project-card__open" href="/app/video-studio/projects/${encodeURIComponent(project.id)}">
          <span class="project-card__thumb" aria-hidden="true">
            <span>${project.source_type === 'url' ? 'URL' : 'BRIEF'}</span>
            <b>${escapeHtml(project.aspect_ratio || '9:16')}</b>
          </span>
          <span class="project-card__body">
            <strong class="project-card__title">${escapeHtml(project.title)}</strong>
            <span class="project-card__meta">${escapeHtml(project.platform)} · ${escapeHtml(project.duration_seconds)}s · ${escapeHtml(project.resolution)}</span>
            <span class="project-card__badges">
              <span class="vs-badge${tone ? ` vs-badge--${tone}` : ''}"><i class="vs-badge__dot"></i>${escapeHtml(statusLabel(project.status))}</span>
              ${verificationBadge(project)}
            </span>
          </span>
        </a>
        <div class="project-card__foot">
          <span class="vs-faint project-card__date">Updated ${escapeHtml(projectDate(project.updated_at))}</span>
          <button class="vs-btn vs-btn--danger vs-btn--sm" type="button" data-delete="${encodeURIComponent(project.id)}">Delete</button>
        </div>
      </article>`;
      })
      .join('');
  }

  async function loadProjects() {
    if (projectList) projectList.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch('/api/video-studio/projects', { headers: { accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to load projects.');
      currentProjects = data.projects || [];

      const activeCount = currentProjects.filter((item) => item.status !== 'archived').length;
      const count = document.querySelector('#project-count');
      const metricCredits = document.querySelector('#metric-credits');
      const metricProjects = document.querySelector('#metric-projects');
      if (count) count.textContent = String(activeCount);
      if (metricCredits) metricCredits.textContent = String(data.credits ?? 0);
      if (metricProjects) metricProjects.textContent = String(activeCount);

      renderProjects();
    } catch (error) {
      if (projectList) {
        projectList.innerHTML = `
          <div class="vs-empty vs-empty--error">
            <p class="vs-empty__title">Projects unavailable</p>
            <p class="vs-empty__body">${escapeHtml(error instanceof Error ? error.message : 'Unable to load projects.')}</p>
          </div>`;
      }
    } finally {
      projectList?.removeAttribute('aria-busy');
    }
  }

  /* Completed-video and credits-used metrics come from the account endpoint. */
  async function loadUsage() {
    try {
      const response = await fetch('/api/video-studio/account', { headers: { accept: 'application/json' } });
      if (!response.ok) return;
      const data = await response.json();
      const completed = document.querySelector('#metric-completed');
      const used = document.querySelector('#metric-used');
      if (completed) completed.textContent = String(data.usage?.completed_generations ?? 0);
      if (used) used.textContent = String(data.usage?.credits_used ?? 0);
    } catch {
      /* Metrics are supplementary; the dashboard still works without them. */
    }
  }

  function selectSource(source: 'url' | 'brief') {
    document.querySelectorAll<HTMLButtonElement>('.vs-segmented__option').forEach((item) => {
      item.setAttribute('aria-pressed', String(item.dataset.source === source));
    });
    const sourceInput = document.querySelector<HTMLInputElement>('#source-type');
    const urlField = document.querySelector<HTMLElement>('#url-field');
    const briefField = document.querySelector<HTMLElement>('#brief-field');
    if (sourceInput) sourceInput.value = source;
    if (urlField) urlField.hidden = source !== 'url';
    if (briefField) briefField.hidden = source !== 'brief';
  }

  document.querySelectorAll<HTMLButtonElement>('.vs-segmented__option').forEach((button) => {
    button.addEventListener('click', () => selectSource(button.dataset.source === 'brief' ? 'brief' : 'url'));
  });

  form?.addEventListener('change', updateEstimate);

  saveOnlyButton?.addEventListener('click', () => {
    submitIntent = 'save';
    form?.requestSubmit();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const intent = submitIntent;
    submitIntent = 'create';
    if (submit) submit.disabled = true;
    if (saveOnlyButton) saveOnlyButton.disabled = true;
    if (formStatus) {
      formStatus.hidden = false;
      formStatus.dataset.tone = 'progress';
      formStatus.textContent = intent === 'create' ? 'Creating project…' : 'Saving project…';
    }
    try {
      const raw = Object.fromEntries(new FormData(form).entries());
      const payload = { ...raw, durationSeconds: Number(raw.durationSeconds) };
      const response = await fetch('/api/video-studio/projects', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to save the project.');
      if (intent === 'create') {
        window.location.href = `/app/video-studio/projects/${data.project.id}`;
        return;
      }
      if (formStatus) {
        formStatus.dataset.tone = 'success';
        formStatus.textContent = 'Project saved. Open it to verify the product before generating.';
      }
      form.reset();
      selectSource('url');
      updateEstimate();
      await Promise.all([loadProjects(), loadUsage()]);
    } catch (error) {
      if (formStatus) {
        formStatus.dataset.tone = 'error';
        formStatus.textContent = error instanceof Error ? error.message : 'Unable to save the project.';
      }
    } finally {
      if (submit) submit.disabled = false;
      if (saveOnlyButton) saveOnlyButton.disabled = false;
    }
  });

  projectList?.addEventListener('click', async (event) => {
    const deleteButton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete]');
    if (!deleteButton) return;
    event.preventDefault();
    const projectId = decodeURIComponent(deleteButton.dataset.delete || '');
    const project = currentProjects.find((item) => item.id === projectId);
    if (!project) return;
    if (!window.confirm(`Delete “${project.title}” and its generation history? This cannot be undone.`)) return;
    deleteButton.disabled = true;
    deleteButton.textContent = 'Deleting…';
    try {
      const response = await fetch('/api/video-studio/projects', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ projectId: project.id }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to delete the project.');
      await Promise.all([loadProjects(), loadUsage()]);
    } catch (error) {
      deleteButton.textContent = error instanceof Error ? error.message : 'Delete failed';
      setTimeout(() => renderProjects(), 2200);
    }
  });

  document.querySelector('#refresh')?.addEventListener('click', () => {
    loadProjects();
    loadUsage();
  });

  updateEstimate();
  loadProjects();
  loadUsage();
</script>

<style>
  .create-card { margin-top: 1rem; scroll-margin-top: 70px; }
  .create-card__source { margin-top: 0.9rem; }
  .create-card__title { margin-top: 0.9rem; }

  .create-card__footer {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--vs-border);
  }

  .create-card__estimate { display: grid; gap: 0.15rem; }
  .create-card__estimate strong { font-size: 0.9375rem; }
  .create-card__estimate span[id] { color: var(--vs-accent-hover); font-size: 1.05rem; }

  /* Mobile: primary CTA last and full width, so it sits under the thumb. */
  .create-card__actions { display: grid; gap: 0.55rem; }

  .projects-section { margin-top: 1.75rem; }
  .projects-section__head { margin-bottom: 0.9rem; }

  /* These are secondary actions — pair them on one row rather than
     letting each take a full-width primary-looking bar. */
  .projects-section__head .vs-page-head__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  /* .project-card / .project-grid live in styles/video-studio.css because
     the cards are injected via innerHTML and would not match scoped rules. */

  @media (min-width: 768px) {
    .create-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .create-card__actions { display: flex; gap: 0.6rem; }
  }
</style>
