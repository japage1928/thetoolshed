---
import StudioShell from '../../../components/video-studio/StudioShell.astro';
---
<StudioShell title="Usage & Credits" section="usage"><div class="page-head"><div><h1>Usage & Credits</h1><p>Your real credit balance and generation usage.</p></div></div><div class="grid stats"><div class="card stat"><span class="muted">Available credits</span><strong id="credits">—</strong></div><div class="card stat"><span class="muted">Credits used</span><strong id="used">—</strong></div><div class="card stat"><span class="muted">Completed generations</span><strong id="done">—</strong></div></div><div class="card" style="margin-top:18px"><p class="muted">Credits are reserved before generation and reconciled after completion or failure. Spend caps remain enforced server-side.</p></div></StudioShell><script>fetch('/api/video-studio/account').then(r=>r.json()).then(d=>{document.querySelector('#credits').textContent=d.credits??0;document.querySelector('#used').textContent=d.usage?.credits_used??0;document.querySelector('#done').textContent=d.usage?.completed_generations??0;});</script>