    .project-aside { position: sticky; top: 76px; }
    .readiness__action .js-generate { display: inline-flex; }
    .sticky-action { display: none; }
    .stepper__list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); overflow: visible; }
    .stepper__item { justify-content: center; }
  }
</style>
