---
import StudioShell from '../../../../components/video-studio/StudioShell.astro';
const projectId = Astro.params.id;
---

<StudioShell title="Project" section="projects" stickyAction>
  <a class="vs-backlink" href="/app/video-studio/projects">
    <span class="vs-ico" data-ico="chevron" aria-hidden="true"></span>
    Projects
  </a>

  <!-- Header -->
  <div class="vs-page-head project-head">
    <div class="project-head__main">
      <h1 class="vs-h1" id="title">Project</h1>
      <div class="project-head__meta" id="meta-badges">
        <span class="vs-badge" id="meta-status"><i class="vs-badge__dot"></i>Loading…</span>
      </div>
    </div>
    <div class="vs-page-head__actions project-head__actions">
      <button class="vs-btn vs-btn--primary js-generate" type="button" disabled>Generate Video</button>
    </div>
  </div>

  <!-- Workflow progress. Phones get a compact "step N of 5" readout so the
       indicator always fits; tablets and up get the full pill stepper. -->
  <nav class="stepper" aria-label="Project workflow">
    <div class="stepper__compact">
      <div class="stepper__compact-row">
        <span class="vs-eyebrow" id="step-counter">Step 1 of 5</span>
        <strong class="stepper__compact-label" id="step-label">Setup</strong>
      </div>
      <div class="vs-confidence__track">
        <span class="vs-confidence__fill" id="step-progress" style="width:20%"></span>
      </div>
    </div>
    <ol class="stepper__list">
      <li class="stepper__item" data-step="setup"><span class="stepper__num">1</span><span class="stepper__label">Setup</span></li>
      <li class="stepper__item" data-step="identity"><span class="stepper__num">2</span><span class="stepper__label">Verification</span></li>
      <li class="stepper__item" data-step="creative"><span class="stepper__num">3</span><span class="stepper__label">Creative Plan</span></li>
      <li class="stepper__item" data-step="generate"><span class="stepper__num">4</span><span class="stepper__label">Generate</span></li>
      <li class="stepper__item" data-step="review"><span class="stepper__num">5</span><span class="stepper__label">Review</span></li>
    </ol>
  </nav>

  <div class="project-layout">
    <div class="project-main vs-stack">
      <!-- Product identity -->
      <section class="vs-card" id="product-identity" aria-labelledby="identity-heading">
        <div class="vs-card__head">
          <div class="vs-card__title-group">
            <span class="vs-eyebrow">Step 2 · Product accuracy gate</span>
            <h2 class="vs-h2" id="identity-heading">Product Identity</h2>
          </div>
          <span class="vs-badge vs-badge--wrap" id="identity-badge">Checking…</span>
        </div>

        <div class="identity-summary" id="identity-summary">
          <div class="identity-summary__media" id="identity-media" aria-hidden="true">
            <span class="identity-summary__placeholder">No image</span>
          </div>
          <dl class="vs-deflist identity-summary__facts" id="identity-facts">
            <div class="vs-defrow"><dt class="vs-defrow__label">Loading</dt><dd class="vs-defrow__value">—</dd></div>
          </dl>
        </div>

        <div class="vs-confidence identity-confidence">
          <div class="vs-confidence__row">
            <span class="vs-metric__label">Identity confidence</span>
            <span class="vs-confidence__value" id="confidence-value">—</span>
          </div>
          <div class="vs-confidence__track">
            <span class="vs-confidence__fill" id="confidence-fill"></span>
          </div>
        </div>

        <p class="vs-status-msg identity-blocked" id="identity-blocked" hidden aria-live="polite"></p>

        <!-- Editable fields stay collapsed so the card reads as a summary. -->
        <details class="identity-edit" id="identity-edit">
          <summary class="vs-btn vs-btn--secondary vs-btn--block">Edit Identity</summary>
          <form id="identity-form" class="identity-form">
            <div class="vs-form-grid vs-form-grid--2">
              <div class="vs-field">
                <label class="vs-label" for="f-productName">Exact product name</label>
                <input class="vs-input" id="f-productName" name="productName" type="text" maxlength="300" placeholder="Exact product name" />
              </div>
              <div class="vs-field">
                <label class="vs-label" for="f-brand">Brand</label>
                <input class="vs-input" id="f-brand" name="brand" type="text" maxlength="120" placeholder="Brand" />
              </div>
              <div class="vs-field">
                <label class="vs-label" for="f-model">Model</label>
                <input class="vs-input" id="f-model" name="model" type="text" maxlength="160" placeholder="Model" />
              </div>
              <div class="vs-field">
                <label class="vs-label" for="f-variant">Variant / form factor</label>
                <input class="vs-input" id="f-variant" name="variant" type="text" maxlength="160" placeholder="Form factor or variant" />
              </div>
              <div class="vs-field">
                <label class="vs-label" for="f-color">Color / finish</label>
                <input class="vs-input" id="f-color" name="color" type="text" maxlength="120" placeholder="Color or finish" />
              </div>
              <div class="vs-field vs-field--full">
                <label class="vs-label" for="f-identityNotes">Details the generator must preserve</label>
                <textarea class="vs-textarea" id="f-identityNotes" name="identityNotes" rows="4" maxlength="1000" placeholder="Distinctive shape, materials, controls, markings, accessories, and anything the model must not change."></textarea>
              </div>
            </div>
            <div class="identity-form__foot">
              <p class="vs-help" id="identity-status" aria-live="polite">Product verification has not run yet.</p>
              <button class="vs-btn vs-btn--secondary vs-btn--block" id="verify" type="submit">Verify product identity</button>
            </div>
          </form>
        </details>

        <p class="vs-help accuracy-rule">
          <strong>Accuracy rule.</strong> Generic lookalikes, alternate models, changed proportions,
          changed logos, invented controls, accessories, or form-factor substitutions are forbidden.
        </p>
      </section>

      <!-- Reference images -->
      <section class="vs-card" id="reference-images" aria-labelledby="references-heading">
        <div class="vs-card__head">
          <div class="vs-card__title-group">
            <span class="vs-eyebrow">Step 2 · Evidence</span>
            <h2 class="vs-h2" id="references-heading">Reference Images</h2>
          </div>
          <span class="vs-badge" id="reference-count">0 of 6</span>
        </div>
        <p class="vs-help">
          When URL evidence is insufficient, upload clear current-product photos.
          Adding or removing an image invalidates verification until you verify again.
        </p>

        <form id="reference-form" class="uploader">
          <label class="uploader__drop" for="reference-files">
            <strong>Add product references</strong>
            <span class="vs-help">Drop images here or browse</span>
            <span class="vs-faint uploader__formats">PNG, JPG, WEBP · up to 6 images · 10 MB each</span>
            <input id="reference-files" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple class="uploader__input" />
          </label>
          <p class="vs-help uploader__selected" id="reference-selected" hidden></p>
          <button class="vs-btn vs-btn--secondary vs-btn--block" type="submit">Upload references</button>
        </form>

        <div id="references" class="reference-grid">
          <div class="vs-empty"><p class="vs-empty__body">No reference images yet.</p></div>
        </div>
      </section>

      <!-- Creative setup -->
      <section class="vs-card" id="creative-settings" aria-labelledby="creative-heading">
        <div class="vs-card__head">
          <div class="vs-card__title-group">
            <span class="vs-eyebrow">Step 3</span>
            <h2 class="vs-h2" id="creative-heading">Creative Setup</h2>
          </div>
        </div>
        <dl class="vs-deflist" id="creative-summary">
          <div class="vs-defrow"><dt class="vs-defrow__label">Loading</dt><dd class="vs-defrow__value">—</dd></div>
        </dl>
        <p class="vs-help creative-note">These saved settings will be used for the next generation.</p>
      </section>

      <!-- Production plan -->
      <section class="vs-card" id="production-plan" aria-labelledby="plan-heading">
        <div class="vs-card__head">
          <div class="vs-card__title-group">
            <span class="vs-eyebrow">Step 3</span>
            <h2 class="vs-h2" id="plan-heading">Production Plan</h2>
          </div>
        </div>
        <div id="plan-body">
          <div class="vs-empty">
            <p class="vs-empty__body">
              The shot plan is produced by the pipeline when a generation starts.
              It will appear here once the first generation runs.
            </p>
          </div>
        </div>
      </section>

      <!-- Generation progress -->
      <section class="vs-card progress-card" id="generation-progress" hidden aria-labelledby="progress-heading">
        <div class="vs-card__head">
          <div class="vs-card__title-group">
            <span class="vs-eyebrow">Step 5 · Progress</span>
            <h2 class="vs-h2" id="progress-heading"><span id="progress-title">Starting generation…</span></h2>
          </div>
        </div>
        <p class="vs-help" id="progress-copy" aria-live="polite">Credits are reserved once while the production pipeline starts.</p>
        <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
      </section>

      <!-- Generations -->
      <section class="vs-card" id="generation-results" aria-labelledby="generations-heading">
        <div class="vs-card__head">
          <div class="vs-card__title-group">
            <span class="vs-eyebrow">Step 5</span>
            <h2 class="vs-h2" id="generations-heading">Generations</h2>
          </div>
        </div>
        <div id="video-area" class="video-area">
          <div class="vs-empty"><p class="vs-empty__body">Loading video…</p></div>
        </div>
        <div id="generations" class="generation-list">
          <div class="vs-empty"><p class="vs-empty__body">Loading…</p></div>
        </div>
      </section>
    </div>

    <!-- Readiness sidebar (desktop) / inline card (mobile) -->
    <aside class="project-aside">
      <section class="vs-card readiness" id="readiness" aria-labelledby="readiness-heading">
        <div class="vs-card__head">
          <div class="vs-card__title-group">
            <h2 class="vs-h2" id="readiness-heading">Project Readiness</h2>
          </div>
        </div>
        <dl class="vs-deflist" id="readiness-list">
          <div class="vs-defrow"><dt class="vs-defrow__label">Loading</dt><dd class="vs-defrow__value">—</dd></div>
        </dl>
        <div class="readiness__action">
          <button class="vs-btn vs-btn--primary vs-btn--block js-generate" type="button" disabled>Generate Video</button>
          <p class="vs-help js-generate-reason" aria-live="polite">Checking product identity…</p>
        </div>
      </section>
    </aside>
  </div>

  <!-- Sticky mobile generate bar -->
  <div class="sticky-action" id="sticky-action" hidden>
    <div class="sticky-action__inner">
      <p class="sticky-action__reason js-generate-reason">Checking product identity…</p>
      <button class="vs-btn vs-btn--primary vs-btn--block js-generate" type="button" disabled>Generate Video</button>
    </div>
  </div>
</StudioShell>

<script define:vars={{ projectId }}>
  const esc = (v) => { const s = document.createElement('span'); s.textContent = String(v ?? ''); return s.innerHTML; };

  let project = null, references = [], generations = [];
  let gate = { canGenerate: false, blockedReason: 'Product identity must be verified first.', estimatedCredits: 0 };
  let submitting = false, pollTimer = 0, formDirty = false;

  const MAX_REFERENCES = 6;
  const form = document.querySelector('#identity-form');
  const generateButtons = () => document.querySelectorAll('.js-generate');
  const reasonNodes = () => document.querySelectorAll('.js-generate-reason');
  const field = (name) => form?.elements.namedItem(name);

  const activeStatuses = new Set(['reserved', 'queued', 'planning', 'generating', 'qa', 'repairing']);
  const terminalStatuses = new Set(['ready', 'failed', 'canceled']);
  const keyName = () => `video-generation-key:${projectId}`;
  const confidenceText = (value) => `${Math.round(Number(value || 0) * 100)}% confidence`;

  const STEP_ORDER = ['setup', 'identity', 'creative', 'generate', 'review'];
  const STEP_LABELS = {
    setup: 'Setup', identity: 'Product Verification', creative: 'Creative Plan',
    generate: 'Generate', review: 'Review',
  };

  function setStep(name) {
    const activeIndex = STEP_ORDER.indexOf(name);
    document.querySelectorAll('.stepper__item').forEach((step) => {
      const index = STEP_ORDER.indexOf(step.dataset.step);
      step.classList.toggle('is-current', index === activeIndex);
      step.classList.toggle('is-done', activeIndex > -1 && index < activeIndex);
    });
    if (activeIndex < 0) return;
    const counter = document.querySelector('#step-counter');
    const label = document.querySelector('#step-label');
    const progress = document.querySelector('#step-progress');
    if (counter) counter.textContent = `Step ${activeIndex + 1} of ${STEP_ORDER.length}`;
    if (label) label.textContent = STEP_LABELS[name] || name;
    if (progress) progress.style.width = `${((activeIndex + 1) / STEP_ORDER.length) * 100}%`;
  }

  function setText(nodes, text) { nodes.forEach((node) => { node.textContent = text; }); }

  /* The reason line can wrap to two lines, so a fixed CSS reserve is not
     enough — measure the bar and pad the scroll area by its real height. */
  function reserveStickySpace(sticky) {
    const content = document.querySelector('.vs-content');
    if (!content) return;
    const height = sticky.hidden ? 0 : sticky.getBoundingClientRect().height;
    content.style.setProperty('--vs-sticky-reserve', `${Math.ceil(height)}px`);
  }

  /* ---- Gate: preserves the original conditions exactly ---- */
  function updateGate() {
    if (!project) return;
    const confidence = Number(project.product_identity_confidence || 0);
    const verified = project.product_identity_status === 'verified' && confidence >= 0.8 && !formDirty;
    const active = generations.find((item) => activeStatuses.has(item.status));
    const canGenerate = Boolean(gate.canGenerate) && verified && !active && !submitting;

    const badge = document.querySelector('#identity-badge');
    if (badge) {
      badge.textContent = verified
        ? `Verified · ${confidenceText(confidence)}`
        : formDirty
          ? 'Changes need verification'
          : confidence > 0
            ? `Needs attention · ${confidenceText(confidence)}`
            : 'Verification required';
      badge.className = `vs-badge vs-badge--wrap ${verified ? 'vs-badge--success' : 'vs-badge--warning'}`;
    }

    const reason = active
      ? 'A generation is already in progress.'
      : formDirty
        ? 'Verify the changed product identity before generating.'
        : canGenerate
          ? 'Identity verified. Ready to start one generation.'
          : (gate.blockedReason || 'Product identity must be verified first.');
    setText(reasonNodes(), reason);

    /* When blocked, restate the reason inside the identity card too. */
    const blocked = document.querySelector('#identity-blocked');
    if (blocked) {
      if (canGenerate) {
        blocked.hidden = true;
      } else {
        blocked.hidden = false;
        blocked.dataset.tone = 'error';
        blocked.textContent = reason;
      }
    }

    const label = `Generate Video · ${Number(gate.estimatedCredits || 0)} credits`;
    generateButtons().forEach((button) => {
      button.disabled = !canGenerate;
      button.textContent = submitting ? 'Starting generation…' : label;
    });

    /* Sticky bar only when generating is the next logical action. */
    const sticky = document.querySelector('#sticky-action');
    if (sticky) {
      sticky.hidden = Boolean(active) || !canGenerate;
      reserveStickySpace(sticky);
    }

    renderReadiness(verified, confidence);

    if (active) setStep('review');
    else if (canGenerate) setStep('generate');
    else if (!verified) setStep('identity');
  }

  /* ---- Readiness: only fields the API actually returns ---- */
  function renderReadiness(verified, confidence) {
    const node = document.querySelector('#readiness-list');
    if (!node || !project) return;
    const identityValue = verified
      ? `Verified · ${confidenceText(confidence)}`
      : confidence > 0 ? `Needs attention · ${confidenceText(confidence)}` : 'Not verified';
    const creativeReady = Boolean(project.objective && project.platform && project.duration_seconds);
    node.innerHTML = `
      <div class="vs-defrow"><dt class="vs-defrow__label">Product identity</dt><dd class="vs-defrow__value">${esc(identityValue)}</dd></div>
      <div class="vs-defrow"><dt class="vs-defrow__label">Reference coverage</dt><dd class="vs-defrow__value">${references.length} of ${MAX_REFERENCES} images</dd></div>
      <div class="vs-defrow"><dt class="vs-defrow__label">Creative setup</dt><dd class="vs-defrow__value">${creativeReady ? 'Ready' : 'Incomplete'}</dd></div>
      <div class="vs-defrow"><dt class="vs-defrow__label">Estimated credits</dt><dd class="vs-defrow__value">${Number(gate.estimatedCredits || 0)}</dd></div>`;
  }

  function renderIdentity() {
    if (!project) return;
    const identity = project.product_identity || {};
    const confidence = Number(project.product_identity_confidence || 0);

    const media = document.querySelector('#identity-media');
    const imageUrl = identity.primaryImageUrl || references[0]?.previewUrl || null;
    if (media) {
      media.innerHTML = imageUrl
        ? `<img src="${esc(imageUrl)}" alt="${esc(identity.name || project.title)}" />`
        : '<span class="identity-summary__placeholder">No image</span>';
    }

    const rows = [
      ['Product', identity.name],
      ['Brand', identity.brand],
      ['Model', identity.model],
      ['Form factor', identity.variant],
      ['Color', identity.color],
    ].filter(([, value]) => Boolean(value));

    const facts = document.querySelector('#identity-facts');
    if (facts) {
      facts.innerHTML = rows.length
        ? rows.map(([label, value]) => `<div class="vs-defrow"><dt class="vs-defrow__label">${esc(label)}</dt><dd class="vs-defrow__value">${esc(value)}</dd></div>`).join('')
        : '<div class="vs-defrow"><dt class="vs-defrow__label">Product</dt><dd class="vs-defrow__value">Not identified yet</dd></div>';
    }

    const value = document.querySelector('#confidence-value');
    const fill = document.querySelector('#confidence-fill');
    if (value) value.textContent = confidenceText(confidence);
    if (fill) {
      fill.style.width = `${Math.max(0, Math.min(100, Math.round(confidence * 100)))}%`;
      fill.dataset.tone = confidence >= 0.8 ? 'success' : confidence >= 0.5 ? 'warning' : 'danger';
    }
  }

  function renderReferences() {
    const node = document.querySelector('#references');
    const count = document.querySelector('#reference-count');
    if (count) count.textContent = `${references.length} of ${MAX_REFERENCES}`;
    if (!node) return;
    if (!references.length) {
      node.innerHTML = '<div class="vs-empty"><p class="vs-empty__body">No reference images yet.</p></div>';
      return;
    }
    node.innerHTML = references.map((image) => `
      <figure class="reference-card">
        ${image.previewUrl
          ? `<img src="${esc(image.previewUrl)}" alt="${esc(image.name)}" />`
          : '<div class="reference-card__placeholder">Image</div>'}
        <figcaption>
          <span class="reference-card__name">${esc(image.name)}</span>
          <span class="vs-faint">${Math.max(1, Math.round(Number(image.sizeBytes || 0) / 1024))} KB</span>
        </figcaption>
        <button class="vs-btn vs-btn--danger vs-btn--sm delete-ref" data-id="${esc(image.id)}" type="button">Remove</button>
      </figure>`).join('');
  }

  function renderProgress() {
    const active = generations.find((item) => activeStatuses.has(item.status));
    const latest = generations[0];
    const panel = document.querySelector('#generation-progress');
    if (!panel) return;
    if (!active && !latest) { panel.hidden = true; return; }
    const item = active || latest;
    const labels = {
      reserved: 'Reserving credits…', queued: 'Queued for production', planning: 'Planning the video',
      generating: 'Generating video', qa: 'Checking video quality', repairing: 'Repairing the generation',
      ready: 'Video complete', failed: 'Generation failed', canceled: 'Generation canceled',
    };
    const progress = { reserved: 12, queued: 22, planning: 35, generating: 62, qa: 82, repairing: 88, ready: 100, failed: 100, canceled: 100 };
    panel.hidden = false;
    document.querySelector('#progress-title').textContent = labels[item.status] || 'Generation update';
    document.querySelector('#progress-copy').textContent = item.status === 'ready'
      ? 'The completed video is attached to this project.'
      : item.status === 'failed'
        ? (item.error || 'Reserved credits were reconciled after the failure.')
        : `Generation ${String(item.id).slice(0, 8)} · ${item.credits_reserved || 0} credits reserved once.`;
    document.querySelector('#progress-bar').style.width = `${progress[item.status] || 8}%`;
    panel.classList.toggle('is-failed', item.status === 'failed');
    panel.classList.toggle('is-complete', item.status === 'ready');
  }

  function generationTone(status) {
    if (status === 'ready') return 'vs-badge--success';
    if (status === 'failed' || status === 'canceled') return 'vs-badge--danger';
    if (activeStatuses.has(status)) return 'vs-badge--info';
    return '';
  }

  function renderGenerations() {
    const node = document.querySelector('#generations');
    if (!node) return;
    if (!generations.length) {
      node.innerHTML = `
        <div class="vs-empty">
          <p class="vs-empty__title">No videos generated yet</p>
          <p class="vs-empty__body">Completed generations will appear here.</p>
        </div>`;
      return;
    }
    node.innerHTML = generations.map((g) => `
      <article class="generation-card">
        <div class="generation-card__top">
          <span class="vs-badge ${generationTone(g.status)}"><i class="vs-badge__dot"></i>${esc(g.status)}</span>
          <span class="vs-faint generation-card__time">${new Date(g.created_at).toLocaleString()}</span>
        </div>
        <dl class="vs-deflist">
          <div class="vs-defrow"><dt class="vs-defrow__label">Model</dt><dd class="vs-defrow__value">${esc(g.provider)} · ${esc(g.model)}</dd></div>
          <div class="vs-defrow"><dt class="vs-defrow__label">Duration</dt><dd class="vs-defrow__value">${esc(g.duration_seconds)}s · ${esc(g.resolution)}</dd></div>
          <div class="vs-defrow"><dt class="vs-defrow__label">Credits used</dt><dd class="vs-defrow__value">${esc(g.credits_used ?? g.credits_reserved ?? 0)}</dd></div>
        </dl>
        ${g.videoPath ? `<a class="vs-btn vs-btn--secondary vs-btn--sm generation-card__view" href="${esc(g.videoPath)}" target="_blank" rel="noopener">View video</a>` : ''}
      </article>`).join('');
  }

  function schedulePoll() {
    window.clearTimeout(pollTimer);
    const active = generations.some((item) => activeStatuses.has(item.status));
    if (active) pollTimer = window.setTimeout(() => load({ quiet: true }), 3000);
    else if (generations[0] && terminalStatuses.has(generations[0].status)) sessionStorage.removeItem(keyName());
  }

  async function load({ quiet = false } = {}) {
    const r = await fetch(`/api/video-studio/projects/${projectId}`, { headers: { accept: 'application/json' } });
    const d = await r.json();
    if (!r.ok) {
      document.querySelector('#video-area').innerHTML = `<div class="vs-empty vs-empty--error"><p class="vs-empty__title">Project unavailable</p><p class="vs-empty__body">${esc(d.error || 'Project unavailable.')}</p></div>`;
      return;
    }
    project = d.project;
    references = d.referenceImages || [];
    generations = d.generations || [];
    gate = d.generationGate || gate;
    const p = project;

    document.querySelector('#title').textContent = p.title;
    document.querySelector('#meta-badges').innerHTML = `
      <span class="vs-badge"><i class="vs-badge__dot"></i>${esc(String(p.status || '').replace(/_/g, ' '))}</span>
      <span class="vs-badge">${esc(p.platform)}</span>
      <span class="vs-badge">${esc(p.duration_seconds)}s</span>
      <span class="vs-badge">${esc(p.aspect_ratio)} · ${esc(p.resolution)}</span>`;

    document.querySelector('#creative-summary').innerHTML = `
      <div class="vs-defrow"><dt class="vs-defrow__label">Goal</dt><dd class="vs-defrow__value">${esc(p.objective)}</dd></div>
      <div class="vs-defrow"><dt class="vs-defrow__label">Platform</dt><dd class="vs-defrow__value">${esc(p.platform)}</dd></div>
      <div class="vs-defrow"><dt class="vs-defrow__label">Duration</dt><dd class="vs-defrow__value">${esc(p.duration_seconds)} seconds</dd></div>
      <div class="vs-defrow"><dt class="vs-defrow__label">Format</dt><dd class="vs-defrow__value">${esc(p.aspect_ratio)} · ${esc(p.resolution)}</dd></div>
      <div class="vs-defrow"><dt class="vs-defrow__label">Source</dt><dd class="vs-defrow__value">${esc(p.source_type === 'url' ? p.source_url : 'Creative brief')}</dd></div>`;

    const identity = p.product_identity || {};
    if (!formDirty) {
      if (field('productName')) field('productName').value = identity.name || '';
      if (field('brand')) field('brand').value = identity.brand || '';
      if (field('model')) field('model').value = identity.model || '';
      if (field('variant')) field('variant').value = identity.variant || '';
      if (field('color')) field('color').value = identity.color || '';
      if (field('identityNotes')) field('identityNotes').value = identity.userNotes || '';
    }

    /* Only one empty state in this section: when there are no generations at
       all the list below already says so, so the player area stays silent. */
    const ready = generations.find((g) => g.status === 'ready' && g.videoPath);
    const area = document.querySelector('#video-area');
    area.hidden = !ready && generations.length === 0;
    area.innerHTML = ready
      ? `<div class="video-wrap"><video controls playsinline preload="metadata" src="${esc(ready.videoPath)}"></video></div>
         <p class="vs-help">Latest completed generation · ${esc(ready.duration_seconds)}s · ${esc(ready.resolution)}</p>`
      : generations.length
        ? '<div class="vs-empty"><p class="vs-empty__body">No playable video yet. It will appear here once a generation completes.</p></div>'
        : '';

    renderIdentity();
    renderReferences();
    renderGenerations();
    renderProgress();
    updateGate();
    schedulePoll();
    if (!quiet && ready) setStep('review');
  }

  /* ---- Identity editing ---- */
  form?.addEventListener('input', () => { formDirty = true; gate.canGenerate = false; updateGate(); });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = document.querySelector('#verify');
    button.disabled = true;
    button.textContent = 'Verifying…';
    const body = Object.fromEntries(new FormData(form).entries());
    try {
      const r = await fetch(`/api/video-studio/projects/${projectId}/grounding`, {
        method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Unable to verify product.');
      formDirty = false;
      document.querySelector('#identity-status').textContent = d.message;
      await load({ quiet: true });
    } catch (error) {
      document.querySelector('#identity-status').textContent = error instanceof Error ? error.message : 'Unable to verify product.';
    } finally {
      button.disabled = false;
      button.textContent = 'Verify product identity';
    }
  });

  /* ---- Reference uploads ---- */
  document.querySelector('#reference-files')?.addEventListener('change', (event) => {
    const input = event.currentTarget;
    const note = document.querySelector('#reference-selected');
    if (!note) return;
    const files = [...(input.files || [])];
    note.hidden = files.length === 0;
    note.textContent = files.length ? `${files.length} file${files.length > 1 ? 's' : ''} selected` : '';
  });

  document.querySelector('#reference-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = document.querySelector('#reference-files');
    if (!input.files?.length) return;
    const button = event.currentTarget.querySelector('button[type="submit"]');
    button.disabled = true;
    button.textContent = 'Uploading…';
    const data = new FormData();
    [...input.files].forEach((file) => data.append('images', file));
    try {
      const r = await fetch(`/api/video-studio/projects/${projectId}/reference-images`, { method: 'POST', body: data });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Upload failed.');
      input.value = '';
      const note = document.querySelector('#reference-selected');
      if (note) { note.hidden = true; note.textContent = ''; }
      formDirty = false;
      await load({ quiet: true });
      document.querySelector('#identity-status').textContent = 'Reference changed. Verify the product identity again.';
    } catch (error) {
      document.querySelector('#identity-status').textContent = error instanceof Error ? error.message : 'Reference upload failed.';
    } finally {
      button.disabled = false;
      button.textContent = 'Upload references';
    }
  });

  document.querySelector('#references')?.addEventListener('click', async (event) => {
    const button = event.target.closest('.delete-ref');
    if (!button) return;
    button.disabled = true;
    const r = await fetch(`/api/video-studio/projects/${projectId}/reference-images`, {
      method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ imageId: button.dataset.id }),
    });
    if (r.ok) {
      formDirty = false;
      await load({ quiet: true });
      document.querySelector('#identity-status').textContent = 'Reference changed. Verify the product identity again.';
    } else button.disabled = false;
  });

  /* ---- Generation ---- */
  async function startGeneration() {
    if (!gate.canGenerate || !project || submitting) return;
    submitting = true;
    updateGate();
    const requestKey = sessionStorage.getItem(keyName()) || crypto.randomUUID();
    sessionStorage.setItem(keyName(), requestKey);
    try {
      const panel = document.querySelector('#generation-progress');
      panel.hidden = false;
      document.querySelector('#progress-title').textContent = 'Starting generation…';
      document.querySelector('#progress-copy').textContent = 'Validating access, product identity, credits, and project ownership.';
      const r = await fetch('/api/video-studio/generate', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'idempotency-key': requestKey },
        body: JSON.stringify({ projectId: project.id, durationSeconds: project.duration_seconds, resolution: project.resolution }),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Unable to start generation.');
      document.querySelector('#identity-status').textContent = d.duplicate
        ? 'The existing generation is already in progress.'
        : 'One generation started. Credits were reserved once.';
      await load({ quiet: true });
    } catch (error) {
      sessionStorage.removeItem(keyName());
      document.querySelector('#identity-status').textContent = error instanceof Error ? error.message : 'Generation could not start.';
    } finally {
      submitting = false;
      updateGate();
    }
  }

  generateButtons().forEach((button) => button.addEventListener('click', startGeneration));

  setStep('setup');
  load();
</script>

<style>
