    .stepper__list::-webkit-scrollbar { display: none; }
    .identity-edit > summary { display: inline-flex; width: auto; }
    .identity-form__foot { display: flex; align-items: center; justify-content: space-between; }
    .identity-form__foot .vs-btn { width: auto; flex-shrink: 0; }
