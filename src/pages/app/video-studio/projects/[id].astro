---
import StudioShell from '../../../../components/video-studio/StudioShell.astro';
const projectId = Astro.params.id;
---
<StudioShell title="Project" section="projects">
  <div class="page-head">
    <div><a class="muted" href="/app/video-studio/projects" style="text-decoration:none">← Projects</a><h1 id="title" style="margin-top:10px">Project</h1><p id="meta">Loading project…</p></div>
  </div>

  <nav class="workflow-steps" aria-label="Video generation steps">
    <span data-step="details">1 <b>Product details</b></span><span data-step="identity">2 <b>Verify identity</b></span><span data-step="references">3 <b>References</b></span><span data-step="creative">4 <b>Creative</b></span><span data-step="generate">5 <b>Generate</b></span><span data-step="progress">6 <b>Progress</b></span><span data-step="results">7 <b>Results</b></span>
  </nav>

  <div class="grid top-grid" id="product-details">
    <section class="card"><div id="video-area"><div class="empty">Loading video…</div></div></section>
    <aside class="card"><h3 style="margin-top:0">Product details</h3><div id="details" class="muted">Loading…</div></aside>
  </div>

  <section class="card grounding-card" id="product-identity">
    <div class="grounding-head">
      <div><span class="eyebrow">STEP 2 · PRODUCT ACCURACY GATE</span><h2>Verify the exact product</h2><p class="muted">Only this project’s URL, extracted product data, and uploaded references are used. Credits cannot be spent until the identity is current and reliable.</p></div>
      <div id="identity-badge" class="identity-badge pending">Checking…</div>
    </div>
    <form id="identity-form" class="identity-form">
      <div class="field-grid">
        <label>Exact product name<input name="productName" type="text" maxlength="300" placeholder="Exact product name" /></label><label>Brand<input name="brand" type="text" maxlength="120" placeholder="Brand" /></label><label>Model<input name="model" type="text" maxlength="160" placeholder="Model" /></label><label>Variant / form factor<input name="variant" type="text" maxlength="160" placeholder="Form factor or variant" /></label><label>Color / finish<input name="color" type="text" maxlength="120" placeholder="Color or finish" /></label>
      </div>
      <label class="notes-label">Identity details the generator must preserve<textarea name="identityNotes" rows="4" maxlength="1000" placeholder="Distinctive shape, materials, controls, markings, accessories, and anything the model must not change."></textarea></label>
      <div class="verify-row"><div id="identity-status" class="muted" aria-live="polite">Product verification has not run yet.</div><button id="verify" class="btn secondary" type="submit">Verify product identity</button></div>
    </form>
    <div class="reference-section" id="reference-images">
      <div><span class="eyebrow">STEP 3</span><h3>Reference images</h3><p class="muted">When URL evidence is insufficient, upload clear current-product photos. Adding or removing an image invalidates verification until you verify again.</p></div>
      <form id="reference-form" class="reference-upload"><input id="reference-files" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple /><button class="btn secondary" type="submit">Upload references</button></form>
      <div id="references" class="references"><div class="empty">No reference images yet.</div></div>
    </div>
    <div class="accuracy-rule"><strong>Accuracy rule</strong><span>Generic lookalikes, alternate models, changed proportions, changed logos, invented controls, accessories, or form-factor substitutions are forbidden.</span></div>
  </section>

  <section class="card creative-card" id="creative-settings"><div><span class="eyebrow">STEP 4</span><h2>Creative settings</h2><p class="muted">These saved settings will be used for the next generation.</p></div><div id="creative-summary" class="creative-summary"><div class="empty">Loading settings…</div></div></section>

  <section class="generation-action" id="generation-action" aria-labelledby="generate-heading"><div><span class="eyebrow">STEP 5</span><h2 id="generate-heading">Generate video</h2><p id="generate-reason" aria-live="polite">Checking product identity…</p></div><button id="generate" class="btn primary-generate" type="button" disabled>Generate video</button></section>

  <section class="card progress-card" id="generation-progress" hidden><div><span class="eyebrow">STEP 6 · GENERATION PROGRESS</span><h2 id="progress-title">Starting generation…</h2><p id="progress-copy" class="muted" aria-live="polite">Credits are reserved once while the production pipeline starts.</p></div><div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div></section>

  <section class="generations-section" id="generation-results"><div class="section-heading"><div><span class="eyebrow">STEP 7</span><h2>Preview and results</h2></div></div><div id="generations" class="table"><div class="empty">Loading…</div></div></section>
</StudioShell>

<script define:vars={{ projectId }}>
  const esc=(v)=>{const s=document.createElement('span');s.textContent=String(v??'');return s.innerHTML};
  let project=null,references=[],generations=[];
  let gate={canGenerate:false,blockedReason:'Product identity must be verified first.',estimatedCredits:0};
  let submitting=false,pollTimer=0,formDirty=false;
  const form=document.querySelector('#identity-form'),generate=document.querySelector('#generate');
  const field=(name)=>form?.elements.namedItem(name);
  const activeStatuses=new Set(['reserved','queued','planning','generating','qa','repairing']);
  const terminalStatuses=new Set(['ready','failed','canceled']);
  const keyName=()=>`video-generation-key:${projectId}`;
  const confidenceText=(value)=>`${Math.round(Number(value||0)*100)}% confidence`;
  function setStep(name){document.querySelectorAll('.workflow-steps span').forEach((step)=>step.classList.toggle('current',step.dataset.step===name));}

  function updateGate(){
    if(!project)return;
    const confidence=Number(project.product_identity_confidence||0),verified=project.product_identity_status==='verified'&&confidence>=0.8&&!formDirty,active=generations.find((item)=>activeStatuses.has(item.status));
    const canGenerate=Boolean(gate.canGenerate)&&verified&&!active&&!submitting;
    const badge=document.querySelector('#identity-badge');badge.textContent=verified?`Verified · ${confidenceText(confidence)}`:formDirty?'Changes need verification':`Needs verification · ${confidenceText(confidence)}`;badge.className=`identity-badge ${verified?'verified':'pending'}`;
    document.querySelector('#generate-reason').textContent=active?'A generation is already in progress.':formDirty?'Verify the changed product identity before generating.':canGenerate?'Identity verified. Ready to start one generation.':(gate.blockedReason||'Product identity must be verified first.');
    generate.disabled=!canGenerate;generate.textContent=`Generate video · ${Number(gate.estimatedCredits||0)} credits`;
    if(active)setStep('progress');else if(canGenerate)setStep('generate');else if(!verified)setStep('identity');
  }
  function renderReferences(){const node=document.querySelector('#references');if(!references.length){node.innerHTML='<div class="empty">No uploaded references yet.</div>';return;}node.innerHTML=references.map((image)=>`<article class="ref-card">${image.previewUrl?`<img src="${image.previewUrl}" alt="${esc(image.name)}" />`:'<div class="ref-placeholder">IMAGE</div>'}<div><strong>${esc(image.name)}</strong><small>${Math.max(1,Math.round(Number(image.sizeBytes||0)/1024))} KB</small></div><button class="delete-ref" data-id="${image.id}" type="button">Remove</button></article>`).join('');}
  function renderProgress(){
    const active=generations.find((item)=>activeStatuses.has(item.status)),latest=generations[0],panel=document.querySelector('#generation-progress');if(!active&&!latest){panel.hidden=true;return;}const item=active||latest;
    const labels={reserved:'Reserving credits…',queued:'Queued for production',planning:'Planning the video',generating:'Generating video',qa:'Checking video quality',repairing:'Repairing the generation',ready:'Video complete',failed:'Generation failed',canceled:'Generation canceled'},progress={reserved:12,queued:22,planning:35,generating:62,qa:82,repairing:88,ready:100,failed:100,canceled:100};
    panel.hidden=false;document.querySelector('#progress-title').textContent=labels[item.status]||'Generation update';document.querySelector('#progress-copy').textContent=item.status==='ready'?'The completed video is attached to this project.':item.status==='failed'?(item.error||'Reserved credits were reconciled after the failure.'):`Generation ${String(item.id).slice(0,8)} · ${item.credits_reserved||0} credits reserved once.`;document.querySelector('#progress-bar').style.width=`${progress[item.status]||8}%`;panel.classList.toggle('failed',item.status==='failed');panel.classList.toggle('complete',item.status==='ready');
  }
  function schedulePoll(){window.clearTimeout(pollTimer);const active=generations.some((item)=>activeStatuses.has(item.status));if(active)pollTimer=window.setTimeout(()=>load({quiet:true}),3000);else if(generations[0]&&terminalStatuses.has(generations[0].status))sessionStorage.removeItem(keyName());}

  async function load({quiet=false}={}){
    const r=await fetch(`/api/video-studio/projects/${projectId}`,{headers:{accept:'application/json'}}),d=await r.json();if(!r.ok){document.querySelector('#video-area').innerHTML=`<div class="empty">${esc(d.error||'Project unavailable.')}</div>`;return;}
    project=d.project;references=d.referenceImages||[];generations=d.generations||[];gate=d.generationGate||gate;const p=project;
    document.querySelector('#title').textContent=p.title;document.querySelector('#meta').textContent=`${p.platform} · ${p.duration_seconds}s · ${p.resolution} · ${p.status}`;document.querySelector('#details').innerHTML=`<p><strong>Source</strong><br>${esc(p.source_type==='url'?p.source_url:'Creative brief')}</p><p><strong>Goal</strong><br>${esc(p.objective)}</p><p><strong>Format</strong><br>${esc(p.aspect_ratio)} · ${esc(p.resolution)}</p><p><strong>Project state</strong><br><span class="status">${esc(p.status)}</span></p>`;document.querySelector('#creative-summary').innerHTML=`<div><span>Goal</span><strong>${esc(p.objective)}</strong></div><div><span>Platform</span><strong>${esc(p.platform)}</strong></div><div><span>Duration</span><strong>${esc(p.duration_seconds)} seconds</strong></div><div><span>Output</span><strong>${esc(p.aspect_ratio)} · ${esc(p.resolution)}</strong></div>`;
    const identity=p.product_identity||{};if(!formDirty){if(field('productName'))field('productName').value=identity.name||'';if(field('brand'))field('brand').value=identity.brand||'';if(field('model'))field('model').value=identity.model||'';if(field('variant'))field('variant').value=identity.variant||'';if(field('color'))field('color').value=identity.color||'';if(field('identityNotes'))field('identityNotes').value=identity.userNotes||'';}
    const ready=generations.find(g=>g.status==='ready'&&g.videoPath),area=document.querySelector('#video-area');area.innerHTML=ready?`<div class="video-wrap"><video controls playsinline preload="metadata" src="${ready.videoPath}"></video></div><p class="muted" style="margin-bottom:0">Latest completed generation · ${ready.duration_seconds}s · ${esc(ready.resolution)}</p>`:'<div class="empty">No completed video yet. Verify the product, then use Generate video below.</div>';
    const gens=document.querySelector('#generations');gens.innerHTML=generations.length?generations.map(g=>`<div class="row"><strong>${new Date(g.created_at).toLocaleString()}</strong><small class="hide-mobile">${esc(g.provider)} · ${esc(g.model)}</small><span class="status">${esc(g.status)}</span><small>${g.credits_used||g.credits_reserved} credits</small></div>`).join(''):'<div class="empty">No generations yet.</div>';
    renderReferences();renderProgress();updateGate();schedulePoll();if(!quiet&&ready)setStep('results');
  }

  form?.addEventListener('input',()=>{formDirty=true;gate.canGenerate=false;updateGate();});
  form?.addEventListener('submit',async(event)=>{event.preventDefault();const button=document.querySelector('#verify');button.disabled=true;button.textContent='Verifying…';const body=Object.fromEntries(new FormData(form).entries());try{const r=await fetch(`/api/video-studio/projects/${projectId}/grounding`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}),d=await r.json();if(!r.ok)throw new Error(d.error||'Unable to verify product.');formDirty=false;document.querySelector('#identity-status').textContent=d.message;await load({quiet:true});}catch(error){document.querySelector('#identity-status').textContent=error instanceof Error?error.message:'Unable to verify product.';}finally{button.disabled=false;button.textContent='Verify product identity';}});
  document.querySelector('#reference-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=document.querySelector('#reference-files');if(!input.files?.length)return;const button=event.currentTarget.querySelector('button');button.disabled=true;button.textContent='Uploading…';const data=new FormData();[...input.files].forEach(file=>data.append('images',file));try{const r=await fetch(`/api/video-studio/projects/${projectId}/reference-images`,{method:'POST',body:data}),d=await r.json();if(!r.ok)throw new Error(d.error||'Upload failed.');input.value='';formDirty=false;await load({quiet:true});document.querySelector('#identity-status').textContent='Reference changed. Verify the product identity again.';}catch(error){document.querySelector('#identity-status').textContent=error instanceof Error?error.message:'Reference upload failed.';}finally{button.disabled=false;button.textContent='Upload references';}});
  document.querySelector('#references')?.addEventListener('click',async(event)=>{const button=event.target.closest('.delete-ref');if(!button)return;button.disabled=true;const r=await fetch(`/api/video-studio/projects/${projectId}/reference-images`,{method:'DELETE',headers:{'content-type':'application/json'},body:JSON.stringify({imageId:button.dataset.id})});if(r.ok){formDirty=false;await load({quiet:true});document.querySelector('#identity-status').textContent='Reference changed. Verify the product identity again.';}else button.disabled=false;});
  generate?.addEventListener('click',async()=>{if(!gate.canGenerate||!project||submitting)return;submitting=true;updateGate();generate.textContent='Starting generation…';const requestKey=sessionStorage.getItem(keyName())||crypto.randomUUID();sessionStorage.setItem(keyName(),requestKey);try{document.querySelector('#generation-progress').hidden=false;document.querySelector('#progress-title').textContent='Starting generation…';document.querySelector('#progress-copy').textContent='Validating access, product identity, credits, and project ownership.';const r=await fetch('/api/video-studio/generate',{method:'POST',headers:{'content-type':'application/json','idempotency-key':requestKey},body:JSON.stringify({projectId:project.id,durationSeconds:project.duration_seconds,resolution:project.resolution})}),d=await r.json();if(!r.ok)throw new Error(d.error||'Unable to start generation.');document.querySelector('#identity-status').textContent=d.duplicate?'The existing generation is already in progress.':'One generation started. Credits were reserved once.';await load({quiet:true});}catch(error){sessionStorage.removeItem(keyName());document.querySelector('#identity-status').textContent=error instanceof Error?error.message:'Generation could not start.';}finally{submitting=false;updateGate();}});
  load();
</script>

<style>
  .workflow-steps{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;margin:0 0 22px}.workflow-steps span{display:flex;align-items:center;gap:7px;border:1px solid #dedede;border-radius:10px;padding:9px;font-size:.72rem;color:#777}.workflow-steps span.current{border-color:#111;background:#111;color:#fff}.workflow-steps b{font-weight:700}.top-grid{grid-template-columns:minmax(0,1fr) 330px;align-items:start}.grounding-card,.creative-card{margin-top:22px}.grounding-head{display:flex;gap:24px;align-items:flex-start;justify-content:space-between}.grounding-head h2,.creative-card h2,.generation-action h2,.progress-card h2{margin:5px 0 8px}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em}.identity-badge{white-space:nowrap;border-radius:999px;padding:8px 12px;font-size:.78rem;font-weight:800}.identity-badge.pending{border:1px solid #d8c79d;background:#fff8e8}.identity-badge.verified{border:1px solid #acd6b9;background:#eefaf2}.identity-form{margin-top:24px}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.identity-form label{display:grid;gap:7px;font-size:.82rem;font-weight:700}.identity-form input,.identity-form textarea,.reference-upload input{width:100%;box-sizing:border-box;border:1px solid #d8d8d8;border-radius:10px;padding:11px 12px;background:#fff;color:#111;font:inherit}.notes-label{margin-top:14px}.verify-row{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:16px}.reference-section{border-top:1px solid #e8e8e8;margin-top:26px;padding-top:22px}.reference-section h3{margin:5px 0 4px}.reference-upload{display:flex;gap:10px;align-items:center;margin:14px 0}.references{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ref-card{border:1px solid #e2e2e2;border-radius:12px;padding:9px;display:grid;gap:8px}.ref-card img,.ref-placeholder{width:100%;aspect-ratio:4/3;object-fit:contain;background:#f5f5f5;border-radius:8px}.ref-placeholder{display:grid;place-items:center;font-size:.72rem;font-weight:800}.ref-card div{display:grid;gap:2px}.ref-card small{color:#777}.delete-ref{border:0;background:transparent;text-align:left;padding:5px 0;color:#8b2c2c;cursor:pointer;min-height:36px}.accuracy-rule{display:grid;grid-template-columns:130px 1fr;gap:12px;border-top:1px solid #e8e8e8;margin-top:22px;padding-top:18px;font-size:.84rem}.btn.secondary{background:transparent;color:inherit;border:1px solid #ccc}.creative-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}.creative-summary div{display:grid;gap:6px;border:1px solid #e4e4e4;border-radius:12px;padding:14px}.creative-summary span{font-size:.75rem;color:#777}.generation-action{position:sticky;bottom:12px;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:24px;margin:22px 0;padding:18px 20px;border:1px solid #202020;border-radius:16px;background:#111;color:#fff;box-shadow:0 12px 35px rgba(0,0,0,.22)}.generation-action p{margin:4px 0 0;color:#c9c9c9}.primary-generate{min-width:260px;min-height:54px;background:#f4eee2!important;color:#111!important;font-weight:850;font-size:1rem}.primary-generate:disabled{opacity:.48;cursor:not-allowed}.progress-card{margin-top:22px}.progress-track{height:9px;margin-top:18px;border-radius:999px;background:#e5e5e5;overflow:hidden}.progress-track span{display:block;height:100%;width:8%;background:#111;transition:width .35s ease}.progress-card.complete .progress-track span{background:#218847}.progress-card.failed .progress-track span{background:#a13a30}.generations-section{margin-top:26px;padding-bottom:90px}.section-heading h2{margin:5px 0 12px}
  @media(max-width:900px){.workflow-steps{grid-template-columns:repeat(4,minmax(0,1fr))}.creative-summary{grid-template-columns:1fr 1fr}}
  @media(max-width:800px){.top-grid{grid-template-columns:1fr}.grounding-head,.verify-row,.reference-upload{align-items:stretch;flex-direction:column}.field-grid{grid-template-columns:1fr}.references{grid-template-columns:1fr 1fr}.accuracy-rule{grid-template-columns:1fr}.identity-badge{white-space:normal}.workflow-steps{display:flex;overflow-x:auto;padding-bottom:4px}.workflow-steps span{min-width:118px}.identity-form input,.identity-form textarea,.reference-upload input{font-size:16px;min-height:48px}.btn{min-height:48px}.generation-action{bottom:8px;display:grid;gap:12px;padding:14px}.generation-action h2{font-size:1.18rem}.generation-action p{font-size:.82rem}.primary-generate{width:100%;min-width:0;min-height:56px}.creative-summary{grid-template-columns:1fr 1fr}}
  @media(max-width:480px){.references,.creative-summary{grid-template-columns:1fr}}
</style>
