  /* ---------- Layout ---------- */
  .project-layout { display: grid; gap: 1rem; }
  .project-main { min-width: 0; }
  .project-aside { min-width: 0; }

  /* Mobile order: readiness sits right after identity, per the spec. */
  .project-layout { grid-template-areas: 'aside' 'main'; }
  .project-aside { grid-area: aside; }
  .project-main { grid-area: main; }

  /* ---------- Identity ---------- */
  .identity-summary { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 0.9rem; align-items: start; }
  .identity-summary__media {
    width: 76px;
    height: 76px;
