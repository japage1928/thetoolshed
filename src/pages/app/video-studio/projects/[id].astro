---
import StudioShell from '../../../../components/video-studio/StudioShell.astro';
const projectId = Astro.params.id;
---
<StudioShell title="Project" section="projects">
  <div class="page-head">
    <div><a class="muted" href="/app/video-studio/projects" style="text-decoration:none">← Projects</a><h1 id="title" style="margin-top:10px">Project</h1><p id="meta">Loading project…</p></div>
    <button id="generate" class="btn" type="button" disabled>Verify product first</button>
  </div>

  <div class="grid top-grid">
    <section class="card"><div id="video-area"><div class="empty">Loading video…</div></div></section>
    <aside class="card"><h3 style="margin-top:0">Project details</h3><div id="details" class="muted">Loading…</div></aside>
  </div>

  <section class="card grounding-card">
    <div class="grounding-head">
      <div><span class="eyebrow">PRODUCT ACCURACY GATE</span><h2>Lock the exact product</h2><p class="muted">Video Studio will not spend credits or generate until the product identity is reliable. Confirm the exact product and add clear reference images when the URL alone is ambiguous.</p></div>
      <div id="identity-badge" class="identity-badge pending">Checking…</div>
    </div>

    <form id="identity-form" class="identity-form">
      <div class="field-grid">
        <label>Exact product name<input name="productName" type="text" maxlength="300" placeholder="Example: LEVN LE-HS012 Basic Bluetooth Headset" /></label>
        <label>Brand<input name="brand" type="text" maxlength="120" placeholder="LEVN" /></label>
        <label>Model<input name="model" type="text" maxlength="160" placeholder="LE-HS012 Basic" /></label>
        <label>Variant / form factor<input name="variant" type="text" maxlength="160" placeholder="Single-ear / on-ear" /></label>
        <label>Color / finish<input name="color" type="text" maxlength="120" placeholder="Black" /></label>
      </div>
      <label class="notes-label">Identity details the generator must preserve<textarea name="identityNotes" rows="4" maxlength="1000" placeholder="Describe distinctive controls, logo placement, shape, materials, microphone, accessories, or anything the model must not change."></textarea></label>
      <div class="verify-row"><div id="identity-status" class="muted">Product verification has not run yet.</div><button id="verify" class="btn secondary" type="submit">Verify product identity</button></div>
    </form>

    <div class="reference-section">
      <div><h3>Reference images</h3><p class="muted">Upload clear product photos from multiple angles. JPEG, PNG, or WebP, up to 10 MB each. Up to 6 images per project.</p></div>
      <form id="reference-form" class="reference-upload"><input id="reference-files" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple /><button class="btn secondary" type="submit">Upload references</button></form>
      <div id="references" class="references"><div class="empty">No reference images yet.</div></div>
    </div>

    <div class="accuracy-rule"><strong>Accuracy rule</strong><span>Generic lookalikes, alternate models, changed proportions, changed logos, invented controls, accessories, or product form-factor substitutions are explicitly forbidden in the generation prompt.</span></div>
  </section>

  <section style="margin-top:22px"><h2>Generations</h2><div id="generations" class="table"><div class="empty">Loading…</div></div></section>
</StudioShell>

<script define:vars={{ projectId }}>
  const esc=(v)=>{const s=document.createElement('span');s.textContent=String(v??'');return s.innerHTML};
  let project=null;
  let references=[];
  let generationReady=false;
  const form=document.querySelector('#identity-form');
  const generate=document.querySelector('#generate');
  const field=(name)=>form?.elements.namedItem(name);

  function confidenceText(value){const n=Number(value||0);return `${Math.round(n*100)}% confidence`;}

  function updateGate(){
    if(!project)return;
    const confidence=Number(project.product_identity_confidence||0);
    const verified=project.product_identity_status==='verified'&&confidence>=0.8;
    const hasReference=references.length>0||Boolean(project.product_identity?.primaryImageUrl);
    generationReady=verified&&(project.product_identity_source==='url_extraction'||hasReference);
    const badge=document.querySelector('#identity-badge');
    badge.textContent=verified?`Verified · ${confidenceText(confidence)}`:`Needs verification · ${confidenceText(confidence)}`;
    badge.className=`identity-badge ${verified?'verified':'pending'}`;
    const status=document.querySelector('#identity-status');
    status.textContent=generationReady?'Identity gate passed. Generation can proceed.':'Generation is blocked until identity confidence is high and required visual references are present.';
    generate.disabled=!generationReady;
    generate.textContent=generationReady?'Generate grounded video':'Verify product first';
  }

  function renderReferences(){
    const node=document.querySelector('#references');
    if(!references.length){node.innerHTML='<div class="empty">No uploaded references yet.</div>';return;}
    node.innerHTML=references.map((image)=>`<article class="ref-card">${image.previewUrl?`<img src="${image.previewUrl}" alt="${esc(image.name)}" />`:'<div class="ref-placeholder">IMAGE</div>'}<div><strong>${esc(image.name)}</strong><small>${Math.max(1,Math.round(Number(image.sizeBytes||0)/1024))} KB</small></div><button class="delete-ref" data-id="${image.id}" type="button">Remove</button></article>`).join('');
  }

  async function load(){
    const r=await fetch(`/api/video-studio/projects/${projectId}`,{headers:{accept:'application/json'}});const d=await r.json();
    if(!r.ok){document.querySelector('#video-area').innerHTML=`<div class="empty">${esc(d.error||'Project unavailable.')}</div>`;return;}
    project=d.project;references=d.referenceImages||[];
    const p=project;
    document.querySelector('#title').textContent=p.title;
    document.querySelector('#meta').textContent=`${p.platform} · ${p.duration_seconds}s · ${p.resolution} · ${p.status}`;
    document.querySelector('#details').innerHTML=`<p><strong>Source</strong><br>${esc(p.source_type==='url'?p.source_url:'Creative brief')}</p><p><strong>Goal</strong><br>${esc(p.objective)}</p><p><strong>Format</strong><br>${esc(p.aspect_ratio)} · ${esc(p.resolution)}</p><p><strong>Status</strong><br><span class="status">${esc(p.status)}</span></p>`;
    const identity=p.product_identity||{};
    if(field('productName'))field('productName').value=identity.name||'';
    if(field('brand'))field('brand').value=identity.brand||'';
    if(field('model'))field('model').value=identity.model||'';
    if(field('variant'))field('variant').value=identity.variant||'';
    if(field('color'))field('color').value=identity.color||'';
    if(field('identityNotes'))field('identityNotes').value=identity.userNotes||'';
    const ready=(d.generations||[]).find(g=>g.status==='ready'&&g.videoPath);
    const area=document.querySelector('#video-area');
    area.innerHTML=ready?`<div class="video-wrap"><video controls playsinline preload="metadata" src="${ready.videoPath}"></video></div><p class="muted" style="margin-bottom:0">Latest completed generation · ${ready.duration_seconds}s · ${esc(ready.resolution)}</p>`:'<div class="empty">No completed video yet.</div>';
    const gens=document.querySelector('#generations');
    gens.innerHTML=(d.generations||[]).length?(d.generations||[]).map(g=>`<div class="row"><strong>${new Date(g.created_at).toLocaleString()}</strong><small class="hide-mobile">${esc(g.provider)} · ${esc(g.model)}</small><span class="status">${esc(g.status)}</span><small>${g.credits_used||g.credits_reserved} credits</small></div>`).join(''):'<div class="empty">No generations yet.</div>';
    renderReferences();updateGate();
  }

  form?.addEventListener('submit',async(event)=>{
    event.preventDefault();
    const button=document.querySelector('#verify');button.disabled=true;button.textContent='Verifying…';
    const body=Object.fromEntries(new FormData(form).entries());
    try{
      const r=await fetch(`/api/video-studio/projects/${projectId}/grounding`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();
      if(!r.ok)throw new Error(d.error||'Unable to verify product.');
      project={...project,...d.grounding};
      document.querySelector('#identity-status').textContent=d.message;
      updateGate();
    }catch(error){document.querySelector('#identity-status').textContent=error instanceof Error?error.message:'Unable to verify product.';}
    finally{button.disabled=false;button.textContent='Verify product identity';}
  });

  document.querySelector('#reference-form')?.addEventListener('submit',async(event)=>{
    event.preventDefault();const input=document.querySelector('#reference-files');if(!input.files?.length)return;
    const button=event.currentTarget.querySelector('button');button.disabled=true;button.textContent='Uploading…';
    const data=new FormData();[...input.files].forEach(file=>data.append('images',file));
    try{const r=await fetch(`/api/video-studio/projects/${projectId}/reference-images`,{method:'POST',body:data});const d=await r.json();if(!r.ok)throw new Error(d.error||'Upload failed.');input.value='';await load();}
    catch(error){document.querySelector('#identity-status').textContent=error instanceof Error?error.message:'Reference upload failed.';}
    finally{button.disabled=false;button.textContent='Upload references';}
  });

  document.querySelector('#references')?.addEventListener('click',async(event)=>{
    const button=event.target.closest('.delete-ref');if(!button)return;
    button.disabled=true;
    const r=await fetch(`/api/video-studio/projects/${projectId}/reference-images`,{method:'DELETE',headers:{'content-type':'application/json'},body:JSON.stringify({imageId:button.dataset.id})});
    if(r.ok)await load();else button.disabled=false;
  });

  generate?.addEventListener('click',async()=>{
    if(!generationReady||!project)return;
    generate.disabled=true;generate.textContent='Starting…';
    try{
      const r=await fetch('/api/video-studio/generate',{method:'POST',headers:{'content-type':'application/json','idempotency-key':crypto.randomUUID()},body:JSON.stringify({projectId:project.id,durationSeconds:project.duration_seconds,resolution:project.resolution})});const d=await r.json();
      if(!r.ok)throw new Error(d.error||'Unable to start generation.');
      document.querySelector('#identity-status').textContent='Grounded generation queued. Credits and spend controls remain active.';
      setTimeout(load,2500);
    }catch(error){document.querySelector('#identity-status').textContent=error instanceof Error?error.message:'Generation could not start.';}
    finally{updateGate();}
  });

  load();
</script>

<style>
  .top-grid{grid-template-columns:minmax(0,1fr) 330px;align-items:start}.grounding-card{margin-top:22px}.grounding-head{display:flex;gap:24px;align-items:flex-start;justify-content:space-between}.grounding-head h2{margin:5px 0 8px}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em}.identity-badge{white-space:nowrap;border-radius:999px;padding:8px 12px;font-size:.78rem;font-weight:800}.identity-badge.pending{border:1px solid #d8c79d;background:#fff8e8}.identity-badge.verified{border:1px solid #acd6b9;background:#eefaf2}.identity-form{margin-top:24px}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.identity-form label{display:grid;gap:7px;font-size:.82rem;font-weight:700}.identity-form input,.identity-form textarea,.reference-upload input{width:100%;box-sizing:border-box;border:1px solid #d8d8d8;border-radius:10px;padding:11px 12px;background:#fff;color:inherit;font:inherit}.notes-label{margin-top:14px}.verify-row{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:16px}.reference-section{border-top:1px solid #e8e8e8;margin-top:26px;padding-top:22px}.reference-section h3{margin:0 0 4px}.reference-upload{display:flex;gap:10px;align-items:center;margin:14px 0}.references{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ref-card{border:1px solid #e2e2e2;border-radius:12px;padding:9px;display:grid;gap:8px}.ref-card img,.ref-placeholder{width:100%;aspect-ratio:4/3;object-fit:contain;background:#f5f5f5;border-radius:8px}.ref-placeholder{display:grid;place-items:center;font-size:.72rem;font-weight:800}.ref-card div{display:grid;gap:2px}.ref-card small{color:#777}.delete-ref{border:0;background:transparent;text-align:left;padding:0;color:#8b2c2c;cursor:pointer}.accuracy-rule{display:grid;grid-template-columns:130px 1fr;gap:12px;border-top:1px solid #e8e8e8;margin-top:22px;padding-top:18px;font-size:.84rem}.btn.secondary{background:transparent;color:inherit;border:1px solid #ccc}
  @media(max-width:800px){.top-grid{grid-template-columns:1fr}.grounding-head,.verify-row,.reference-upload{align-items:stretch;flex-direction:column}.field-grid{grid-template-columns:1fr}.references{grid-template-columns:1fr 1fr}.accuracy-rule{grid-template-columns:1fr}.identity-badge{white-space:normal}}
</style>