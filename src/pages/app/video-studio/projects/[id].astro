  }
  .uploader__drop:hover { border-color: var(--vs-accent); background: var(--vs-accent-soft); }
  .uploader__drop:focus-within { border-color: var(--vs-accent); box-shadow: 0 0 0 3px var(--vs-accent-soft); }
