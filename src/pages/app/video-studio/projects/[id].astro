  .progress-track { height: 6px; margin-top: 0.9rem; border-radius: 999px; background: var(--vs-surface-3); overflow: hidden; }
  .progress-track span { display: block; height: 100%; width: 8%; border-radius: 999px; background: var(--vs-accent); transition: width 0.35s ease; }
  .progress-card.is-complete .progress-track span { background: var(--vs-green); }
