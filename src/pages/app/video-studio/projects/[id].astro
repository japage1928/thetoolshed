  .identity-edit { margin-top: 1rem; }
  .identity-edit > summary { list-style: none; }
  .identity-edit > summary::-webkit-details-marker { display: none; }
  .identity-edit[open] > summary { margin-bottom: 0.9rem; }
  .identity-form__foot { display: grid; gap: 0.6rem; margin-top: 1rem; }
  .accuracy-rule { margin: 1rem 0 0; padding-top: 0.9rem; border-top: 1px solid var(--vs-border); }
