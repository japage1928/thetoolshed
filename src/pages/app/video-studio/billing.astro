---
import StudioShell from '../../../components/video-studio/StudioShell.astro';
---
<StudioShell title="Billing" section="billing"><div class="page-head"><div><h1>Billing</h1><p>Manage your Video Studio subscription.</p></div></div><div class="card"><h2 id="plan">Loading…</h2><p id="status" class="muted"></p><a id="manage" class="btn" href="/account" style="display:none">Manage Subscription</a><p id="comp" class="muted" hidden>This account has a comped subscription for testing. No card is charged.</p></div></StudioShell><script>fetch('/api/video-studio/account').then(r=>r.json()).then(d=>{document.querySelector('#plan').textContent=`${String(d.plan||'Plan').replaceAll('_',' ')} plan`;document.querySelector('#status').textContent=`Status: ${d.subscriptionStatus||'inactive'}${d.renewalDate?` · Renews ${new Date(d.renewalDate).toLocaleDateString()}`:''}`;if(d.manageSubscriptionAvailable)document.querySelector('#manage').style.display='inline-flex';else document.querySelector('#comp').hidden=false;});</script>