---
import StudioShell from '../../../components/video-studio/StudioShell.astro';
---
<StudioShell title="Billing" section="billing"><div class="page-head"><div><h1>Billing</h1><p>Manage your Video Studio subscription.</p></div></div><div class="card"><h2 id="plan">Loading…</h2><p id="status" class="muted"></p><button id="manage" class="btn" type="button" hidden>Manage Subscription</button><p id="comp" class="muted" hidden>This account has a comped subscription for testing. No card is charged.</p><p id="billing-message" class="muted"></p></div></StudioShell><script>
  let account;
  fetch('/api/video-studio/account').then(r=>r.json()).then(d=>{account=d;document.querySelector('#plan').textContent=`${String(d.plan||'Plan').replaceAll('_',' ')} plan`;document.querySelector('#status').textContent=`Status: ${d.subscriptionStatus||'inactive'}${d.renewalDate?` · Renews ${new Date(d.renewalDate).toLocaleDateString()}`:''}`;if(d.manageSubscriptionAvailable)document.querySelector('#manage').hidden=false;else document.querySelector('#comp').hidden=false;});
  document.querySelector('#manage')?.addEventListener('click',async()=>{const msg=document.querySelector('#billing-message');msg.textContent='Opening secure billing portal…';const r=await fetch('/api/video-studio/billing/portal',{method:'POST'});const d=await r.json();if(!r.ok){msg.textContent=d.error||'Unable to open billing.';return;}location.href=d.url;});
</script>