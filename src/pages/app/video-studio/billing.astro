---
import StudioShell from '../../../components/video-studio/StudioShell.astro';
---
<StudioShell title="Billing" section="billing"><div class="page-head"><div><h1>Billing</h1><p>Manage your Video Studio subscription.</p></div></div><div class="card"><h2 id="plan">Loading…</h2><p id="status" class="muted"></p><button id="manage" class="btn" type="button" hidden>Manage Subscription</button><p id="comp" class="muted" hidden>This account has a comped subscription for testing. No card is charged.</p><p id="billing-message" class="muted"></p></div></StudioShell><script>
  fetch('/api/video-studio/account').then(r=>r.json()).then(d=>{
    const plan=document.querySelector<HTMLElement>('#plan');
    const status=document.querySelector<HTMLElement>('#status');
    const manage=document.querySelector<HTMLElement>('#manage');
    const comp=document.querySelector<HTMLElement>('#comp');
    if(plan) plan.textContent=`${String(d.plan||'Plan').replaceAll('_',' ')} plan`;
    if(status) status.textContent=`Status: ${d.subscriptionStatus||'inactive'}${d.renewalDate?` · Renews ${new Date(d.renewalDate).toLocaleDateString()}`:''}`;
    if(d.manageSubscriptionAvailable){if(manage) manage.hidden=false;} else if(comp) comp.hidden=false;
  });
  document.querySelector('#manage')?.addEventListener('click',async()=>{
    const msg=document.querySelector<HTMLElement>('#billing-message');
    if(!msg) return;
    msg.textContent='Opening secure billing portal…';
    const r=await fetch('/api/video-studio/billing/portal',{method:'POST'});
    const d=await r.json();
    if(!r.ok){msg.textContent=d.error||'Unable to open billing.';return;}
    location.href=d.url;
  });
</script>