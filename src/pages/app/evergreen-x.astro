---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Evergreen X Scheduler" description="Manage your evergreen X scheduler." path="/app/evergreen-x" noindex>
  <section class="app-shell">
    <header class="app-head">
      <div><span class="eyebrow">EVERGREEN X POST SCHEDULER</span><h1>Scheduler dashboard</h1></div>
      <div class="head-actions"><a href="/tools/evergreen-x-scheduler">Product page</a><button id="logout" class="ghost">Sign out</button></div>
    </header>

    <div id="notice" class="notice" hidden></div>
    <section id="loading" class="loading">Loading your scheduler…</section>
    <div id="app" hidden>
      <section class="cards" id="cards"></section>

      <nav class="tabs" aria-label="Scheduler sections">
        <button class="tab active" data-tab="library">Post library</button>
        <button class="tab" data-tab="settings">Scheduler settings</button>
        <button class="tab" data-tab="billing">Plan & usage</button>
      </nav>

      <section class="panel tab-panel" data-panel="library">
        <div class="panel-head"><div><h2>Post library</h2><p>Add posts once, then mark the ones eligible for publishing as READY.</p></div><button id="refresh" class="ghost">Refresh</button></div>
        <form id="post-form" class="composer">
          <textarea id="post-content" maxlength="280" placeholder="Write an evergreen X post…" required></textarea>
          <div class="composer-meta"><span id="char-count">0 / 280</span><span id="category-preview">Regular post</span><span id="quota-preview"></span></div>
          <div class="composer-actions"><select id="post-status"><option value="DRAFT">Save as draft</option><option value="READY">Add as READY</option></select><button class="primary" type="submit">Add post</button></div>
        </form>
        <div id="posts" class="posts"></div>
      </section>

      <section class="panel tab-panel" data-panel="settings" hidden>
        <div class="panel-head"><div><h2>Scheduler settings</h2><p>Choose a range, not a single clock time. The next post is randomized inside that window.</p></div></div>
        <form id="settings-form" class="settings-grid">
          <label class="switch-row"><span><b>Scheduler</b><small>Pause or resume automatic publishing.</small></span><input id="scheduler-enabled" type="checkbox" /></label>
          <label>Minimum interval (minutes)<input id="minimum" type="number" min="30" step="1" required /></label>
          <label>Maximum interval (minutes)<input id="maximum" type="number" min="30" step="1" required /></label>
          <label>Daily post limit<input id="daily-limit" type="number" min="1" max="100" step="1" required /></label>
          <label>Timezone<input id="timezone" type="text" placeholder="America/Detroit" required /></label>
          <p class="help" id="random-help"></p>
          <button class="primary" type="submit">Save settings</button>
        </form>
      </section>

      <section class="panel tab-panel" data-panel="billing" hidden>
        <div class="panel-head"><div><h2>Plan & usage</h2><p>Regular and URL posts are separate quotas. The server and database decide what counts.</p></div><button id="manage-billing" class="ghost">Manage subscription</button></div>
        <div id="usage-detail" class="usage-detail"></div>
        <div id="plan-list" class="plan-list"></div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  type Dashboard = any;
  let dashboard: Dashboard = null;
  let posts: any[] = [];
  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const notice = $('#notice') as HTMLElement;
  const showNotice = (message: string, bad = false) => { notice.textContent = message; notice.hidden = false; notice.classList.toggle('bad', bad); };
  const api = async (path: string, init: RequestInit = {}) => {
    const response = await fetch(`/api/evergreen-x/${path}`, { credentials: 'same-origin', ...init, headers: { 'content-type': 'application/json', ...(init.headers || {}) } });
    const data = await response.json().catch(() => ({}));
    if (response.status === 401) { window.location.href = `/account?next=${encodeURIComponent('/app/evergreen-x')}`; throw new Error('Authentication required.'); }
    if (!response.ok) throw new Error(data.error || 'Request failed.');
    return data;
  };
  const esc = (value: unknown) => { const el = document.createElement('div'); el.textContent = String(value ?? ''); return el.innerHTML; };
  const fmt = (value?: string | null) => value ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : 'Not scheduled';
  const quotaText = (bucket: any) => bucket?.limit == null ? `${bucket?.used || 0} used · limit not finalized` : `${bucket.used} / ${bucket.limit}`;

  async function load() {
    try {
      const [d, p, planData] = await Promise.all([api('dashboard'), api('posts'), api('plans')]);
      dashboard = d; posts = p.posts || [];
      renderDashboard(); renderPosts(); renderPlans(planData.plans || []);
      ($('#loading') as HTMLElement).hidden = true; ($('#app') as HTMLElement).hidden = false;
      const query = new URLSearchParams(location.search);
      if (query.get('x_connected')) showNotice('X account connected successfully.');
      if (query.get('billing') === 'success') showNotice('Subscription checkout completed. Billing status will update after the signed webhook is processed.');
    } catch (error) { if ((error as Error).message !== 'Authentication required.') showNotice((error as Error).message, true); }
  }

  function renderDashboard() {
    const s = dashboard.scheduler || {}; const x = dashboard.x || {}; const sub = dashboard.subscription;
    const connected = x.connection_status === 'connected' && x.oauth_relay_ready;
    ($('#cards') as HTMLElement).innerHTML = `
      <article><span>Scheduler</span><b class="${s.scheduler_enabled ? 'good' : ''}">${s.scheduler_enabled ? 'Active' : 'Paused'}</b></article>
      <article><span>X account</span><b class="${connected ? 'good' : x.connection_status === 'reconnect_required' ? 'warn' : ''}">${connected ? '@' + esc(x.x_username || 'Connected') : x.connection_status === 'reconnect_required' ? 'Reconnect X' : 'Not connected'}</b><div class="card-action">${connected ? '<button data-x="disconnect">Disconnect</button>' : '<a href="/api/evergreen-x/x/connect">Connect X</a>'}</div></article>
      <article><span>Next scheduled post</span><b>${fmt(s.next_post_at)}</b></article>
      <article><span>Published this billing period</span><b>${(dashboard.usage.regular.used || 0) + (dashboard.usage.url.used || 0)}</b></article>
      <article><span>Regular usage</span><b>${quotaText(dashboard.usage.regular)}</b></article>
      <article><span>URL usage</span><b>${quotaText(dashboard.usage.url)}</b></article>
      <article><span>Ready queue</span><b>${dashboard.counts.ready}</b></article>
      <article><span>Failed</span><b class="${dashboard.counts.failed ? 'warn' : ''}">${dashboard.counts.failed}</b></article>`;
    ($('#scheduler-enabled') as HTMLInputElement).checked = !!s.scheduler_enabled;
    ($('#minimum') as HTMLInputElement).value = s.minimum_interval_minutes ?? 120;
    ($('#maximum') as HTMLInputElement).value = s.maximum_interval_minutes ?? 360;
    ($('#daily-limit') as HTMLInputElement).value = s.daily_post_limit ?? 8;
    ($('#timezone') as HTMLInputElement).value = s.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone || 'America/Detroit';
    updateRandomHelp(); updateComposerPreview();
    ($('#usage-detail') as HTMLElement).innerHTML = `<div><span>Current plan</span><b>${esc(sub?.plan?.name || 'No active plan')}</b></div><div><span>Subscription</span><b>${esc(sub?.status || 'inactive')}</b></div><div><span>Regular posts</span><b>${quotaText(dashboard.usage.regular)}</b></div><div><span>URL posts</span><b>${quotaText(dashboard.usage.url)}</b></div>`;
  }

  function renderPosts() {
    const root = $('#posts') as HTMLElement;
    if (!posts.length) { root.innerHTML = '<div class="empty">No posts yet. Add the first one above.</div>'; return; }
    root.innerHTML = posts.map((post) => `<article class="post" data-id="${post.id}">
      <div class="post-top"><div><span class="badge">${post.contains_url ? 'URL' : 'Regular'}</span><span class="badge status">${esc(post.status)}</span></div><span class="attempts">${post.attempt_count || 0} attempt${post.attempt_count === 1 ? '' : 's'}</span></div>
      <p>${esc(post.content)}</p>
      <div class="post-meta">${post.scheduled_at ? `<span>Scheduled ${fmt(post.scheduled_at)}</span>` : ''}${post.posted_at ? `<span>Posted ${fmt(post.posted_at)}</span>` : ''}${post.last_error ? `<span class="error">${esc(post.last_error)}</span>` : ''}</div>
      <div class="post-actions">
        ${['DRAFT','PAUSED'].includes(post.status) ? '<button data-action="ready">READY</button>' : ''}
        ${['READY','FAILED','PAUSED'].includes(post.status) ? '<button data-action="draft">DRAFT</button>' : ''}
        ${post.status === 'FAILED' ? '<button data-action="edit">Correct</button><button data-action="retry">Retry</button>' : ''}
        ${!['POSTED','RESERVED'].includes(post.status) ? '<button data-action="edit">Edit</button><button data-action="delete" class="danger">Delete</button>' : ''}
        ${post.x_post_url ? `<a href="${esc(post.x_post_url)}" target="_blank" rel="noopener">View on X</a>` : ''}
      </div>
    </article>`).join('');
  }

  function renderPlans(plans: any[]) {
    const root = $('#plan-list') as HTMLElement;
    if (!plans.length) { root.innerHTML = '<p class="empty">No active plans are configured yet.</p>'; return; }
    root.innerHTML = plans.map((plan) => `<article><h3>${esc(plan.name || plan.id)}</h3><p class="price">${plan.price_cents == null ? 'Pricing pending' : `$${(plan.price_cents / 100).toFixed(0)}/${esc(plan.billing_interval || 'month')}`}</p><p>Regular: ${plan.regular_post_limit == null ? 'limit being finalized' : `${plan.regular_post_limit} / period`}</p><p>URL: ${plan.url_post_limit} / period</p><button class="primary" data-plan="${esc(plan.id)}" ${dashboard.billingConfigured ? '' : 'disabled'}>${dashboard.billingConfigured ? 'Choose plan' : 'Billing setup pending'}</button></article>`).join('');
  }

  function updateComposerPreview() {
    const value = ($('#post-content') as HTMLTextAreaElement).value;
    ($('#char-count') as HTMLElement).textContent = `${Array.from(value).length} / 280`;
    const url = /(^|[^\w])(https?:\/\/|www\.)\S+/i.test(value) || /(^|[^\w])[a-z0-9][a-z0-9-]*(\.[a-z0-9-]+)+(\/\S*)?/i.test(value);
    ($('#category-preview') as HTMLElement).textContent = url ? 'URL post (preview)' : 'Regular post (preview)';
    if (dashboard) ($('#quota-preview') as HTMLElement).textContent = `Remaining: ${remaining(url ? dashboard.usage.url : dashboard.usage.regular)}`;
  }
  function remaining(bucket: any) { return bucket?.limit == null ? 'limit pending' : String(Math.max(0, bucket.limit - bucket.used)); }
  function updateRandomHelp() { const min = Number(($('#minimum') as HTMLInputElement).value); const max = Number(($('#maximum') as HTMLInputElement).value); ($('#random-help') as HTMLElement).textContent = `After a successful post, the next one can be scheduled anywhere between ${min} and ${max} minutes later.`; }

  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const tab = target.closest<HTMLButtonElement>('[data-tab]');
    if (tab) { document.querySelectorAll('.tab').forEach((el) => el.classList.toggle('active', el === tab)); document.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => el.hidden = el.dataset.panel !== tab.dataset.tab); return; }
    const xButton = target.closest<HTMLElement>('[data-x="disconnect"]');
    if (xButton) { try { await api('x/disconnect', { method: 'POST', body: '{}' }); await load(); } catch (e) { showNotice((e as Error).message, true); } return; }
    const actionButton = target.closest<HTMLButtonElement>('[data-action]');
    if (actionButton) {
      const postEl = actionButton.closest<HTMLElement>('[data-id]'); const id = postEl?.dataset.id; const action = actionButton.dataset.action; if (!id || !action) return;
      const post = posts.find((p) => p.id === id);
      try {
        if (action === 'delete') { if (!confirm('Delete this post?')) return; await api(`posts/${id}`, { method: 'DELETE' }); }
        else if (action === 'edit') { const content = prompt('Edit post', post?.content || ''); if (content == null) return; await api(`posts/${id}`, { method: 'PATCH', body: JSON.stringify({ content }) }); }
        else await api(`posts/${id}/${action}`, { method: 'POST', body: '{}' });
        await load();
      } catch (e) { showNotice((e as Error).message, true); }
      return;
    }
    const planButton = target.closest<HTMLButtonElement>('[data-plan]');
    if (planButton?.dataset.plan) { try { const data = await api('billing/checkout', { method: 'POST', body: JSON.stringify({ plan_id: planButton.dataset.plan }) }); location.href = data.url; } catch (e) { showNotice((e as Error).message, true); } }
  });

  ($('#post-content') as HTMLTextAreaElement)?.addEventListener('input', updateComposerPreview);
  $('#minimum')?.addEventListener('input', updateRandomHelp); $('#maximum')?.addEventListener('input', updateRandomHelp);
  ($('#post-form') as HTMLFormElement)?.addEventListener('submit', async (event) => { event.preventDefault(); try { await api('posts', { method: 'POST', body: JSON.stringify({ content: ($('#post-content') as HTMLTextAreaElement).value, status: ($('#post-status') as HTMLSelectElement).value }) }); ($('#post-content') as HTMLTextAreaElement).value = ''; await load(); } catch (e) { showNotice((e as Error).message, true); } });
  ($('#settings-form') as HTMLFormElement)?.addEventListener('submit', async (event) => { event.preventDefault(); try { await api('settings', { method: 'PATCH', body: JSON.stringify({ scheduler_enabled: ($('#scheduler-enabled') as HTMLInputElement).checked, minimum_interval_minutes: Number(($('#minimum') as HTMLInputElement).value), maximum_interval_minutes: Number(($('#maximum') as HTMLInputElement).value), daily_post_limit: Number(($('#daily-limit') as HTMLInputElement).value), timezone: ($('#timezone') as HTMLInputElement).value }) }); showNotice('Scheduler settings saved.'); await load(); } catch (e) { showNotice((e as Error).message, true); } });
  $('#refresh')?.addEventListener('click', load);
  $('#manage-billing')?.addEventListener('click', async () => { try { const data = await api('billing/portal', { method: 'POST', body: '{}' }); location.href = data.url; } catch (e) { showNotice((e as Error).message, true); } });
  $('#logout')?.addEventListener('click', async () => { await fetch('/api/auth/logout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' }); location.href = '/tools/evergreen-x-scheduler'; });
  load();
</script>

<style>
.app-shell{width:min(1180px,calc(100% - 2rem));margin:0 auto;padding:3rem 0 6rem}.app-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.app-head h1{margin:.4rem 0;font-size:clamp(2rem,4vw,3rem)}.eyebrow{font-size:.7rem;letter-spacing:.15em;font-weight:800;color:#c7a76a}.head-actions{display:flex;gap:.6rem;align-items:center}.head-actions a{color:#aaa69e;font-size:.85rem}.notice{padding:.9rem 1rem;margin:1rem 0;border:1px solid #626044;border-radius:.6rem;background:#191a13;color:#d9cf98}.notice.bad{border-color:#704848;background:#1c1111;color:#e8a6a6}.loading,.empty{padding:2rem;border:1px dashed var(--color-border);border-radius:.7rem;color:#8f8b84}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem}.cards article,.panel,.composer,.post,.plan-list article{border:1px solid var(--color-border);background:#10110f;border-radius:.75rem}.cards article{padding:1rem;min-height:90px}.cards span{display:block;color:#85817a;font-size:.75rem;margin-bottom:.45rem}.cards b{font-size:1rem}.good{color:#9fc59f}.warn,.error{color:#e5a1a1!important}.card-action{margin-top:.55rem}.card-action a,.card-action button,.post-actions button,.post-actions a{font:inherit;font-size:.75rem;background:transparent;border:0;color:#c7a76a;padding:0;cursor:pointer;text-decoration:none}.tabs{display:flex;gap:.3rem;margin:2rem 0 .7rem;overflow:auto}.tab,.ghost,.primary,select{border:1px solid var(--color-border);border-radius:.5rem;background:#121310;color:#aaa69e;padding:.7rem .9rem;font-weight:800;cursor:pointer}.tab.active,.primary{background:#ece6da;color:#111;border-color:#ece6da}.primary:disabled{opacity:.45;cursor:not-allowed}.panel{padding:1.25rem}.panel-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.panel-head h2{margin:.1rem 0}.panel-head p{margin:.35rem 0 1.1rem;color:#908c84;font-size:.9rem}.composer{padding:1rem;margin:1rem 0}.composer textarea{width:100%;min-height:120px;resize:vertical;box-sizing:border-box;border:0;outline:0;background:transparent;color:#f1eee7;font:inherit;line-height:1.5}.composer-meta,.composer-actions,.post-top,.post-actions{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap}.composer-meta{font-size:.72rem;color:#85817a;border-top:1px solid var(--color-border);padding-top:.7rem}.composer-actions{justify-content:flex-end;margin-top:.8rem}.posts{display:grid;gap:.75rem}.post{padding:1rem}.post-top{justify-content:space-between}.badge{display:inline-block!important;border:1px solid var(--color-border);padding:.25rem .45rem;border-radius:99px;font-size:.68rem!important;margin:0 .3rem 0 0!important;color:#aaa69e!important}.post p{white-space:pre-wrap;line-height:1.55}.attempts,.post-meta{font-size:.72rem;color:#817d75}.post-meta{display:grid;gap:.2rem;margin:.6rem 0}.post-actions{gap:1rem;border-top:1px solid var(--color-border);padding-top:.75rem}.post-actions .danger{color:#d98d8d}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;max-width:820px}.settings-grid label{display:grid;gap:.4rem;color:#aaa69e;font-size:.8rem;font-weight:800}.settings-grid input{padding:.75rem;border:1px solid var(--color-border);border-radius:.5rem;background:#090a09;color:#f1eee7}.switch-row{grid-column:1/-1;display:flex!important;align-items:center;justify-content:space-between;padding:1rem;border:1px solid var(--color-border);border-radius:.6rem}.switch-row span{display:grid;gap:.25rem}.switch-row small{color:#85817a;font-weight:400}.switch-row input{width:22px;height:22px}.help{grid-column:1/-1;color:#85817a;font-size:.82rem}.usage-detail{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:1rem 0}.usage-detail>div{padding:1rem;border:1px solid var(--color-border);border-radius:.6rem}.usage-detail span{display:block;color:#85817a;font-size:.72rem;margin-bottom:.4rem}.plan-list{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.plan-list article{padding:1rem}.plan-list h3{margin:.1rem 0}.plan-list p{color:#969188}.price{color:#f1eee7!important;font-weight:800}@media(max-width:900px){.cards,.usage-detail{grid-template-columns:1fr 1fr}.plan-list{grid-template-columns:1fr}.app-head{align-items:start;flex-direction:column}}@media(max-width:600px){.cards,.usage-detail,.settings-grid{grid-template-columns:1fr}.panel{padding:.9rem}.switch-row{grid-column:auto}.help{grid-column:auto}.panel-head{flex-direction:column}.head-actions{width:100%;justify-content:space-between}}
</style>