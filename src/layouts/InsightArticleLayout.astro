---
import BusinessIntelligenceLayout from './BusinessIntelligenceLayout.astro';
import ProductCTA from '../components/business-intelligence/ProductCTA.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  intro: string;
  pinConcepts: string[];
}

const { title, description, path, eyebrow, intro, pinConcepts } = Astro.props;
const publishedDate = new Date('2026-09-01T00:00:00Z');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-09-01',
  dateModified: '2026-09-01',
  publisher: { '@type': 'Organization', name: 'The Tool Shed' },
  mainEntityOfPage: `https://thetoolshed.work${path}`,
};
---

<BusinessIntelligenceLayout {title} {description} {path} type="article" {publishedDate} updatedDate={publishedDate} {jsonLd}>
  <article class="bi-article">
    <header class="bi-article__hero">
      <div class="bi-article__hero-art" aria-hidden="true"><span>FIELD GUIDE</span><strong>LOCAL<br />PROSPECT<br />RESEARCH</strong></div>
      <div class="bi-shell bi-article__hero-copy">
        <span class="bi-kicker">{eyebrow}</span>
        <h1>{title}</h1>
        <p>{intro}</p>
        <div class="bi-article__meta"><span>Practical prospecting guide</span><span>8 minute read</span></div>
      </div>
    </header>
    <div class="bi-shell bi-article__layout">
      <div class="bi-article__content"><slot /></div>
      <aside class="bi-article__aside" aria-label="Product information">
        <span class="bi-kicker">Skip the first-pass research</span>
        <h2>Polk County is already researched.</h2>
        <p>Inspect genuine sample records, then decide whether the full 200+ business dataset is worth $29 to you.</p>
        <ProductCTA label="Get Polk County — $29" secondaryHref="/business-intelligence/sample" secondaryLabel="View Free Sample" compact />
      </aside>
    </div>
    <section class="bi-section bi-section--tint" aria-labelledby="pin-concepts-title">
      <div class="bi-shell bi-two-column"><div><span class="bi-kicker">Pinterest concepts</span><h2 id="pin-concepts-title">Save-worthy versions of this guide</h2></div><ul class="bi-concept-list">{pinConcepts.map((concept) => <li>{concept}</li>)}</ul></div>
    </section>
    <section class="bi-final-cta"><div class="bi-shell"><span class="bi-kicker">The Tool Shed Business Intelligence</span><h2>See Polk County businesses we’ve already researched.</h2><p>Start with the live sample. Buy the full dataset only if the research depth earns it.</p><ProductCTA label="Unlock 200+ Businesses — $29" secondaryHref="/business-intelligence/sample" secondaryLabel="Inspect Real Sample Data" /></div></section>
  </article>
</BusinessIntelligenceLayout>
